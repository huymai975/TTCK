@model WebAppBookingBoat.ViewModels.nvHoaDonCreateViewModel

@{
    ViewData["Title"] = "Lập Hóa đơn - Nhân viên";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-file-invoice-dollar text-success mr-2"></i>Lập Hóa đơn mới
        </h1>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm mr-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-11 col-lg-12">
            <div class="card shadow-sm mb-4 border-0 border-left-success">
                <div class="card-header py-3 bg-white border-bottom">
                    <h6 class="m-0 font-weight-bold text-success text-uppercase small">
                        <i class="fas fa-info-circle mr-1"></i> Thông tin chứng từ (Nghiệp vụ Nhân viên)
                    </h6>
                </div>

                <div class="card-body px-lg-5 py-4">
                    <form asp-action="Create" method="post" id="createInvoiceForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-7 border-right pr-lg-4">
                                <div class="row">
                                    <div class="form-group col-12 mb-4">
                                        <div class="p-3 bg-light rounded border shadow-sm">
                                            <div class="custom-control custom-switch">
                                                <input type="checkbox" class="custom-control-input" asp-for="IsVangLai">
                                                <label class="custom-control-label font-weight-bold text-primary" for="IsVangLai">
                                                    <i class="fas fa-user-plus mr-1"></i> Chế độ Khách hàng vãng lai
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group col-12" id="SectionExistingCustomer">
                                        <label asp-for="MaKH" class="font-weight-bold text-dark">Tìm khách hàng</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-search"></i></span>
                                            </div>
                                            <select asp-for="MaKH" class="form-control select2" asp-items="Model.DanhSachKhachHang">
                                                <option value="">-- Chọn khách hàng đã đăng ký --</option>
                                            </select>
                                        </div>
                                        <span asp-validation-for="MaKH" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12 row mx-0 px-0" id="SectionNewCustomer" style="display:none;">
                                        <div class="form-group col-md-6">
                                            <label class="font-weight-bold text-danger">Họ tên *</label>
                                            <input asp-for="TenKhachVangLai" class="form-control" placeholder="Tên khách...">
                                            <span asp-validation-for="TenKhachVangLai" class="text-danger small"></span>
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label class="font-weight-bold">Số điện thoại</label>
                                            <input asp-for="SdtKhachVangLai" class="form-control" placeholder="SĐT khách...">
                                        </div>
                                        <div class="form-group col-12">
                                            <label class="font-weight-bold">Email</label>
                                            <input asp-for="EmailKhachVangLai" class="form-control" placeholder="Email...">
                                        </div>
                                    </div>

                                    <div class="form-group col-md-6">
                                        <label asp-for="MaLichTrinh" class="font-weight-bold text-dark">Lịch trình chuyến đi</label>
                                        <select asp-for="MaLichTrinh" id="SelectLichTrinh" class="form-control font-weight-bold text-success" asp-items="Model.DanhSachLichTrinh">
                                            <option value="">-- Chọn lịch trình khởi hành --</option>
                                        </select>
                                        <span asp-validation-for="MaLichTrinh" class="text-danger small"></span>
                                    </div>

                                    <div class="form-group col-md-6">
                                        <label asp-for="MaKM" class="font-weight-bold text-dark">Áp dụng mã giảm giá</label>
                                        <select asp-for="MaKM" id="SelectKhuyenMai" class="form-control" asp-items="Model.DanhSachKhuyenMai">
                                            <option value="">-- Không áp dụng --</option>
                                        </select>
                                    </div>

                                    <div class="form-group col-md-6">
                                        <label asp-for="PhuongThucTT" class="font-weight-bold text-dark">Thanh toán</label>
                                        <select asp-for="PhuongThucTT" class="form-control">
                                            <option value="Tiền mặt">Tiền mặt</option>
                                            <option value="Chuyển khoản">Chuyển khoản</option>
                                        </select>
                                    </div>

                                    <div class="form-group col-md-6">
                                        <label asp-for="TrangThai" class="font-weight-bold text-dark">Tình trạng</label>
                                        <select asp-for="TrangThai" class="form-control">
                                            <option value="Chưa thanh toán">Chưa thanh toán</option>
                                            <option value="Đã thanh toán">Đã thanh toán</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-5">
                                <div class="payment-summary shadow-sm p-4">
                                    <h6 class="font-weight-bold text-success mb-4 text-uppercase text-center">
                                        <i class="fas fa-receipt mr-2"></i>Chi tiết thanh toán
                                    </h6>

                                    <div class="d-flex justify-content-between mb-3">
                                        <span class="text-muted">Tạm tính (Giá ghế):</span>
                                        <span class="font-weight-bold" id="TamTinhDisplay">0 đ</span>
                                        <input type="hidden" asp-for="TamTinh" id="TamTinhRaw" />
                                    </div>

                                    <div class="d-flex justify-content-between mb-3 text-danger">
                                        <span>Khấu trừ giảm giá:</span>
                                        <span class="font-weight-bold" id="SoTienGiamDisplay">0 đ</span>
                                        <input type="hidden" asp-for="SoTienGiam" id="SoTienGiamRaw" />
                                    </div>

                                    <div style="border-top: 2px dashed #e3e6f0; margin: 20px 0;"></div>

                                    <div class="d-flex justify-content-between mb-4">
                                        <span class="h5 font-weight-bold text-dark">TỔNG THU:</span>
                                        <div class="text-right">
                                            <span class="h4 font-weight-bold text-success d-block" id="TongTienDisplay">0 đ</span>
                                            <input type="hidden" asp-for="TongTien" id="TongTienRaw" />
                                        </div>
                                    </div>

                                    <div id="HiddenTicketIds"></div>

                                    <button type="submit" class="btn btn-success btn-block btn-lg shadow-sm py-3 font-weight-bold text-uppercase">
                                        <i class="fas fa-check-double mr-2"></i> Xác nhận 
                                    </button>
                                </div>
                            </div>

                            <div class="col-12 mt-4">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <label class="font-weight-bold text-success h5 mb-0">
                                        <i class="fas fa-ship mr-1"></i> Sơ đồ vị trí ghế:
                                    </label>

                                    <div class="d-flex small border rounded bg-white p-2 shadow-sm">
                                        <div class="mr-3"><i class="fas fa-square text-info mr-1"></i>Thường</div>
                                        <div class="mr-3"><i class="fas fa-crown text-warning mr-1"></i>VIP</div>
                                        <div class="mr-3"><i class="fas fa-square text-success mr-1"></i>Đang chọn</div>
                                        <div><i class="fas fa-square text-gray-400 mr-1"></i>Đã bán</div>
                                    </div>
                                </div>

                                <div class="ship-layout-container border rounded p-4 bg-white">
                                    <div class="text-center mb-4">
                                        <div class="d-inline-block px-5 py-1 bg-dark text-white rounded-pill" style="font-size: 0.7rem; letter-spacing: 3px;">
                                            MŨI TÀU
                                        </div>
                                    </div>
                                    <div id="SelectedSeatsWrapper" style="min-height: 200px;">
                                        <div class="text-center py-5 text-muted font-italic">
                                            Vui lòng chọn lịch trình để xem sơ đồ ghế trống...
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // QUAN TRỌNG: URL tự động theo Area hiện tại
            const urls = {
                getGhes: '@Url.Action("GetGhesByLichTrinh")',
                getKm: '@Url.Action("GetKhuyenMaiInfo")'
            };

            function toggleCustomerUI() {
                const isVangLai = $('#IsVangLai').is(':checked');
                $('#SectionExistingCustomer').toggle(!isVangLai);
                $('#SectionNewCustomer').toggle(isVangLai);
            }

            $('#IsVangLai').on('change', toggleCustomerUI);
            toggleCustomerUI();

            $('#SelectLichTrinh').on('change', function () {
                const maLT = $(this).val();
                const $wrapper = $('#SelectedSeatsWrapper');
                $('#HiddenTicketIds').empty();

                if (!maLT) {
                    $wrapper.html('<div class="text-center py-5 text-muted">Vui lòng chọn lịch trình...</div>');
                    tinhToanHoaDon();
                    return;
                }

                $wrapper.html('<div class="text-center py-5"><div class="spinner-border text-success"></div></div>');

                $.get(urls.getGhes, { maLT: maLT })
                    .done(function (data) {
                        let html = '<div class="row w-100 mx-0">';
                        data.forEach(item => {
                            const isVip = item.loaiGhe === "VIP";
                            const canSelect = item.isAvailable;
                            const seatClass = canSelect ? (isVip ? 'border-left-warning' : 'border-left-info') : 'booked-seat';
                            const price = new Intl.NumberFormat('vi-VN').format(item.giaThucTe) + ' đ';

                            html += `
                                <div class="col-4 col-md-3 col-lg-2 mb-3 px-2">
                                    <input type="checkbox" class="ghe-checkbox d-none" id="ghe_${item.maGhe}"
                                           value="${item.maGhe}" data-price="${item.giaThucTe}" ${canSelect ? '' : 'disabled'}>
                                    <label for="ghe_${item.maGhe}" class="card p-2 seat-card ${seatClass} w-100 h-100 text-center mb-0">
                                        <i class="fas fa-couch mb-1"></i>
                                        <span class="small font-weight-bold d-block">${item.tenGhe}</span>
                                        <small class="font-weight-bold">${canSelect ? price : 'Đã bán'}</small>
                                        ${isVip ? '<i class="fas fa-crown text-warning position-absolute" style="top:5px; right:8px; font-size:0.6rem;"></i>' : ''}
                                    </label>
                                </div>`;
                        });
                        $wrapper.html(html + '</div>');
                    });
            });

            $(document).on('change', '.ghe-checkbox', function () {
                $(this).next('.seat-card').toggleClass('selected-active', this.checked);
                tinhToanHoaDon();
            });

            $('#SelectKhuyenMai').on('change', tinhToanHoaDon);

            async function tinhToanHoaDon() {
                let tamTinh = 0, htmlHidden = '';
                $('.ghe-checkbox:checked').each(function () {
                    tamTinh += parseFloat($(this).data('price')) || 0;
                    htmlHidden += `<input type="hidden" name="SelectedVeIds" value="${$(this).val()}" />`;
                });

                $('#HiddenTicketIds').html(htmlHidden);
                $('#TamTinhRaw').val(tamTinh);
                $('#TamTinhDisplay').text(new Intl.NumberFormat('vi-VN').format(tamTinh) + " đ");

                let giamGia = 0;
                const maKM = $('#SelectKhuyenMai').val();
                if (maKM && tamTinh > 0) {
                    const km = await $.get(urls.getKm, { maKM: maKM });
                    if (km) {
                        giamGia = Math.min((tamTinh * km.phanTram) / 100, km.toiDa > 0 ? km.toiDa : Infinity);
                    }
                }

                const tongTien = Math.max(tamTinh - giamGia, 0);
                $('#SoTienGiamRaw').val(giamGia);
                $('#SoTienGiamDisplay').text("-" + new Intl.NumberFormat('vi-VN').format(giamGia) + " đ");
                $('#TongTienRaw').val(tongTien);
                $('#TongTienDisplay').text(new Intl.NumberFormat('vi-VN').format(tongTien) + " đ");
            }
        });
    </script>
}

<style>
    .seat-card {
        cursor: pointer;
        transition: 0.2s;
        background-color: #f0f4f8;
        border: 1px solid #d1d3e2 !important;
    }

        .seat-card:hover:not(.booked-seat) {
            transform: scale(1.05);
        }

    .selected-active {
        background-color: #1cc88a !important;
        color: white !important;
        border-color: #1cc88a !important;
    }

        .selected-active small, .selected-active i {
            color: white !important;
        }

    .booked-seat {
        background-color: #eaecf4 !important;
        opacity: 0.5;
        cursor: not-allowed;
    }

    .payment-summary {
        background: #f8f9fc;
        border: 2px dashed #1cc88a;
        border-radius: 12px;
    }

    .ship-layout-container {
        border-top: 35px solid #5a5c69 !important;
        border-radius: 50px 50px 10px 10px;
    }
</style>