@model IEnumerable<WebAppBookingBoat.Models.KhachHang>

@{
    ViewData["Title"] = "Danh sách Khách hàng";
}

<style>
    /* KHUNG BẢNG & TỈ LỆ CỘT */
    #dataTable {
        table-layout: fixed;
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .col-id {
        width: 50px;
    }

    .col-info {
        width: auto;
    }

    .col-contact {
        width: 180px;
    }

    .col-address {
        width: 200px;
    }

    .col-account {
        width: 150px;
    }

    .col-action {
        width: 80px;
    }
    /* Thu gọn vì chỉ còn 1 nút */

    .text-name {
        display: block;
        font-weight: 700;
        color: #2c3e50;
        line-height: 1.2;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.95rem;
    }

    .info-box {
        font-size: 0.85rem;
        line-height: 1.5;
    }

    /* NÚT THAO TÁC (Chỉ giữ View) */
    .btn-modern {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s ease;
        text-decoration: none !important;
    }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .btn-view {
        background-color: #e1f5fe;
        color: #039be5;
    }

        .btn-view:hover {
            background-color: #039be5;
            color: #fff;
        }

    .dataTables_wrapper .dataTables_filter input {
        width: 250px !important;
        border: 2px solid #4e73df;
        border-radius: 20px;
        padding-left: 15px !important;
    }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-users text-primary mr-2"></i>Tiếp nhận Khách hàng
        </h1>
    </div>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary btn-icon-split shadow-sm border-0">
            <span class="icon text-white-50"><i class="fas fa-plus"></i></span>
            <span class="text font-weight-bold">Thêm khách hàng mới</span>
        </a>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header py-3 bg-white border-bottom d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary text-uppercase small">
                <i class="fas fa-list mr-1"></i> Cơ sở dữ liệu khách hàng
            </h6>
        </div>

        <div class="card-body p-0">
            <div class="px-3 pt-3">
                <div class="card shadow-sm border-0" style="background-color: #f8f9fc;">
                    <div class="card-body py-2">
                        <div class="d-flex align-items-center flex-wrap">
                            <div class="input-group input-group-sm shadow-sm mr-2" style="width: 280px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-primary text-white border-0"><i class="fas fa-filter"></i></span>
                                </div>
                                <select id="accountFilter" class="form-control border-0 font-weight-bold text-primary">
                                    <option value="">Tất cả khách hàng</option>
                                    <option value="da-co-tk">Đã có tài khoản App</option>
                                    <option value="chua-co-tk">Chưa có tài khoản</option>
                                </select>
                            </div>
                            <button id="btnResetFilter" class="btn btn-sm btn-outline-secondary border-0 rounded-circle shadow-sm bg-white" title="Làm mới">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive mt-2">
                <table class="table table-hover align-middle mb-0" id="dataTable">
                    <thead class="bg-light text-muted small font-weight-bold">
                        <tr>
                            <th class="text-center col-id border-0">ID</th>
                            <th class="col-info border-0">Khách hàng</th>
                            <th class="col-contact border-0">Liên hệ</th>
                            <th class="col-address border-0">Địa chỉ</th>
                            <th class="col-account border-0">Tài khoản</th>
                            <th class="text-center col-action border-0">Xem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center font-weight-bold text-gray-500 small">#@item.MaKH</td>
                                <td>
                                    <span class="text-name">@item.HoTen</span>
                                    <small class="text-muted"><i class="fas fa-calendar-alt mr-1"></i>@(item.NgaySinh?.ToString("dd/MM/yyyy") ?? "N/A")</small>
                                </td>
                                <td class="info-box">
                                    <div class="text-dark font-weight-bold"><i class="fas fa-phone mr-2 text-success"></i>@item.Sdt</div>
                                    <div class="text-muted small">@item.Email</div>
                                </td>
                                <td class="small text-muted text-truncate" title="@item.DiaChi">
                                    <i class="fas fa-map-marker-alt mr-1 text-danger"></i> @item.DiaChi
                                </td>
                                <td>
                                    @if (item.AppUser != null)
                                    {
                                        <div class="badge badge-light border text-primary px-2">@item.AppUser.UserName</div>
                                        <span class="d-none">da-co-tk</span>
                                    }
                                    else
                                    {
                                        <div class="badge badge-light border text-muted px-2">Trống</div>
                                        <span class="d-none">chua-co-tk</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.MaKH" class="btn-modern btn-view"><i class="fas fa-eye"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(document).ready(function() {
            var table = $('#dataTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "pageLength": 10,
                "order": [[0, "desc"]],
                "dom": "<'row px-3 py-3'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>t<'row px-3 py-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });

            $('#accountFilter').on('change', function() { table.column(4).search($(this).val()).draw(); });
            $('#btnResetFilter').on('click', function() { $('#accountFilter').val(''); table.column(4).search('').draw(); });
        });
    </script>
}