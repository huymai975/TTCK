@model WebAppBookingBoat.ViewModels.TuyenDuongViewModel

@{
    ViewData["Title"] = "Khởi tạo tuyến đường mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-map-marked-alt text-primary mr-2"></i>Thêm mới tuyến đường
        </h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-12">
            <form asp-action="Create" enctype="multipart/form-data" class="card shadow-lg mb-4 border-left-primary">
                <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary text-uppercase small">Cấu hình thông tin hành trình</h6>
                    <span class="badge badge-primary p-2 shadow-sm">
                        <i class="fas fa-plus-circle mr-1"></i> Chế độ thêm mới
                    </span>
                </div>

                <div class="card-body">
                    @* Hiển thị thông báo lỗi từ Server nếu có *@
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 shadow-sm border-left-danger">
                            <i class="fas fa-exclamation-circle mr-2"></i><strong>Lỗi:</strong> Vui lòng kiểm tra lại dữ liệu.
                        </div>
                    }

                    <div class="row">
                        @* Cột trái: Upload hình ảnh *@
                        <div class="col-md-4 text-center border-right">
                            <label class="font-weight-bold text-dark d-block mb-3 small text-uppercase">Hình ảnh tuyến đường</label>
                            <div class="image-upload-wrapper mb-3 p-2 border rounded bg-light shadow-sm position-relative overflow-hidden group">
                                @* Sử dụng placeholder từ internet hoặc link Cloudinary cố định *@
                                <img id="imgPreview" src="https://res.cloudinary.com/dzvcaq2xl/image/upload/v1/WebAppBookingBoat/default-route.jpg"
                                     class="img-fluid rounded transition-all"
                                     style="max-height: 220px; width: 100%; object-fit: cover;"
                                     alt="Preview"
                                     onerror="this.onerror=null;this.src='https://placehold.co/600x400?text=No+Image';" />
                            </div>
                            <div class="custom-file text-left shadow-sm">
                                @* Chú ý: asp-for="HinhAnhFile" phải khớp với thuộc tính trong ViewModel *@
                                <input asp-for="HinhAnhFile" id="imageInput" type="file" class="custom-file-input" accept="image/*" required />
                                <label class="custom-file-label text-truncate" for="imageInput">Chọn tệp ảnh...</label>
                                <span asp-validation-for="HinhAnhFile" class="text-danger small font-italic"></span>
                            </div>
                            <small class="form-text text-muted mt-2 font-italic small">
                                <i class="fas fa-info-circle mr-1"></i> Ảnh sẽ được tải lên Cloudinary tự động.
                            </small>
                        </div>

                        @* Cột phải: Form nhập liệu *@
                        <div class="col-md-8 pl-md-4">
                            <div class="row">
                                <div class="col-12 form-group mb-4">
                                    <label asp-for="TenTuyen" class="font-weight-bold text-dark small">Tên tuyến đường</label>
                                    <div class="input-group shadow-sm">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-primary text-white border-0"><i class="fas fa-route"></i></span>
                                        </div>
                                        <input asp-for="TenTuyen" class="form-control border-left-0" placeholder="Ví dụ: Rạch Giá - Phú Quốc" />
                                    </div>
                                    <span asp-validation-for="TenTuyen" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group mb-4">
                                    <label asp-for="DiemDi" class="font-weight-bold text-dark small">Điểm xuất phát</label>
                                    <div class="input-group shadow-sm">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light text-danger"><i class="fas fa-map-marker-alt"></i></span>
                                        </div>
                                        <input asp-for="DiemDi" class="form-control" placeholder="Cảng khởi hành..." />
                                    </div>
                                    <span asp-validation-for="DiemDi" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group mb-4">
                                    <label asp-for="DiemDen" class="font-weight-bold text-dark small">Điểm đến</label>
                                    <div class="input-group shadow-sm">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light text-success"><i class="fas fa-flag-checkered"></i></span>
                                        </div>
                                        <input asp-for="DiemDen" class="form-control" placeholder="Cảng đích..." />
                                    </div>
                                    <span asp-validation-for="DiemDen" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group mb-4">
                                    <label asp-for="KhoangCach" class="font-weight-bold text-dark small">Khoảng cách (km)</label>
                                    <div class="input-group shadow-sm">
                                        <input asp-for="KhoangCach" class="form-control" type="number" step="0.1" placeholder="0.0" />
                                        <div class="input-group-append">
                                            <span class="input-group-text bg-light small">km</span>
                                        </div>
                                    </div>
                                    <span asp-validation-for="KhoangCach" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group mb-4">
                                    <label asp-for="ThoiGianDuKien" class="font-weight-bold text-dark small">Thời gian dự kiến</label>
                                    <div class="input-group shadow-sm">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light"><i class="far fa-clock"></i></span>
                                        </div>
                                        <input asp-for="ThoiGianDuKien" class="form-control" type="time" value="02:30" />
                                    </div>
                                    <span asp-validation-for="ThoiGianDuKien" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="Index" class="btn btn-secondary btn-icon-split shadow-sm border-0">
                        <span class="icon text-white-50"><i class="fas fa-arrow-left"></i></span>
                        <span class="text">Hủy và quay lại</span>
                    </a>

                    <button type="submit" class="btn btn-primary btn-icon-split shadow-lg font-weight-bold border-0">
                        <span class="icon text-white-50"><i class="fas fa-save"></i></span>
                        <span class="text px-3">Lưu tuyến đường</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .transition-all {
        transition: all 0.3s ease;
    }

    .group:hover #imgPreview {
        transform: scale(1.03);
    }

    .custom-file-input:focus ~ .custom-file-label {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
    }

    .input-group-text {
        border: 1px solid #d1d3e2;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Cải tiến logic Preview: Xử lý cả khi người dùng nhấn "Hủy" sau khi đã chọn file
        $('#imageInput').on('change', function(e) {
            let fileName = $(this).val().split('\\').pop() || "Chọn tệp ảnh...";
            $(this).next('.custom-file-label').html(fileName);

            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    $('#imgPreview').hide().attr('src', e.target.result).fadeIn(600);
                }
                reader.readAsDataURL(file);
            } else {
                $('#imgPreview').attr('src', '/images/tuyen-duong/default-route.jpg');
            }
        });
    </script>
}