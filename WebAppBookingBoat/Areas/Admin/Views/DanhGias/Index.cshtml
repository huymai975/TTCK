@model IEnumerable<WebAppBookingBoat.Models.DanhGia>

@{
    ViewData["Title"] = "Quản lý Đánh giá";
}

<style>
    /* 1. KHUNG BẢNG & TỈ LỆ CỘT */
    #dataTable {
        table-layout: fixed;
        width: 100% !important;
        border-collapse: separate;
        border-spacing: 0;
    }

    .col-id {
        width: 60px;
    }

    .col-info {
        width: 180px;
    }

    .col-star {
        width: 110px;
    }

    .col-content {
        width: auto;
    }

    .col-image {
        width: 100px;
    }

    .col-date {
        width: 120px;
    }

    .col-status {
        width: 130px;
    }

    .col-action {
        width: 130px;
    }

    /* 2. STYLE NỘI DUNG */
    .text-content-truncate {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.85rem;
        line-height: 1.4;
    }

    .img-review-thumb {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        transition: transform 0.2s;
        cursor: zoom-in;
    }

        .img-review-thumb:hover {
            transform: scale(1.1);
        }

    /* 3. NÚT THAO TÁC (SOFT UI) */
    .btn-modern {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s ease;
        margin: 0 2px;
        text-decoration: none !important;
        border: none;
    }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .btn-view {
        background-color: #e1f5fe;
        color: #039be5;
    }

    .btn-edit {
        background-color: #fff8e1;
        color: #f57f17;
    }

    .btn-delete {
        background-color: #ffebee;
        color: #c62828;
    }

    .btn-view:hover {
        background-color: #039be5;
        color: #fff;
    }

    .btn-edit:hover {
        background-color: #f57f17;
        color: #fff;
    }

    .btn-delete:hover {
        background-color: #c62828;
        color: #fff;
    }

    /* 4. BADGE TRẠNG THÁI */
    .badge-status {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
    }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-star text-warning mr-2"></i>Quản lý Đánh giá
        </h1>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header py-3 bg-white border-bottom d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary text-uppercase small">
                <i class="fas fa-comment-dots mr-1"></i> Phản hồi từ hành khách
            </h6>
        </div>

        <div class="card-body p-0">
            @* Bộ lọc *@
            <div class="px-3 pt-3">
                <div class="card shadow-sm border-0" style="background-color: #f8f9fc;">
                    <div class="card-body py-2">
                        <div class="d-flex align-items-center flex-wrap">
                            <div class="input-group input-group-sm shadow-sm mr-2" style="width: 250px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-info text-white border-0"><i class="fas fa-filter"></i></span>
                                </div>
                                <select id="statusFilter" class="form-control border-0 font-weight-bold text-info">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="Chờ duyệt">Chờ duyệt</option>
                                    <option value="Đã hiển thị">Đã hiển thị</option>
                                    <option value="Đã ẩn">Đã ẩn</option>
                                </select>
                            </div>
                            <button id="btnResetFilter" class="btn btn-sm btn-outline-secondary border-0 rounded-circle shadow-sm bg-white" title="Làm mới">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive mt-2 px-3 pb-3">
                <table class="table table-hover align-middle mb-0" id="dataTable">
                    <thead class="bg-light text-muted small font-weight-bold">
                        <tr>
                            <th class="text-center col-id border-0">ID</th>
                            <th class="col-info border-0">Khách hàng</th>
                            <th class="text-center col-star border-0">Đánh giá</th>
                            <th class="col-content border-0">Nội dung</th>
                            <th class="text-center col-image border-0">Hình ảnh</th>
                            <th class="col-date border-0">Ngày gửi</th>
                            <th class="text-center col-status border-0">Trạng thái</th>
                            <th class="text-center col-action border-0">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center font-weight-bold text-gray-500 small">#@item.MaDanhGia</td>
                                <td>
                                    <div class="font-weight-bold text-primary small">HĐ: #@item.MaHoaDon</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        <i class="fas fa-user-circle mr-1"></i>@(item.HoaDon?.KhachHang?.HoTen ?? "Khách ẩn danh")
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="text-warning small">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="@(i <= item.SoSao ? "fas" : "far") fa-star"></i>
                                        }
                                    </div>
                                    <span class="badge badge-light border text-dark mt-1" style="font-size: 0.65rem;">@item.SoSao/5</span>
                                </td>
                                <td>
                                    <p class="text-content-truncate mb-0" title="@item.NoiDung">@item.NoiDung</p>
                                    @if (!string.IsNullOrEmpty(item.PhanHoiAdmin))
                                    {
                                        <small class="text-info font-italic"><i class="fas fa-reply mr-1"></i>Đã phản hồi</small>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                                    {
                                        var imagePath = item.HinhAnh.StartsWith("/") ? item.HinhAnh : "/images/danh-gia/" + item.HinhAnh;
                                        <a href="@imagePath" target="_blank">
                                            <img src="~/images/danh-gia/@item.HinhAnh" class="img-review-thumb shadow-sm border"
                                                 onerror="this.onerror=null;this.src='/images/no-image.png';" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small font-italic">Không ảnh</span>
                                    }
                                </td>
                                <td>
                                    <div class="small font-weight-bold text-gray-700">@item.NgayDanhGia.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">@item.NgayDanhGia.ToString("HH:mm")</div>
                                </td>
                                <td class="text-center">
                                    @{
                                        var sClass = item.TrangThai == "Chờ duyệt" ? "badge-warning text-dark" :
                                        (item.TrangThai == "Đã hiển thị" ? "badge-success" : "badge-danger");
                                    }
                                    <span class="badge badge-status shadow-sm @sClass">@item.TrangThai</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center">
                                        <a asp-action="Details" asp-route-id="@item.MaDanhGia" class="btn-modern btn-view" title="Chi tiết"><i class="fas fa-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.MaDanhGia" class="btn-modern btn-edit" title="Phản hồi"><i class="fas fa-reply"></i></a>
                                        <button type="button" class="btn-modern btn-delete" onclick="deleteDanhGiaAjax(@item.MaDanhGia)" title="Xóa"><i class="fas fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            if ($.fn.DataTable) {
                var table = $('#dataTable').DataTable({
                    "language": {
                        "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json"
                    },
                    "pageLength": 10,
                    "order": [[0, "desc"]],
                    "columnDefs": [
                        { "orderable": false, "targets": [4, 7] } // Tắt sort cột Ảnh và Thao tác
                    ],
                    "dom": "<'row px-3 py-3'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                           "<'row'<'col-sm-12'tr>>" +
                           "<'row px-3 py-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
                });

                // Lọc trạng thái (Cột index 6)
                $('#statusFilter').on('change', function() {
                    var val = $(this).val();
                    table.column(6).search(val ? '^' + val + '$' : '', true, false).draw();
                });

                $('#btnResetFilter').on('click', function() {
                    $('#statusFilter').val('');
                    table.search('').column(6).search('').draw();
                });
            }
        });

        function deleteDanhGiaAjax(id) {
            Swal.fire({
                title: 'Xóa đánh giá này?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Delete", "DanhGias")', { id: id }, function() {
                        Swal.fire('Thành công', '', 'success').then(() => location.reload());
                    }).fail(() => Swal.fire('Lỗi', '', 'error'));
                }
            });
        }
    </script>
}