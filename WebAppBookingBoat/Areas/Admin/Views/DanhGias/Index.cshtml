@model IEnumerable<WebAppBookingBoat.Models.DanhGia>

@{
    ViewData["Title"] = "Quản lý Đánh giá";
}

<style>
    /* Giữ nguyên các Style bạn đã định nghĩa */
    #dataTable {
        table-layout: fixed;
        width: 100% !important;
        border-collapse: separate;
        border-spacing: 0;
    }

    .col-id {
        width: 40px;
    }

    .col-info {
        width: 140px;
    }

    .col-star {
        width: 110px;
    }

    .col-content {
        width: auto;
    }

    .col-image {
        width: 100px;
    }

    .col-date {
        width: 100px;
    }

    .col-status {
        width: 150px;
    }

    .col-action {
        width: 130px;
    }

    .text-content-truncate {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.85rem;
        line-height: 1.4;
    }

    .img-review-thumb {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        transition: transform 0.2s;
        cursor: zoom-in;
    }

        .img-review-thumb:hover {
            transform: scale(1.1);
        }

    .img-error {
        filter: grayscale(100%);
        opacity: 0.7;
        cursor: not-allowed !important;
    }

    .btn-modern {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s ease;
        margin: 0 2px;
        text-decoration: none !important;
        border: none;
    }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .btn-view {
        background-color: #e1f5fe;
        color: #039be5;
    }

    .btn-edit {
        background-color: #fff8e1;
        color: #f57f17;
    }

    .btn-delete {
        background-color: #ffebee;
        color: #c62828;
    }

    .badge-status {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .disabled-btn {
        opacity: 0.4;
        cursor: not-allowed !important;
        background-color: #f8d7da !important;
        color: #6c757d !important;
        pointer-events: none;
    }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-star text-warning mr-2"></i>Quản lý Đánh giá
        </h1>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header py-3 bg-white border-bottom">
            <h6 class="m-0 font-weight-bold text-primary text-uppercase small">
                <i class="fas fa-comment-dots mr-1"></i> Phản hồi từ hành khách
            </h6>
        </div>

        <div class="card-body p-0">
            @* Bộ lọc giống trang Khuyến mãi *@
            <div class="px-3 pt-3">
                <div class="card shadow-sm border-0" style="background-color: #f8f9fc;">
                    <div class="card-body py-2">
                        <div class="d-flex align-items-center flex-wrap">
                            <div class="input-group input-group-sm shadow-sm mr-2" style="width: 250px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-info text-white border-0"><i class="fas fa-filter"></i></span>
                                </div>
                                <select id="statusFilter" class="form-control border-0 font-weight-bold text-info">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="Chờ duyệt">Chờ duyệt</option>
                                    <option value="Đã hiển thị">Đã hiển thị</option>
                                    <option value="Đã ẩn">Đã ẩn</option>
                                </select>
                            </div>
                            <button id="btnResetFilter" class="btn btn-sm btn-outline-secondary border-0 rounded-circle shadow-sm bg-white">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive mt-2 px-3 pb-3">
                <table class="table table-hover align-middle mb-0" id="dataTable">
                    <thead class="bg-light text-muted small font-weight-bold">
                        <tr>
                            <th class="text-center col-id border-0">ID</th>
                            <th class="col-info border-0">Khách hàng</th>
                            <th class="text-center col-star border-0">Đánh giá</th>
                            <th class="col-content border-0">Nội dung</th>
                            <th class="text-center col-image border-0">Hình ảnh</th>
                            <th class="col-date border-0">Ngày gửi</th>
                            <th class="text-center col-status border-0">Trạng thái</th>
                            <th class="text-center col-action border-0">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center font-weight-bold text-gray-500 small">#@item.MaDanhGia</td>
                                <td>
                                    <div class="font-weight-bold text-primary small">HĐ: #@item.MaHoaDon</div>
                                    <div class="text-muted small">
                                        <i class="fas fa-user-circle mr-1"></i>@(item.HoaDon?.KhachHang?.HoTen ?? "Khách ẩn danh")
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="text-warning small">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="@(i <= item.SoSao ? "fas" : "far") fa-star"></i>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <p class="text-content-truncate mb-0" title="@item.NoiDung">@item.NoiDung</p>
                                    @if (!string.IsNullOrEmpty(item.PhanHoiAdmin))
                                    {
                                        <small class="text-info font-italic"><i class="fas fa-reply mr-1"></i>Đã phản hồi</small>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                                    {
                                        <a href="/images/danh-gia/@item.HinhAnh" target="_blank" class="review-link">
                                            <img src="/images/danh-gia/@item.HinhAnh" class="img-review-thumb shadow-sm border" onerror="handleImageError(this);" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small font-italic"><i class="fas fa-image-slash"></i></span>
                                    }
                                </td>
                                <td>
                                    <div class="small font-weight-bold">@item.NgayDanhGia.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td class="text-center">
                                    @{
                                        var sClass = item.TrangThai == "Chờ duyệt" ? "badge-warning text-dark" : (item.TrangThai == "Đã hiển thị" ? "badge-success" : "badge-danger");
                                    }
                                    <span class="badge badge-status shadow-sm @sClass">@item.TrangThai</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.MaDanhGia" class="btn-modern btn-view"><i class="fas fa-eye"></i></a>
                                    @if (item.TrangThai == "Đã ẩn")
                                    {
                                        <button class="btn-modern btn-edit disabled-btn"><i class="fas fa-reply"></i></button>
                                        <button class="btn-modern btn-delete disabled-btn"><i class="fas fa-trash"></i></button>
                                    }
                                    else
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.MaDanhGia" class="btn-modern btn-edit"><i class="fas fa-reply"></i></a>
                                        <button type="button" class="btn-modern btn-delete" onclick="deleteDanhGiaAjax('@item.MaDanhGia')"><i class="fas fa-trash"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    @* THỨ TỰ QUAN TRỌNG: Hàm bổ trợ -> Thư viện -> Logic Khởi tạo *@

    <script>
        // 1. Hàm xử lý lỗi ảnh (Phải khai báo trước)
        function handleImageError(img) {
            img.onerror = null; // Chống lặp vô hạn
            img.src = '/images/default.jpg';
            img.classList.add('img-error');
            var link = img.closest('.review-link');
            if (link) {
                link.style.pointerEvents = 'none';
                link.removeAttribute('href');
            }
        }

        // 2. Hàm xóa Ajax
        function deleteDanhGiaAjax(id) {
            Swal.fire({
                title: 'Xóa đánh giá?',
                text: "Chuyển trạng thái sang 'Đã ẩn'!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "DanhGias")',
                        type: 'POST',
                        data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Thành công', res.message, 'success').then(() => location.reload());
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        }
                    });
                }
            });
        }
    </script>

    @* 3. Nhúng thư viện (Đúng thứ tự để tránh lỗi 'defaults') *@
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* 4. Khởi tạo DataTable *@
    <script>
        $(document).ready(function() {
            var table = $('#dataTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "pageLength": 10,
                "paginate": {
                        "previous": "<i class='fas fa-angle-left'></i>",
                        "next": "<i class='fas fa-angle-right'></i>"
                    }
                "order": [[0, "desc"]],
                "columnDefs": [{ "orderable": false, "targets": [2, 4, 7] }],
                "dom": "<'row px-3 py-3'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                       "<'row'<'col-sm-12'tr>>" +
                       "<'row px-3 py-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });

            $('#statusFilter').on('change', function() {
                var val = $(this).val();
                table.column(6).search(val ? '^' + val + '$' : '', true, false).draw();
            });

            $('#btnResetFilter').on('click', function() {
                $('#statusFilter').val('');
                table.search('').column(6).search('').draw();
            });
        });
    </script>
}