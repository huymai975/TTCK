@model WebAppBookingBoat.Models.DanhGia

@{
    ViewData["Title"] = "Xác nhận xóa đánh giá";
}

<div class="container-fluid">
    @* Tiêu đề đồng bộ *@
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-comment-slash text-danger mr-2"></i>Gỡ bỏ phản hồi khách hàng
        </h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">
            @* Alert cảnh báo *@
            <div class="alert alert-warning border-left-warning shadow-sm py-3 mb-4 bg-white">
                <div class="row no-gutters align-items-center">
                    <div class="col-auto mr-3">
                        <i class="fas fa-exclamation-circle fa-2x text-warning"></i>
                    </div>
                    <div class="col">
                        <h6 class="m-0 font-weight-bold text-dark">Lưu ý trước khi xóa!</h6>
                        <span class="text-muted small">Hành động này sẽ xóa vĩnh viễn đánh giá của khách hàng khỏi hệ thống. Bạn có thể cân nhắc chuyển trạng thái sang <strong>"Đã ẩn"</strong> thay vì xóa hoàn toàn.</span>
                    </div>
                </div>
            </div>

            <div class="card shadow-lg mb-4 border-left-danger">
                @* Header *@
                <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-danger text-uppercase">
                        Mã phản hồi: #@Model.MaDanhGia
                    </h6>
                    <span class="badge badge-danger px-3 py-2 shadow-sm">
                        @Model.SoSao <i class="fas fa-star ml-1"></i>
                    </span>
                </div>

                <div class="card-body">
                    <div class="row">
                        @* Thông tin đánh giá *@
                        <div class="col-md-7 border-right">
                            <h6 class="font-weight-bold text-muted text-uppercase mb-3 small">Nội dung khách hàng gửi</h6>
                            <div class="p-3 bg-light rounded mb-3 border">
                                <div class="font-weight-bold text-primary mb-1">
                                    <i class="fas fa-user-circle mr-2"></i>@(Model.HoaDon?.KhachHang?.HoTen ?? "Khách hàng ẩn danh")
                                </div>
                                <div class="italic text-dark py-2">
                                    "@Model.NoiDung"
                                </div>
                                <div class="small text-muted mt-2">
                                    <i class="fas fa-clock mr-1"></i> Gửi ngày: @Model.NgayDanhGia.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>

                        @* Thông tin bổ sung *@
                        <div class="col-md-5 pl-md-4">
                            <h6 class="font-weight-bold text-muted text-uppercase mb-3 small">Thông tin liên quan</h6>
                            <ul class="list-group list-group-flush small">
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                                    Mã hóa đơn: <span class="font-weight-bold text-dark">#@Model.MaHoaDon</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                                    Trạng thái hiện tại: <span class="badge badge-info">@Model.TrangThai</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                                    Đã phản hồi: <span class="font-weight-bold">@(string.IsNullOrEmpty(Model.PhanHoiAdmin) ? "Chưa" : "Rồi")</span>
                                </li>
                            </ul>
                            <div class="mt-4 text-center">
                                <i class="fas fa-info-circle text-danger mr-1"></i>
                                <span class="small text-danger font-weight-bold">Dữ liệu không thể khôi phục.</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* Footer hành động *@
                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="Index" class="btn btn-secondary btn-icon-split shadow-sm">
                        <span class="icon text-white-50">
                            <i class="fas fa-arrow-left"></i>
                        </span>
                        <span class="text">Hủy & Quay lại</span>
                    </a>

                    <form asp-action="Delete" id="confirmDeleteFeedbackForm">
                        <input type="hidden" asp-for="MaDanhGia" />
                        <button type="button" class="btn btn-danger btn-icon-split shadow-sm font-weight-bold" id="btnDeleteFeedbackConfirm">
                            <span class="icon text-white-50">
                                <i class="fas fa-trash-alt"></i>
                            </span>
                            <span class="text">Xác nhận xóa sạch</span>
                        </button>
                    </form>
                </div>
            </div>

            <p class="mb-5 small text-muted text-center italic">
                <i class="fas fa-user-shield mr-1"></i> Phiên làm việc của: @(User.Identity?.Name ?? "Admin")
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on('click', '#btnDeleteFeedbackConfirm', function () {
            Swal.fire({
                title: 'Xóa đánh giá này?',
                text: "Bạn có chắc chắn muốn gỡ bỏ hoàn toàn phản hồi của khách hàng này không?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                cancelButtonColor: '#858796',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Quay lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#confirmDeleteFeedbackForm').submit();
                }
            });
        });
    </script>
}

<style>
    .border-left-danger {
        border-left: 4px solid #e74a3b !important;
    }

    .border-left-warning {
        border-left: 4px solid #f6c23e !important;
    }

    .bg-light {
        background-color: #f8f9fc !important;
    }

    .italic {
        font-style: italic;
    }
</style>