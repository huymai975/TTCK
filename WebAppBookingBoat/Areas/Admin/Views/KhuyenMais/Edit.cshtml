@model WebAppBookingBoat.Models.KhuyenMai

@{
    ViewData["Title"] = "Chỉnh sửa Chương trình Ưu đãi";
}

<head>
    <style>
        .border-left-primary {
            border-left: 4px solid #4e73df !important;
        }

        .border-left-warning {
            border-left: 4px solid #f6c23e !important;
        }

        .border-left-danger {
            border-left: 4px solid #e74a3b !important;
        }

        .border-left-success {
            border-left: 4px solid #1cc88a !important;
        }

        .form-control:focus {
            border-color: #f6c23e;
            box-shadow: 0 0 0 0.2rem rgba(246, 194, 62, 0.15);
        }

        .preview-container {
            width: 100%;
            height: 200px;
            border: 2px dashed #d1d3e2;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background-color: #f8f9fc;
            transition: all 0.3s ease;
        }

        .preview-img {
            max-width: 100%;
            max-height: 100%;
            object-fit: cover;
        }

        .custom-file-label::after {
            content: "Chọn ảnh";
        }
    </style>
</head>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-edit text-warning mr-2"></i>Cập nhật Chương trình Ưu đãi
        </h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-11 col-lg-12">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editPromotionForm" class="card shadow-lg mb-4 border-left-warning">
                @* Các trường ẩn quan trọng *@
                <input type="hidden" asp-for="MaKM" />
                <input type="hidden" asp-for="HinhAnh" />

                <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-warning text-uppercase">
                        <i class="fas fa-ticket-alt mr-1"></i> Mã: @Model.MaKM
                    </h6>
                    <span class="badge badge-warning text-dark p-2 shadow-sm">
                        <i class="fas fa-sync-alt mr-1"></i> Chế độ chỉnh sửa
                    </span>
                </div>

                <div class="card-body px-lg-5 py-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small shadow-sm" role="alert"></div>

                    <div class="row">
                        @* Cột 1: Hình ảnh *@
                        <div class="col-md-4 border-right">
                            <h6 class="font-weight-bold text-dark mb-3">
                                <i class="fas fa-image mr-2 text-warning"></i>Hình ảnh đại diện
                            </h6>

                            <div class="form-group mb-3 text-center">
                                <div class="preview-container mb-3 shadow-sm">
                                    @{
                                        // Logic hiển thị ảnh: Nếu là URL (Cloudinary) thì dùng luôn, không thì trỏ vào folder local hoặc ảnh mặc định
                                        var imgSrc = string.IsNullOrEmpty(Model.HinhAnh)
                                        ? "https://res.cloudinary.com/dzvcaq2xl/image/upload/v1/WebAppBookingBoat/default-promo.jpg"
                                        : (Model.HinhAnh.StartsWith("http") ? Model.HinhAnh : "/images/khuyen-mai/" + Model.HinhAnh);
                                    }
                                    <img id="imgPreview" src="@imgSrc" class="preview-img" alt="Preview" />
                                </div>

                                <div class="custom-file mb-2">
                                    <input type="file" name="ImageFile" class="custom-file-input" id="HinhAnhInput" accept="image/*">
                                    <label class="custom-file-label text-left shadow-sm" for="HinhAnhInput">Thay đổi ảnh mới...</label>
                                </div>
                                <small class="text-muted d-block mt-1"><i>Giữ trống để sử dụng ảnh hiện tại</i></small>
                            </div>

                            <div class="form-group">
                                <label asp-for="MoTa" class="small font-weight-bold text-muted text-uppercase">Mô tả chi tiết</label>
                                <textarea asp-for="MoTa" class="form-control shadow-sm" rows="3" placeholder="Nhập mô tả chương trình..."></textarea>
                                <span asp-validation-for="MoTa" class="text-danger small"></span>
                            </div>
                        </div>

                        @* Cột 2: Nội dung *@
                        <div class="col-md-4 border-right">
                            <h6 class="font-weight-bold text-dark mb-3">
                                <i class="fas fa-info-circle mr-2 text-warning"></i>Nội dung ưu đãi
                            </h6>

                            <div class="form-group mb-4">
                                <label asp-for="TenChuongTrinh" class="small font-weight-bold text-muted text-uppercase">Tên chương trình</label>
                                <input asp-for="TenChuongTrinh" class="form-control border-left-primary shadow-sm" />
                                <span asp-validation-for="TenChuongTrinh" class="text-danger small"></span>
                            </div>

                            <div class="row">
                                <div class="col-6">
                                    <div class="form-group mb-4">
                                        <label asp-for="PhanTramGiam" class="small font-weight-bold text-muted text-uppercase">% Giảm</label>
                                        <div class="input-group shadow-sm">
                                            <input asp-for="PhanTramGiam" type="number" class="form-control border-left-success" />
                                            <div class="input-group-append"><span class="input-group-text bg-white">%</span></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="form-group mb-4">
                                        <label asp-for="TrangThai" class="small font-weight-bold text-muted text-uppercase">Trạng thái</label>
                                        <select asp-for="TrangThai" class="form-control shadow-sm border-left-info">
                                            <option value="Sắp diễn ra">Sắp diễn ra</option>
                                            <option value="Đang diễn ra">Đang diễn ra</option>
                                            <option value="Đã kết thúc">Đã kết thúc</option>
                                            <option value="Đã hủy">Đã hủy</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="SoTienToiDaGiam" class="small font-weight-bold text-muted text-uppercase">Giảm tối đa (VNĐ)</label>
                                <div class="input-group shadow-sm">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0 font-weight-bold text-success">₫</span>
                                    </div>
                                    <input type="text" id="SoTienDisplay" class="form-control border-left-0 font-weight-bold"
                                           value="@Model.SoTienToiDaGiam.ToString("N0")" inputmode="numeric" />
                                    <input type="hidden" asp-for="SoTienToiDaGiam" id="SoTienReal" />
                                </div>
                                <span asp-validation-for="SoTienToiDaGiam" class="text-danger small"></span>
                            </div>
                        </div>

                        @* Cột 3: Thời gian *@
                        <div class="col-md-4 pl-md-4">
                            <h6 class="font-weight-bold text-dark mb-3">
                                <i class="fas fa-calendar-alt mr-2 text-warning"></i>Hiệu lực thời gian
                            </h6>

                            <div class="form-group mb-4">
                                <label asp-for="NgayBatDau" class="small font-weight-bold text-muted text-uppercase">Ngày bắt đầu</label>
                                <input asp-for="NgayBatDau" type="date" class="form-control shadow-sm border-left-warning"
                                       value="@Model.NgayBatDau.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="NgayBatDau" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="NgayKetThuc" class="small font-weight-bold text-muted text-uppercase">Ngày kết thúc</label>
                                <input asp-for="NgayKetThuc" type="date" class="form-control shadow-sm border-left-danger"
                                       value="@Model.NgayKetThuc.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="NgayKetThuc" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="Index" class="btn btn-secondary btn-icon-split shadow-sm">
                        <span class="icon text-white-50"><i class="fas fa-arrow-left"></i></span>
                        <span class="text">Quay lại</span>
                    </a>

                    <button type="submit" class="btn btn-warning btn-icon-split shadow-sm font-weight-bold text-dark">
                        <span class="icon text-dark-50"><i class="fas fa-save"></i></span>
                        <span class="text">Lưu thay đổi</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            const displayInput = $('#SoTienDisplay');
            const realInput = $('#SoTienReal');
            const hinhAnhInput = $('#HinhAnhInput');
            const imgPreview = $('#imgPreview');

            // 1. Xử lý Xem trước ảnh và Label
            hinhAnhInput.on('change', function() {
                const file = this.files[0];
                if (file) {
                    // Cập nhật text cho label
                    let fileName = file.name;
                    $(this).next('.custom-file-label').html(fileName);

                    // Hiển thị ảnh preview
                    let reader = new FileReader();
                    reader.onload = function(e) {
                        imgPreview.attr('src', e.target.result);
                    }
                    reader.readAsDataURL(file);
                }
            });

            // 2. Định dạng tiền tệ VNĐ (ngay khi load và khi nhập)
            function formatCurrency(val) {
                return val.replace(/\D/g, "").replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            }

            displayInput.on('input', function () {
                let rawValue = $(this).val().replace(/\D/g, "");
                $(this).val(formatCurrency(rawValue));
                realInput.val(rawValue);
            });

            // 3. Xử lý Validation trước khi Submit
            $('#editPromotionForm').on('submit', function (e) {
                const start = new Date($('#NgayBatDau').val());
                const end = new Date($('#NgayKetThuc').val());

                if (end < start) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Ngày không hợp lệ',
                        text: 'Ngày kết thúc không được nhỏ hơn ngày bắt đầu!'
                    });
                    e.preventDefault();
                    return false;
                }

                // Gán giá trị số nguyên vào input hidden trước khi gửi
                realInput.val(displayInput.val().replace(/,/g, ''));

                // Mở khóa để đảm bảo dữ liệu được gửi đi nếu cần,
                // nhưng ở đây ta dùng input hidden 'SoTienReal' nên không lo bị mất format.
            });
        });
    </script>
}