@model WebAppBookingBoat.Models.KhuyenMai

@{
    ViewData["Title"] = "Thiết lập Chương trình Ưu đãi";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-ticket-alt text-primary mr-2"></i>Thiết lập Khuyến mãi mới
        </h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-12">
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header py-3 bg-white border-bottom">
                    <h6 class="m-0 font-weight-bold text-primary text-uppercase small">
                        <i class="fas fa-plus-circle mr-1"></i> Thông tin chương trình ưu đãi
                    </h6>
                </div>

                <div class="card-body px-lg-5 py-4">
                    <form asp-action="Create" method="post" id="createPromotionForm" enctype="multipart/form-data">
                        @* Giữ lại mã tự động được tạo từ Controller *@
                        <input type="hidden" asp-for="MaKM" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small shadow-sm" role="alert"></div>

                        <div class="row">
                            @* Cột trái: Hình ảnh & Nội dung *@
                            <div class="col-md-6 border-right">
                                <h6 class="font-weight-bold text-dark mb-3"><i class="fas fa-image mr-2 text-primary"></i>Hình ảnh & Mô tả</h6>

                                <div class="form-group mb-4">
                                    <label class="small font-weight-bold text-muted text-uppercase">Banner khuyến mãi</label>
                                    <div class="custom-file">
                                        <input type="file" name="ImageFile" class="custom-file-input" id="customFile" accept="image/*">
                                        <label class="custom-file-label shadow-sm" for="customFile">Chọn ảnh...</label>
                                    </div>
                                    <div class="mt-3 text-center">
                                        <img id="previewImg" src="/images/no-image.png" class="img-thumbnail shadow-sm" style="height: 120px; width: 200px; object-fit: cover;">
                                    </div>
                                </div>

                                <div class="form-group mb-4">
                                    <label asp-for="TenChuongTrinh" class="small font-weight-bold text-muted text-uppercase">Tên chương trình</label>
                                    <input asp-for="TenChuongTrinh" class="form-control border-left-primary shadow-sm" placeholder="Ví dụ: Ưu đãi Hè rực rỡ" />
                                    <span asp-validation-for="TenChuongTrinh" class="text-danger small mt-1"></span>
                                </div>

                                <div class="form-group mb-4">
                                    <label asp-for="MoTa" class="small font-weight-bold text-muted text-uppercase">Mô tả ngắn</label>
                                    <textarea asp-for="MoTa" class="form-control shadow-sm" rows="3" placeholder="Chi tiết chương trình..."></textarea>
                                    <span asp-validation-for="MoTa" class="text-danger small mt-1"></span>
                                </div>
                            </div>

                            @* Cột phải: Cấu hình & Thời gian *@
                            <div class="col-md-6 pl-md-4">
                                <h6 class="font-weight-bold text-dark mb-3"><i class="fas fa-cog mr-2 text-primary"></i>Cấu hình mức giảm</h6>

                                <div class="row mb-4">
                                    <div class="col-6">
                                        <label asp-for="PhanTramGiam" class="small font-weight-bold text-muted text-uppercase">% Giảm</label>
                                        <div class="input-group shadow-sm">
                                            <input asp-for="PhanTramGiam" type="number" class="form-control" placeholder="10" />
                                            <div class="input-group-append">
                                                <span class="input-group-text bg-light">%</span>
                                            </div>
                                        </div>
                                        <span asp-validation-for="PhanTramGiam" class="text-danger small mt-1"></span>
                                    </div>
                                    <div class="col-6">
                                        <label asp-for="SoTienToiDaGiam" class="small font-weight-bold text-muted text-uppercase">Giảm tối đa</label>
                                        @* Ô hiển thị cho người dùng nhập *@
                                        <input type="text" id="SoTienDisplay" class="form-control shadow-sm text-right" placeholder="50,000"
                                               value="@(Model?.SoTienToiDaGiam.ToString("N0"))" />

                                        @* Ô thực tế gửi về Server (asp-for nằm ở đây) *@
                                        <input type="hidden" asp-for="SoTienToiDaGiam" id="SoTienReal" />

                                        <span asp-validation-for="SoTienToiDaGiam" class="text-danger small mt-1"></span>
                                    </div>
                                </div>

                                <h6 class="font-weight-bold text-dark mb-3 mt-4"><i class="fas fa-calendar-alt mr-2 text-primary"></i>Thời gian áp dụng</h6>
                                <div class="row mb-4">
                                    <div class="col-6">
                                        <label asp-for="NgayBatDau" class="small font-weight-bold text-muted text-uppercase">Bắt đầu</label>
                                        <input asp-for="NgayBatDau" type="date" class="form-control shadow-sm border-left-success" />
                                        <span asp-validation-for="NgayBatDau" class="text-danger small mt-1"></span>
                                    </div>
                                    <div class="col-6">
                                        <label asp-for="NgayKetThuc" class="small font-weight-bold text-muted text-uppercase">Kết thúc</label>
                                        <input asp-for="NgayKetThuc" type="date" class="form-control shadow-sm border-left-danger" />
                                        <span asp-validation-for="NgayKetThuc" class="text-danger small mt-1"></span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label asp-for="TrangThai" class="small font-weight-bold text-muted text-uppercase">Trạng thái ban đầu</label>
                                    <select asp-for="TrangThai" class="form-control shadow-sm border-left-info">
                                        <option value="Sắp diễn ra">Sắp diễn ra</option>
                                        <option value="Đang diễn ra">Đang diễn ra</option>
                                        <option value="Đã kết thúc">Đã kết thúc</option>
                                        <option value="Đã hủy">Đã hủy</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="Index" class="btn btn-secondary btn-icon-split shadow-sm">
                                <span class="icon text-white-50"><i class="fas fa-arrow-left"></i></span>
                                <span class="text font-weight-bold">Quay lại</span>
                            </a>
                            <button type="submit" class="btn btn-primary btn-icon-split shadow-sm">
                                <span class="icon text-white-50"><i class="fas fa-save"></i></span>
                                <span class="text font-weight-bold">Tạo khuyến mãi</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        .border-left-primary {
            border-left: 4px solid #4e73df !important;
        }

        .border-left-success {
            border-left: 4px solid #1cc88a !important;
        }

        .border-left-danger {
            border-left: 4px solid #e74a3b !important;
        }

        .border-left-info {
            border-left: 4px solid #36b9cc !important;
        }

        .custom-file-label::after {
            content: "Duyệt";
        }

        .form-control, .custom-file-label {
            border-radius: 8px;
        }
    </style>

    <script>
                $(document).ready(function () {
            const displayInput = $('#SoTienDisplay');
            const realInput = $('#SoTienReal');

            // Hàm định dạng hiển thị
            function formatNumber(n) {
                return n.replace(/\D/g, "").replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            }

            // Khi người dùng gõ vào ô hiển thị
            displayInput.on('input', function () {
                let value = $(this).val();

                // 1. Cập nhật chính nó với dấu phẩy
                $(this).val(formatNumber(value));

                // 2. Cập nhật ô ẩn với số thuần túy để gửi lên server
                let rawValue = $(this).val().replace(/,/g, '');
                realInput.val(rawValue);
            });

            // 4. Xử lý trước khi gửi Form
            $('#createPromotionForm').on('submit', function (e) {
                // Đảm bảo ô ẩn có giá trị trước khi submit
                let finalValue = displayInput.val().replace(/,/g, '');
                realInput.val(finalValue);

                // Vô hiệu hóa ô hiển thị để nó không gửi trùng dữ liệu hoặc gây lỗi Format
                displayInput.prop('disabled', true);

                return true;
            });

            // Nếu Form bị lỗi server-side và load lại, disabled sẽ bị giữ, cần mở lại
            $(window).on('pageshow', function() {
                displayInput.prop('disabled', false);
            });
        });
    </script>
}