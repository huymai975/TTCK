@model WebAppBookingBoat.Models.KhuyenMai

@{
    ViewData["Title"] = "Thiết lập Chương trình Ưu đãi";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-ticket-alt text-primary mr-2"></i>Thiết lập Khuyến mãi mới
        </h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-12">
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header py-3 bg-white border-bottom">
                    <h6 class="m-0 font-weight-bold text-primary text-uppercase small">
                        <i class="fas fa-plus-circle mr-1"></i> Thông tin chương trình ưu đãi
                    </h6>
                </div>

                <div class="card-body px-lg-5 py-4">
                    <form asp-action="Create" method="post" id="createPromotionForm" enctype="multipart/form-data">
                        @* Mã khuyến mãi thường được xử lý tự động trong Controller/DB *@
                        <input type="hidden" asp-for="MaKM" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small shadow-sm" role="alert"></div>

                        <div class="row">
                            @* Cột trái: Hình ảnh & Nội dung *@
                            <div class="col-md-6 border-right">
                                <h6 class="font-weight-bold text-dark mb-3"><i class="fas fa-image mr-2 text-primary"></i>Hình ảnh & Mô tả</h6>

                                <div class="form-group mb-4 text-center">
                                    <label class="small font-weight-bold text-muted text-uppercase d-block text-left">Banner khuyến mãi</label>
                                    <div class="preview-wrapper mb-3 border rounded p-2 bg-light">
                                        <img id="previewImg" src="https://res.cloudinary.com/dzvcaq2xl/image/upload/v1/WebAppBookingBoat/default-promo.jpg"
                                             class="img-fluid rounded shadow-sm" style="max-height: 180px; width: 100%; object-fit: cover;">
                                    </div>
                                    <div class="custom-file">
                                        <input type="file" name="ImageFile" class="custom-file-input" id="customFile" accept="image/*">
                                        <label class="custom-file-label shadow-sm text-left" for="customFile">Chọn ảnh banner...</label>
                                    </div>
                                </div>

                                <div class="form-group mb-4">
                                    <label asp-for="TenChuongTrinh" class="small font-weight-bold text-muted text-uppercase">Tên chương trình</label>
                                    <input asp-for="TenChuongTrinh" class="form-control border-left-primary shadow-sm" placeholder="Ví dụ: Ưu đãi Hè rực rỡ" />
                                    <span asp-validation-for="TenChuongTrinh" class="text-danger small"></span>
                                </div>

                                <div class="form-group mb-4">
                                    <label asp-for="MoTa" class="small font-weight-bold text-muted text-uppercase">Mô tả chi tiết</label>
                                    <textarea asp-for="MoTa" class="form-control shadow-sm" rows="3" placeholder="Nhập nội dung ưu đãi..."></textarea>
                                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                                </div>
                            </div>

                            @* Cột phải: Cấu hình & Thời gian *@
                            <div class="col-md-6 pl-md-4">
                                <h6 class="font-weight-bold text-dark mb-3"><i class="fas fa-cog mr-2 text-primary"></i>Cấu hình mức giảm</h6>

                                <div class="row mb-4">
                                    <div class="col-6">
                                        <label asp-for="PhanTramGiam" class="small font-weight-bold text-muted text-uppercase">% Giảm</label>
                                        <div class="input-group shadow-sm">
                                            <input asp-for="PhanTramGiam" type="number" class="form-control" placeholder="10" />
                                            <div class="input-group-append">
                                                <span class="input-group-text bg-light">%</span>
                                            </div>
                                        </div>
                                        <span asp-validation-for="PhanTramGiam" class="text-danger small"></span>
                                    </div>
                                    <div class="col-6">
                                        <label asp-for="SoTienToiDaGiam" class="small font-weight-bold text-muted text-uppercase">Giảm tối đa</label>
                                        <input type="text" id="SoTienDisplay" class="form-control shadow-sm text-right font-weight-bold text-danger" placeholder="50,000" />
                                        <input type="hidden" asp-for="SoTienToiDaGiam" id="SoTienReal" />
                                        <span asp-validation-for="SoTienToiDaGiam" class="text-danger small"></span>
                                    </div>
                                </div>

                                <h6 class="font-weight-bold text-dark mb-3 mt-4"><i class="fas fa-calendar-alt mr-2 text-primary"></i>Thời gian áp dụng</h6>
                                <div class="row mb-4">
                                    <div class="col-6">
                                        <label asp-for="NgayBatDau" class="small font-weight-bold text-muted text-uppercase">Ngày bắt đầu</label>
                                        <input asp-for="NgayBatDau" type="date" class="form-control shadow-sm border-left-success" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                        <span asp-validation-for="NgayBatDau" class="text-danger small"></span>
                                    </div>
                                    <div class="col-6">
                                        <label asp-for="NgayKetThuc" class="small font-weight-bold text-muted text-uppercase">Ngày kết thúc</label>
                                        <input asp-for="NgayKetThuc" type="date" class="form-control shadow-sm border-left-danger" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")" />
                                        <span asp-validation-for="NgayKetThuc" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label asp-for="TrangThai" class="small font-weight-bold text-muted text-uppercase">Trạng thái khởi tạo</label>
                                    <select asp-for="TrangThai" class="form-control shadow-sm border-left-info">
                                        <option value="Sắp diễn ra">Sắp diễn ra</option>
                                        <option value="Đang diễn ra">Đang diễn ra</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-light btn-icon-split border shadow-sm">
                                <span class="icon text-gray-600"><i class="fas fa-arrow-left"></i></span>
                                <span class="text font-weight-bold">Quay lại</span>
                            </a>
                            <button type="submit" class="btn btn-primary btn-icon-split shadow-sm">
                                <span class="icon text-white-50"><i class="fas fa-check"></i></span>
                                <span class="text font-weight-bold">Xác nhận tạo mới</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        .border-left-primary {
            border-left: 4px solid #4e73df !important;
        }

        .border-left-success {
            border-left: 4px solid #1cc88a !important;
        }

        .border-left-danger {
            border-left: 4px solid #e74a3b !important;
        }

        .border-left-info {
            border-left: 4px solid #36b9cc !important;
        }

        .custom-file-label::after {
            content: "Duyệt";
        }

        .form-control {
            border-radius: 8px;
        }

        .preview-wrapper {
            transition: all 0.3s ease;
        }

            .preview-wrapper:hover {
                border-color: #4e73df !important;
            }
    </style>

    <script>
        $(document).ready(function () {
            const displayInput = $('#SoTienDisplay');
            const realInput = $('#SoTienReal');

            // 1. Xử lý xem trước ảnh
            $("#customFile").on('change', function () {
                const file = this.files[0];
                if (file) {
                    let reader = new FileReader();
                    reader.onload = function (e) {
                        $("#previewImg").attr("src", e.target.result);
                    };
                    reader.readAsDataURL(file);
                    $(this).next('.custom-file-label').html(file.name);
                }
            });

            // 2. Định dạng tiền tệ
            displayInput.on('input', function () {
                let value = $(this).val().replace(/\D/g, "");
                $(this).val(value.replace(/\B(?=(\d{3})+(?!\d))/g, ","));
                realInput.val(value);
            });

            // 3. Xử lý khi gửi Form
            $('#createPromotionForm').on('submit', function (e) {
                const start = new Date($('#NgayBatDau').val());
                const end = new Date($('#NgayKetThuc').val());

                if (end < start) {
                    Swal.fire('Lỗi', 'Ngày kết thúc không được trước ngày bắt đầu!', 'error');
                    e.preventDefault();
                    return false;
                }

                // Gán giá trị lần cuối cho ô ẩn
                realInput.val(displayInput.val().replace(/,/g, ''));

                // Tránh gửi dữ liệu từ ô display (ô này không có thuộc tính name nên mặc định không gửi,
                // nhưng disabled cho chắc chắn nếu bạn có dùng asp-for cho nó)
                displayInput.prop('disabled', true);
                return true;
            });

            // Mở lại ô input nếu quay lại từ history hoặc form lỗi
            $(window).on('pageshow', function() {
                displayInput.prop('disabled', false);
            });
        });
    </script>
}