@model WebAppBookingBoat.Models.KhuyenMai

@{
    ViewData["Title"] = "Chi tiết khuyến mãi";
}

<div class="container-fluid py-4">
    @* Nút Quay lại nhỏ ở trên cùng (Optional) *@
    <div class="mb-3">
        <a asp-action="Index" class="text-muted small text-decoration-none">
            <i class="fas fa-chevron-left mr-1"></i> Danh sách khuyến mãi
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-11">
            <div class="card shadow-lg border-0 overflow-hidden">

                @* CARD HEADER: Đưa Tiêu đề và Badge vào đây *@
                <div class="card-header bg-white py-3 d-sm-flex align-items-center justify-content-between border-bottom">
                    <h1 class="h4 mb-0 text-gray-800 font-weight-bold">
                        <i class="fas fa-ticket-alt text-primary mr-2"></i>Thông tin ưu đãi chi tiết
                    </h1>
                    @{
                        var badgeClass = Model.TrangThai switch
                        {
                            "Đang diễn ra" => "badge-success",
                            "Sắp diễn ra" => "badge-warning text-dark",
                            "Đã hủy" => "badge-danger",
                            _ => "badge-secondary"
                        };
                    }
                    <span class="badge @badgeClass px-4 py-2 shadow-sm text-uppercase">@Model.TrangThai</span>
                </div>

                <div class="card-body p-0">
                    <div class="row no-gutters">
                        @* PHẦN TRÁI: Hình ảnh Banner & Mô tả *@
                        <div class="col-lg-7 p-4">
                            <div class="position-relative mb-4 shadow-sm rounded overflow-hidden">
                                @{
                                    // Logic đường dẫn ảnh:
                                    // 1. Kiểm tra nếu HinhAnh trống -> Dùng ảnh mặc định.
                                    // 2. Nếu là URL tuyệt đối (bắt đầu bằng http) -> Dùng trực tiếp (Cloudinary).
                                    // 3. Nếu là tên file -> Trỏ vào folder /images/khuyen-mai/.
                                    var imageSrc = string.IsNullOrEmpty(Model.HinhAnh)
                                    ? "https://res.cloudinary.com/dzvcaq2xl/image/upload/v1/WebAppBookingBoat/default-promo.jpg"
                                    : (Model.HinhAnh.StartsWith("http") ? Model.HinhAnh : Url.Content("~/images/khuyen-mai/" + Model.HinhAnh));
                                }
                                <img src="@imageSrc"
                                     class="w-100"
                                     style="height: 350px; object-fit: cover;"
                                     alt="Banner">
                                <div class="promo-badge-floating">Mã KM: #@Model.MaKM</div>
                            </div>

                            <h4 class="font-weight-bold text-dark mb-3">@Model.TenChuongTrinh</h4>

                            <div class="mb-3">
                                <h6 class="text-uppercase text-muted font-weight-bold small mb-2">Mô tả chương trình</h6>
                                <div class="promo-description p-3 bg-light rounded border-left-primary">
                                    @if (!string.IsNullOrEmpty(Model.MoTa))
                                    {
                                        @Html.Raw(Model.MoTa.Replace("\n", "<br/>"))
                                    }
                                    else
                                    {
                                        <em class="text-muted">Không có mô tả chi tiết cho chương trình này.</em>
                                    }
                                </div>
                            </div>
                        </div>

                        @* PHẦN PHẢI: Thông số ưu đãi *@
                        <div class="col-lg-5 bg-light p-4 border-left">
                            <div class="mb-4">
                                <h6 class="text-uppercase text-muted font-weight-bold small mb-3 text-center">Giá trị ưu đãi</h6>
                                @* Voucher Card Style *@
                                <div class="voucher-card shadow-sm">
                                    <div class="voucher-left bg-primary text-white">
                                        <div class="h2 mb-0 font-weight-bold">@Model.PhanTramGiam%</div>
                                        <div class="small font-weight-bold">GIẢM</div>
                                    </div>
                                    <div class="voucher-right bg-white border-right">
                                        <div class="small text-muted text-uppercase font-weight-bold">Tối đa lên đến</div>
                                        <div class="h4 font-weight-bold text-danger mb-0">@Model.SoTienToiDaGiam.ToString("N0")đ</div>
                                    </div>
                                </div>
                            </div>

                            <h6 class="text-uppercase text-muted font-weight-bold small mb-3">Thời hạn áp dụng</h6>
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="icon-square bg-success-light text-success mr-3 shadow-sm">
                                            <i class="fas fa-calendar-check"></i>
                                        </div>
                                        <div>
                                            <div class="small text-muted">Ngày bắt đầu</div>
                                            <div class="font-weight-bold text-dark">@Model.NgayBatDau.ToString("dd/MM/yyyy")</div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-square bg-danger-light text-danger mr-3 shadow-sm">
                                            <i class="fas fa-calendar-times"></i>
                                        </div>
                                        <div>
                                            <div class="small text-muted">Ngày kết thúc</div>
                                            <div class="font-weight-bold text-dark">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (Model.NgayKetThuc < DateTime.Now && Model.TrangThai != "Đã kết thúc")
                            {
                                <div class="alert alert-warning border-0 small shadow-sm animate__animated animate__fadeIn">
                                    <i class="fas fa-exclamation-triangle mr-1 text-warning"></i>
                                    <strong>Chú ý:</strong> Chương trình đã quá thời hạn kết thúc.
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* CARD FOOTER: Vị trí nút cũ *@
                <div class="card-footer bg-white d-flex justify-content-between py-3 px-4 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 shadow-sm hover-elevate">
                        <i class="fas fa-arrow-left mr-2"></i>Quay lại
                    </a>

                    @if (Model.TrangThai != "Đã kết thúc" && Model.TrangThai != "Đã hủy")
                    {
                        <a asp-action="Edit" asp-route-id="@Model.MaKM" class="btn btn-primary px-4 shadow-sm hover-elevate">
                            <i class="fas fa-edit mr-2"></i>Chỉnh sửa ưu đãi
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary px-4 disabled shadow-sm" disabled>
                            <i class="fas fa-lock mr-2"></i>Đã khóa chỉnh sửa
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-primary {
        border-left: 4px solid #4e73df !important;
    }

    .promo-badge-floating {
        position: absolute;
        top: 15px;
        left: 15px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 6px 16px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: bold;
        backdrop-filter: blur(8px);
        letter-spacing: 0.5px;
    }

    .voucher-card {
        display: flex;
        border-radius: 12px;
        overflow: hidden;
        border: 2px dashed #4e73df;
    }

    .voucher-left {
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-width: 110px;
        border-right: 1px dashed rgba(255,255,255,0.3);
    }

    .voucher-right {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .icon-square {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .bg-success-light {
        background-color: #e8f5e9;
    }

    .bg-danger-light {
        background-color: #ffebee;
    }

    .promo-description {
        min-height: 120px;
        font-size: 0.95rem;
        line-height: 1.7;
        color: #5a5c69;
        background-color: #ffffff !important;
        border: 1px solid #e3e6f0;
    }

    .hover-elevate:hover {
        transform: translateY(-2px);
        transition: all 0.2s ease-in-out;
    }
</style>