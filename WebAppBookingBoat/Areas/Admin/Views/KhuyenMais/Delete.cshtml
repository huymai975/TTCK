@model WebAppBookingBoat.Models.KhuyenMai

@{
    ViewData["Title"] = "Xác nhận xóa khuyến mãi";
}

<div class="container-fluid">
    @* Tiêu đề đồng bộ *@
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-trash-alt text-danger mr-2"></i>Gỡ bỏ Chương trình Ưu đãi
        </h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">
            @* Alert cảnh báo *@
            <div class="alert alert-danger border-left-danger shadow-sm py-3 mb-4 bg-white">
                <div class="row no-gutters align-items-center">
                    <div class="col-auto mr-3">
                        <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
                    </div>
                    <div class="col">
                        <h6 class="m-0 font-weight-bold text-danger">Cảnh báo xóa dữ liệu!</h6>
                        <span class="text-muted small">
                            Việc xóa chương trình khuyến mãi sẽ khiến khách hàng không thể áp dụng ưu đãi này cho các giao dịch mới.
                        </span>
                    </div>
                </div>
            </div>

            <div class="card shadow-lg mb-4 border-left-danger">
                @* Header *@
                <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-danger text-uppercase">
                        Mã KM: #@Model.MaKM
                    </h6>
                    <span class="badge badge-danger px-3 py-2 shadow-sm">
                        <i class="fas fa-tag mr-1"></i> @Model.TrangThai
                    </span>
                </div>

                <div class="card-body">
                    <div class="row">
                        @* Thông tin chi tiết KM *@
                        <div class="col-md-7 border-right">
                            <h6 class="font-weight-bold text-muted text-uppercase mb-3 small">Nội dung chương trình</h6>
                            <div class="p-3 bg-light rounded mb-3">
                                <div class="h5 font-weight-bold text-primary mb-1">@Model.TenChuongTrinh</div>
                                <div class="text-dark">
                                    Mức ưu đãi: <strong class="text-success">@Model.PhanTramGiam%</strong>
                                    (Tối đa: <strong class="text-success">@Model.SoTienToiDaGiam!.ToString("N0")đ</strong>)
                                </div>
                            </div>
                        </div>

                        @* Thông tin thời gian *@
                        <div class="col-md-5 pl-md-4">
                            <h6 class="font-weight-bold text-muted text-uppercase mb-3 small">Thời gian hiệu lực</h6>
                            <div class="mb-2">
                                <small class="text-muted d-block">Bắt đầu:</small>
                                <div class="font-weight-bold">@Model.NgayBatDau.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted d-block">Kết thúc:</small>
                                <div class="font-weight-bold">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Footer hành động *@
                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="Index" class="btn btn-secondary btn-icon-split shadow-sm">
                        <span class="icon text-white-50">
                            <i class="fas fa-arrow-left"></i>
                        </span>
                        <span class="text">Hủy & Quay lại</span>
                    </a>

                    <form asp-action="Delete" id="deleteKmForm">
                        <input type="hidden" asp-for="MaKM" />
                        <button type="button" class="btn btn-danger btn-icon-split shadow-sm font-weight-bold" id="btnConfirmDeleteKM">
                            <span class="icon text-white-50">
                                <i class="fas fa-trash-alt"></i>
                            </span>
                            <span class="text">Xác nhận xóa</span>
                        </button>
                    </form>
                </div>
            </div>

            <p class="mb-5 small text-muted text-center italic">
                <i class="fas fa-info-circle mr-1"></i> Lưu ý: Bạn có thể chọn trạng thái "Đã hủy" thay vì xóa nếu muốn giữ lại lịch sử chương trình.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on('click', '#btnConfirmDeleteKM', function () {
            const tenKM = '@Html.Raw(Model.TenChuongTrinh)';

            Swal.fire({
                title: 'Xóa khuyến mãi này?',
                text: `Bạn chắc chắn muốn gỡ bỏ chương trình "${tenKM}" khỏi hệ thống?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                cancelButtonColor: '#858796',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Quay lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#deleteKmForm').submit();
                }
            });
        });
    </script>
}

<style>
    .border-left-danger {
        border-left: 4px solid #e74a3b !important;
    }

    .bg-light {
        background-color: #f8f9fc !important;
    }

    .italic {
        font-style: italic;
    }
</style>