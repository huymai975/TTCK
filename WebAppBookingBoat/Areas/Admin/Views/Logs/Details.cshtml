@model WebAppBookingBoat.Models.Log

@{
    ViewData["Title"] = "Chi tiết Nhật ký hệ thống";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-info-circle text-info mr-2"></i>Chi tiết Nhật ký
        </h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card shadow-lg mb-4 border-left-info">
                @* Card Header *@
                <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-info text-uppercase">Mã Log: #@Model.MaLog</h6>
                    <span class="badge badge-light border text-muted shadow-sm px-3 py-2">
                        <i class="fas fa-clock mr-1"></i> @Model.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")
                    </span>
                </div>

                <div class="card-body">
                    <div class="row">
                        @* Cột 1: Thông tin cơ bản *@
                        <div class="col-md-6 border-right">
                            <h5 class="font-weight-bold text-dark mb-4 border-bottom pb-2">
                                <i class="fas fa-user-shield mr-2 text-info"></i>Đối tượng & Hành động
                            </h5>

                            <div class="mb-4">
                                <label class="small font-weight-bold text-muted text-uppercase d-block">Tài khoản thực hiện</label>
                                <div class="h5 font-weight-bold text-primary">
                                    <i class="fas fa-user-circle mr-1"></i> @(Model.AppUser?.UserName ?? "Hệ thống / Guest")
                                </div>
                                <small class="text-muted">ID: @Model.MaTK</small>
                            </div>

                            <div class="mb-4">
                                <label class="small font-weight-bold text-muted text-uppercase d-block">Địa chỉ IP</label>
                                <div class="h6 font-weight-bold">
                                    <i class="fas fa-network-wired mr-1 text-secondary"></i> @(Model.IpAddress ?? "N/A")
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="small font-weight-bold text-muted text-uppercase d-block">Bảng tác động</label>
                                <div class="badge badge-light border p-2 w-100 text-left">
                                    <i class="fas fa-table mr-1 text-info"></i> @Model.BangTacDong
                                </div>
                            </div>
                        </div>

                        @* Cột 2: Nội dung chi tiết *@
                        <div class="col-md-6 pl-md-4">
                            <h5 class="font-weight-bold text-dark mb-4 border-bottom pb-2">
                                <i class="fas fa-file-alt mr-2 text-info"></i>Nội dung ghi chú
                            </h5>

                            <div class="mb-4">
                                <label class="small font-weight-bold text-muted text-uppercase d-block">Loại Log</label>
                                @{
                                    var typeBadge = Model.LoaiLog switch
                                    {
                                        "Error" => "badge-danger",
                                        "Warning" => "badge-warning text-dark",
                                        "Info" => "badge-info",
                                        _ => "badge-secondary"
                                    };
                                }
                                <span class="badge @typeBadge px-3 py-2 shadow-sm">@Model.LoaiLog</span>
                            </div>

                            <div class="mb-4">
                                <label class="small font-weight-bold text-muted text-uppercase d-block">Hành động</label>
                                <div class="h6 font-weight-bold text-dark">@Model.HanhDong</div>
                            </div>

                            <div class="p-3 bg-light rounded border shadow-sm">
                                <label class="small font-weight-bold text-muted text-uppercase d-block mb-2">Chi tiết dữ liệu</label>
                                <div class="text-dark" style="white-space: pre-wrap; font-family: 'Courier New', Courier, monospace; font-size: 0.9rem;">
                                    @Model.NoiDungChiTiet
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Card Footer *@
                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="Index" class="btn btn-secondary btn-icon-split shadow-sm">
                        <span class="icon text-white-50">
                            <i class="fas fa-arrow-left"></i>
                        </span>
                        <span class="text">Quay lại danh sách</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-info {
        border-left: 4px solid #36b9cc !important;
    }

    .bg-light {
        background-color: #f8f9fc !important;
    }
</style>