@model IEnumerable<WebAppBookingBoat.Models.Log>

@{
    ViewData["Title"] = "Nhật ký hệ thống";
}

<style>
    /* Đồng bộ Style với trang Lịch Trình của Huy */
    #dataTable {
        table-layout: fixed;
        width: 100% !important;
        border-collapse: separate;
        border-spacing: 0;
    }

    .col-time {
        width: 160px;
    }

    .col-user {
        width: 150px;
    }

    .col-type {
        width: 100px;
    }

    .col-action {
        width: 150px;
    }

    .col-table {
        width: 120px;
    }

    .col-tool {
        width: 100px;
    }

    .badge-status {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .btn-modern {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .btn-view {
        background-color: #e1f5fe;
        color: #039be5;
    }

        .btn-view:hover {
            background-color: #039be5;
            color: #fff;
        }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-history text-primary mr-2"></i>Nhật ký hệ thống
        </h1>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body p-3" style="background-color: #f8f9fc;">
            <div class="row align-items-end">
                <div class="col-md-3">
                    <label class="small font-weight-bold text-muted">Loại Log</label>
                    <select id="typeFilter" class="form-control form-control-sm border-0 shadow-sm font-weight-bold text-info">
                        <option value="">Tất cả loại Log</option>
                        <option value="Info">Info</option>
                        <option value="Warning">Warning</option>
                        <option value="Error">Error</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="small font-weight-bold text-muted">Từ ngày</label>
                    <input type="date" id="fromDate" class="form-control form-control-sm border-0 shadow-sm">
                </div>
                <div class="col-md-3">
                    <label class="small font-weight-bold text-muted">Đến ngày</label>
                    <input type="date" id="toDate" class="form-control form-control-sm border-0 shadow-sm">
                </div>
                <div class="col-md-3 text-right">
                    <button id="btnResetFilter" class="btn btn-sm btn-light shadow-sm mr-2" title="Làm mới">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                    <button type="button" onclick="deleteLogsByDate()" class="btn btn-sm btn-danger shadow-sm font-weight-bold">
                        <i class="fas fa-eraser mr-1"></i> Xóa theo ngày
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="dataTable">
                <thead class="bg-light text-muted small font-weight-bold">
                    <tr>
                        <th class="col-time border-0">Thời gian</th>
                        <th class="col-user border-0">Tài khoản</th>
                        <th class="col-type border-0 text-center">Loại</th>
                        <th class="col-action border-0">Hành động</th>
                        <th class="col-table border-0">Bảng tác động</th>
                        <th class="col-tool border-0 text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="small font-weight-bold text-gray-600">@item.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>
                                <div class="badge badge-light border text-dark p-2 shadow-sm w-100 text-left">
                                    <i class="fas fa-user-circle mr-1 text-primary"></i> @(item.AppUser?.UserName ?? "Hệ thống")
                                </div>
                            </td>
                            <td class="text-center">
                                @if (item.LoaiLog == "Error")
                                {
                                    <span class="badge badge-status bg-danger text-white shadow-sm">Error</span>
                                }
                                else if (item.LoaiLog == "Warning")
                                {

                                    <span class="badge badge-status bg-warning text-dark shadow-sm">Warning</span>
                                }
                                else
                                {

                                    <span class="badge badge-status bg-info text-white shadow-sm">Info</span>
                                }
                            </td>
                            <td class="small font-weight-bold">@item.HanhDong</td>
                            <td><span class="text-muted small">@item.BangTacDong</span></td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.MaLog" class="btn-modern btn-view" title="Chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <button type="button" class="btn-modern btn-delete" onclick="deleteLogAjax(@item.MaLog)" title="Xóa Log">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var table;

        // 1. Logic lọc ngày tùy chỉnh cho DataTable (Global)
        $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
            var from = $('#fromDate').val();
            var to = $('#toDate').val();

            // Lấy cột ngày (cột 0), cắt bỏ phần giờ để so sánh ngày
            var dateStr = data[0].split(' ')[0];
            var parts = dateStr.split('/');
            var rowDate = new Date(parts[2], parts[1] - 1, parts[0]);

            var min = from ? new Date(from) : null;
            var max = to ? new Date(to) : null;

            if (min) min.setHours(0,0,0,0);
            if (max) max.setHours(23,59,59,999);

            if ((min === null && max === null) ||
                (min === null && rowDate <= max) ||
                (min <= rowDate && max === null) ||
                (min <= rowDate && rowDate <= max)) {
                return true;
            }
            return false;
        });

        $(document).ready(function() {
            // 2. Khử lỗi "Cannot reinitialise"
            if ($.fn.DataTable.isDataTable('#dataTable')) {
                $('#dataTable').DataTable().destroy();
            }

            // 3. Khởi tạo DataTable duy nhất một lần
            table = $('#dataTable').DataTable({
                "processing": true,
                "deferRender": true,
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json",
                    "searchPlaceholder": "Tìm tài khoản, hành động...",
                    "paginate": {
                        "previous": "<i class='fas fa-angle-left'></i>",
                        "next": "<i class='fas fa-angle-right'></i>"
                    }
                },
                "pageLength": 10,
                "order": [[0, "desc"]], // Mới nhất lên đầu
                "dom": "<'row px-3 py-3'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                       "<'row'<'col-sm-12'tr>>" +
                       "<'row px-3 py-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
            });

            // 4. Sự kiện khi thay đổi các bộ lọc (Type, FromDate, ToDate)
            $('#typeFilter, #fromDate, #toDate').on('change', function() {
                var type = $('#typeFilter').val();
                // Lọc chính xác ở cột Loại (cột 2)
                table.column(2).search(type ? '^' + type + '$' : '', true, false);
                table.draw();
            });

            // 5. Nút Làm mới (Reset)
            $('#btnResetFilter').on('click', function() {
                $('#typeFilter, #fromDate, #toDate').val('');
                table.search('').column(2).search('').draw();
            });
        });

        // 6. Hàm xóa hàng loạt theo ngày
        function deleteLogsByDate() {
            var from = $('#fromDate').val();
            var to = $('#toDate').val();

            if (!from || !to) {
                Swal.fire('Chú ý', 'Vui lòng chọn cả "Từ ngày" và "Đến ngày" để thực hiện!', 'info');
                return;
            }

            Swal.fire({
                title: 'Xóa nhật ký hàng loạt?',
                text: `Tất cả dữ liệu từ ${from} đến ${to} sẽ bị xóa vĩnh viễn!`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                confirmButtonText: 'Xác nhận xóa sạch',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("DeleteByRange", "Logs")',
                        type: 'POST',
                        data: {
                            fromDate: from,
                            toDate: to,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Thành công!', response.message, 'success').then(() => location.reload());
                            } else {
                                Swal.fire('Lỗi!', response.message, 'error');
                            }
                        }
                    });
                }
            });
        }

        // 7. Hàm xóa đơn lẻ (Ajax)
        function deleteLogAjax(id) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: `Xóa bản ghi nhật ký #${id}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Logs")',
                        type: 'POST',
                        data: {
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    title: 'Đã xóa!',
                                    icon: 'success',
                                    timer: 1000,
                                    showConfirmButton: false
                                }).then(() => {
                                    table.row($(`button[onclick*='deleteLogAjax(${id})']`).parents('tr')).remove().draw();
                                });
                            } else {
                                Swal.fire('Lỗi!', response.message, 'error');
                            }
                        }
                    });
                }
            });
        }
    </script>
}