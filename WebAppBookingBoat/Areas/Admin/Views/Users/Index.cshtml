@model IEnumerable<WebAppBookingBoat.Models.AppUser>
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager

@{
    ViewData["Title"] = "Quản lý Tài khoản";
    // Lấy ID người dùng hiện tại để so sánh
    var currentUserId = UserManager.GetUserId(User);
}

<style>
    /* 1. KHUNG BẢNG & TỈ LỆ CỘT */
    #dataTable {
        table-layout: fixed;
        width: 100% !important;
        border-collapse: separate;
        border-spacing: 0;
    }

    .col-id {
        width: 50px;
    }

    .col-info {
        width: auto;
    }

    .col-phone {
        width: 180px;
    }

    .col-status {
        width: 150px;
    }

    .col-action {
        width: 180px;
    }

    /* 2. STYLE NỘI DUNG */
    .text-user-name {
        display: block;
        font-weight: 700;
        color: #2c3e50;
        font-size: 0.95rem;
    }

    .btn-modern {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s ease;
        margin: 0 2px;
        border: none;
        text-decoration: none !important;
    }

        .btn-modern:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        /* Trạng thái nút bị vô hiệu hóa */
        .btn-modern:disabled {
            opacity: 0.3;
            cursor: not-allowed;
            background-color: #e9ecef !important;
            color: #6c757d !important;
        }

    .btn-edit {
        background-color: #fff8e1;
        color: #f57f17;
    }

    .btn-lock {
        background-color: #ffebee;
        color: #c62828;
    }

    .btn-unlock {
        background-color: #e3f2fd;
        color: #1976d2;
    }

    /* 3. DATATABLES CUSTOM */
    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid #d1d3e2;
        border-radius: 20px;
        padding: 5px 15px;
        width: 250px !important;
    }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-users-cog text-primary mr-2"></i>Quản lý Tài khoản
        </h1>
        <a asp-action="Create" class="btn btn-primary btn-icon-split shadow-sm border-0">
            <span class="icon text-white-50"><i class="fas fa-user-plus"></i></span>
            <span class="text font-weight-bold">Thêm tài khoản mới</span>
        </a>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header py-3 bg-white border-bottom d-flex align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary text-uppercase small">
                <i class="fas fa-list mr-1"></i> Danh sách người dùng
            </h6>
            <div class="d-flex align-items-center">
                <select id="statusFilter" class="form-control form-control-sm border-primary mr-2" style="width: 180px;">
                    <option value="">Tất cả trạng thái</option>
                    <option value="HOẠT ĐỘNG">Hoạt động</option>
                    <option value="VÔ HIỆU HÓA">Vô hiệu hóa</option>
                </select>
                <button id="btnResetFilter" class="btn btn-sm btn-outline-secondary" title="Làm mới">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive p-3">
                <table class="table table-hover align-middle mb-0" id="dataTable">
                    <thead class="bg-light text-muted small font-weight-bold">
                        <tr>
                            <th class="text-center col-id border-0">#</th>
                            <th class="col-info border-0">Tài khoản & Email</th>
                            <th class="col-phone border-0">Liên lạc</th>
                            <th class="text-center col-status border-0">Trạng thái</th>
                            <th class="text-center col-action border-0">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            bool isMainAdmin = user.UserName!.ToLower() == "admin";
                            bool isSelf = user.Id == currentUserId;

                            <tr>
                                <td class="text-center small text-muted font-weight-bold"></td>
                                <td>
                                    <span class="text-user-name">
                                        @user.UserName
                                        @if (isSelf)
                                        {
                                            <span class="badge badge-pill badge-primary ml-1" style="font-size: 10px;">BẠN</span>
                                        }
                                    </span>
                                    <small class="text-muted"><i class="fas fa-envelope mr-1"></i>@user.Email</small>
                                </td>
                                <td><i class="fas fa-phone-alt mr-1 small text-success"></i> @(user.PhoneNumber ?? "---")</td>
                                <td class="text-center">
                                    <span class="badge @(user.TrangThai ? "badge-success" : "badge-danger") p-2 shadow-sm" style="min-width: 100px;">
                                        @(user.TrangThai ? "HOẠT ĐỘNG" : "VÔ HIỆU HÓA")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn-modern btn-edit" title="Sửa"><i class="fas fa-user-edit"></i></a>

                                        @if (isMainAdmin || isSelf)
                                        {
                                            @* Vô hiệu hóa nút Khóa/Xóa đối với Admin tổng hoặc chính mình *@
                                            <button class="btn-modern btn-lock" disabled title="Không thể thao tác trên tài khoản này">
                                                <i class="fas @(user.TrangThai ? "fa-user-slash" : "fa-user-check")"></i>
                                            </button>
                                            @* <button class="btn-modern btn-lock" disabled title="Không thể thao tác trên tài khoản này">
                                                <i class="fas fa-trash-alt"></i>
                                            </button> *@
                                        }
                                        else
                                        {
                                            <button onclick="toggleStatus('@user.Id')" class="btn-modern @(user.TrangThai ? "btn-lock" : "btn-unlock")" title="@(user.TrangThai ? "Khóa tài khoản" : "Kích hoạt")">
                                                <i class="fas @(user.TrangThai ? "fa-user-slash" : "fa-user-check")"></i>
                                            </button>

                                            @* <button onclick="softDeleteUser('@user.Id', '@user.UserName')" class="btn-modern btn-lock" title="Xóa tài khoản">
                                                <i class="fas fa-trash-alt"></i>
                                            </button> *@
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>

    <script>
        var table;
        $(document).ready(function() {
            table = $('#dataTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "paginate": {
                        "previous": "<i class='fas fa-angle-left'></i>",
                        "next": "<i class='fas fa-angle-right'></i>",
                        "first": "<i class='fas fa-angle-double-left'></i>",
                        "last": "<i class='fas fa-angle-double-right'></i>"
                    },
                "pageLength": 10,
                "columnDefs": [
                    { "orderable": false, "targets": [0, 4] }
                ],
                "dom": "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                       "<'row'<'col-sm-12'tr>>" +
                       "<'row px-3 py-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });

            table.on('order.dt search.dt', function () {
                table.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                    cell.innerHTML = i + 1;
                });
            }).draw();

                    $('#statusFilter').on('change', function() {
            var val = $(this).val();
            // Thay vì dùng Regex ^$, mình chỉ search nội dung văn bản thông thường
            // DataTable sẽ tự tìm chữ "HOẠT ĐỘNG" bên trong các thẻ HTML
            table.column(3).search(val).draw();
        });

            $('#btnResetFilter').on('click', function() {
                $('#statusFilter').val('');
                table.search('').column(3).search('').draw();
            });
        });

                        function toggleStatus(id) {
            // 1. Hiện thông báo hỏi ý kiến Admin trước
            Swal.fire({
                title: 'Bạn có chắc chắn?',
                text: "Trạng thái của tài khoản này sẽ bị thay đổi!",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                // 2. Nếu Admin bấm "Đồng ý" thì mới gửi lệnh đi
                if (result.isConfirmed) {
                    $.post('@Url.Action("ToggleStatus", "Users")', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: 'Đã cập nhật trạng thái mới.',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            // Hiện lỗi nếu là Admin tổng hoặc chính mình (theo logic Controller của bạn)
                            Swal.fire('Thao tác bị chặn!', res.message, 'error');
                        }
                    });
                }
            });
        }

        function softDeleteUser(id, username) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: `Tài khoản "${username}" sẽ được chuyển sang trạng thái VÔ HIỆU HÓA!`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("SoftDelete", "Users")', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: res.message,
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi bảo mật!', res.message, 'error');
                        }
                    });
                }
            });
        }
    </script>
}