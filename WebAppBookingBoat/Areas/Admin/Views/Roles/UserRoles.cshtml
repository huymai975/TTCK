@model IEnumerable<WebAppBookingBoat.Areas.Admin.ViewModels.UserRolesViewModel>
@using Microsoft.AspNetCore.Identity
@inject UserManager<WebAppBookingBoat.Models.AppUser> UserManager

@{
    ViewData["Title"] = "Phân quyền người dùng";
}

<style>
    .avatar-circle-sm {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        background: linear-gradient(135deg, #4e73df, #224abe);
    }

    .badge {
        font-weight: 500;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(78, 115, 223, 0.05);
    }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-users-cog text-primary mr-2"></i>Phân quyền tài khoản
        </h1>
        <a asp-action="Index" class="btn btn-secondary btn-sm shadow-sm">
            <i class="fas fa-arrow-left mr-1"></i> Quay lại nhóm quyền
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" id="userRolesTable" width="100%" cellspacing="0">
                    <thead class="bg-light text-dark text-uppercase small font-weight-bold">
                        <tr>
                            <th>Tài khoản</th>
                            <th>Email</th>
                            <th class="text-center">Quyền hiện tại</th>
                            <th class="text-center" style="width: 220px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var isCurrentUser = user.UserId == UserManager.GetUserId(User);
                            <tr>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle-sm bg-primary text-white mr-2">
                                            @(user.UserName?[0].ToString().ToUpper() ?? "U")
                                        </div>
                                        <span class="font-weight-bold">@user.UserName</span>
                                        @if (isCurrentUser)
                                        {
                                            <span class="badge badge-dark ml-2 shadow-sm">Bạn</span>
                                        }
                                    </div>
                                </td>
                                <td class="align-middle">@user.Email</td>
                                <td class="align-middle text-center">
                                    @if (user.Roles.Contains("Admin"))
                                    {
                                        <span class="badge badge-danger p-2 w-75 shadow-sm">Quản trị viên</span>
                                    }
                                    else if (user.Roles.Contains("Staff"))
                                    {
                                        <span class="badge badge-success p-2 w-75 shadow-sm">Nhân viên</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-info p-2 w-75 shadow-sm">Khách hàng</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <div class="d-flex justify-content-center align-items-center">
                                        @if (!isCurrentUser && !user.Roles.Contains("Staff") && !user.Roles.Contains("Admin"))
                                        {
                                            <form asp-action="UpgradeToStaff" asp-route-userId="@user.UserId" method="post" class="mr-2 mb-0">
                                                <button type="button" class="btn btn-warning btn-sm btn-upgrade shadow-sm">
                                                    <i class="fas fa-arrow-up mr-1"></i> Lên NV
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="ManageUserRoles" asp-route-userId="@user.UserId"
                                           class="btn btn-primary btn-sm shadow-sm">
                                            <i class="fas fa-edit mr-1"></i> Quản lý
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            // 1. Khởi tạo DataTable (Kiểm tra tồn tại tránh lỗi trùng lặp)
            if (!$.fn.DataTable.isDataTable('#userRolesTable')) {
                $('#userRolesTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json"
                    },
                    "order": [[0, "asc"]],
                    "columnDefs": [
                        { "orderable": false, "targets": 3 } // Tắt sắp xếp cho cột Thao tác
                    ]
                });
            }

            // 2. Event Delegation cho nút Lên NV (Để hoạt động sau khi lọc/phân trang)
            $(document).on('click', '.btn-upgrade', function(e) {
                e.preventDefault();
                var form = $(this).closest('form');

                Swal.fire({
                    title: 'Xác nhận nâng cấp?',
                    text: "Tài khoản sẽ thành Nhân viên và hồ sơ sẽ được đồng bộ!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#f6c23e',
                    cancelButtonColor: '#858796',
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });

            // 3. Thông báo từ TempData
            @if (TempData["Success"] != null)
            {
                    <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: '@Html.Raw(TempData["Success"])',
                        timer: 2500,
                        showConfirmButton: false
                    });
                    </text>
            }

            @if (TempData["Error"] != null)
            {
                    <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi hệ thống',
                        text: '@Html.Raw(TempData["Error"])'
                    });
                    </text>
            }
        });
    </script>
}