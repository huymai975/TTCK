@model List<WebAppBookingBoat.Areas.Admin.ViewModels.ManageUserRolesViewModel>
@{
    ViewData["Title"] = "Cập nhật quyền";
}

<div class="container-fluid" style="max-width: 700px;">
    <form asp-action="ManageUserRoles" asp-route-userId="@Context.Request.Query["userId"]" method="post">
        <input type="hidden" name="userId" value="@ViewBag.CurrentUserId" />

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 font-weight-bold text-primary text-uppercase small">
                    <i class="fas fa-user-shield mr-2"></i>Thiết lập quyền cho: <span class="text-dark">@ViewBag.UserName</span>
                </h6>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center border-0 py-3 mb-2 rounded bg-light">
                            <div>
                                <input type="hidden" asp-for="@Model[i].RoleId" />
                                <input type="hidden" asp-for="@Model[i].RoleName" />

                                <label class="form-check-label font-weight-bold text-dark ml-2">
                                    @Model[i].RoleName
                                </label>
                            </div>

                            <div class="custom-control custom-switch custom-switch-md">
                                <input type="checkbox" asp-for="@Model[i].Selected" class="custom-control-input">
                                <label class="custom-control-label" asp-for="@Model[i].Selected"></label>
                            </div>
                        </div>
                    }
                </div>

                <div asp-validation-summary="All" class="text-danger small"></div>
            </div>
            <div class="card-footer bg-white border-0 d-flex justify-content-between py-4">
                <a asp-action="UserRoles" class="btn btn-light rounded-pill px-4">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary rounded-pill px-5 shadow">Lưu thay đổi</button>
            </div>
        </div>
    </form>
</div>

<style>
    .custom-switch-md .custom-control-label::before {
        height: 1.5rem;
        width: 2.5rem;
        border-radius: 1rem;
    }

    .custom-switch-md .custom-control-label::after {
        width: calc(1.5rem - 4px);
        height: calc(1.5rem - 4px);
        border-radius: 1rem;
    }

    .custom-switch-md .custom-control-input:checked ~ .custom-control-label::after {
        transform: translateX(1rem);
    }
</style>