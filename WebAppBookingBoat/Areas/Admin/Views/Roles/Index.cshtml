@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>
@{
    ViewData["Title"] = "Quản lý Quyền hạn";
}

@* Thêm phần style của bạn ở đây (giống trang nhân viên) *@
<style>
    .btn-modern {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s ease;
        margin: 0 2px;
        border: none;
    }

    .btn-view {
        background-color: #e1f5fe;
        color: #039be5;
    }

    .btn-delete {
        background-color: #ffebee;
        color: #c62828;
    }

        .btn-delete:hover {
            background-color: #c62828;
            color: #fff;
        }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-user-shield text-primary mr-2"></i>Phân quyền hệ thống
        </h1>
        <a asp-action="UserRoles" class="btn btn-info btn-sm shadow-sm rounded-pill px-3">
            <i class="fas fa-users-cog mr-1"></i> Quản lý quyền User
        </a>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body bg-light">
            <form asp-action="Create" method="post" class="form-inline">
                <div class="input-group shadow-sm mr-3">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-primary text-white border-0"><i class="fas fa-shield-alt"></i></span>
                    </div>
                    <input type="text" name="roleName" class="form-control border-0 font-weight-bold" placeholder="Nhập tên quyền..." required style="width: 300px;">
                </div>
                <button type="submit" class="btn btn-primary font-weight-bold shadow-sm">
                    <i class="fas fa-plus mr-1"></i> Tạo quyền mới
                </button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm mb-4 border-0" style="max-width: 800px;">
        <div class="card-header py-3 bg-white border-bottom">
            <h6 class="m-0 font-weight-bold text-primary text-uppercase small">
                <i class="fas fa-key mr-1"></i> Danh sách các nhóm quyền
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="roleTable">
                    <thead class="bg-light text-muted small font-weight-bold">
                        <tr>
                            <th class="border-0 pl-4">Tên quyền</th>
                            <th class="text-center border-0" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td class="pl-4 font-weight-bold text-dark">
                                    <i class="fas fa-user-tag text-info mr-2"></i> @role.Name
                                </td>
                                <td class="text-center">
                                    @if (role.Name != "Admin")
                                    {
                                        <button type="button" class="btn-modern btn-delete"
                                                onclick="deleteRoleAjax('@role.Id', '@role.Name')" title="Xóa quyền">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="btn-modern btn-view" title="Hệ thống"><i class="fas fa-check-double"></i></span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var table;
        $(document).ready(function() {
            table = $('#roleTable').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "paginate": {
                        "previous": "<i class='fas fa-angle-left'></i>",
                        "next": "<i class='fas fa-angle-right'></i>",
                        "first": "<i class='fas fa-angle-double-left'></i>",
                        "last": "<i class='fas fa-angle-double-right'></i>"
                    },
                "pageLength": 10,
                "dom": "<'row px-3 py-3'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                        "<'row'<'col-sm-12'tr>>" +
                        "<'row px-3 py-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                "columnDefs": [{ "orderable": false, "targets": 1 }]
            });
        });

        function deleteRoleAjax(id, name) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: `Bạn có chắc chắn muốn xóa quyền: ${name}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                cancelButtonColor: '#858796',
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Roles")',
                        type: 'POST',
                        data: {
                            id: id,
                            "__RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: response.message,
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    // Xóa dòng khỏi bảng mà không cần load lại trang
                                    table.row($(`button[onclick*='deleteRoleAjax("${id}")']`).parents('tr')).remove().draw();
                                });
                            } else {
                                Swal.fire('Lỗi!', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Lỗi!', 'Không thể thực hiện yêu cầu này.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}