@model IEnumerable<WebAppBookingBoat.Models.HoaDon>

@{
    ViewData["Title"] = "Quản lý Hóa đơn";
}

<style>
    /* 1. KHUNG BẢNG & TỈ LỆ CỘT */
    #dataTable {
        table-layout: fixed;
        width: 100% !important;
        border-collapse: separate;
        border-spacing: 0;
    }

    .col-id {
        width: 50px;
    }

    .col-customer {
        width: auto;
    }

    .col-date {
        width: 120px;
    }

    .col-amount {
        width: 130px;
    }

    .col-method {
        width: 110px;
    }

    .col-status {
        width: 130px;
    }

    .col-action {
        width: 130px;
    }

    /* 2. STYLE NỘI DUNG */
    .text-main-bold {
        display: block;
        font-weight: 700;
        color: #2c3e50;
        line-height: 1.3;
        font-size: 0.95rem;
    }

    /* 3. NÚT THAO TÁC (SOFT UI) */
    .btn-modern {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s ease;
        margin: 0 2px;
        text-decoration: none !important;
    }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .btn-view {
        background-color: #e1f5fe;
        color: #039be5;
    }

    .btn-edit {
        background-color: #fff8e1;
        color: #f57f17;
    }

    .btn-delete {
        background-color: #ffebee;
        color: #c62828;
    }

    .btn-view:hover {
        background-color: #039be5;
        color: #fff;
    }

    .btn-edit:hover {
        background-color: #f57f17;
        color: #fff;
    }

    .btn-delete:hover {
        background-color: #c62828;
        color: #fff;
    }

    .badge-status {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    /* Đổi tên hoặc thêm style cho nút Hủy */
    .btn-cancel {
        background-color: #fff5f5;
        color: #e74a3b;
    }

        .btn-cancel:hover {
            background-color: #e74a3b;
            color: #fff;
        }

    /* Tiền tệ */
    .amount-total {
        color: #1cc88a;
        font-weight: 800;
        font-size: 1rem;
    }

    .amount-discount {
        color: #e74a3b;
        font-size: 0.8rem;
    }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fa-solid fa-file-invoice-dollar text-primary mr-2"></i>Quản lý Hóa đơn
        </h1>
    </div>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary btn-icon-split shadow-sm border-0">
            <span class="icon text-white-50"><i class="fas fa-plus"></i></span>
            <span class="text font-weight-bold">Lập hóa đơn mới</span>
        </a>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header py-3 bg-white border-bottom">
            <h6 class="m-0 font-weight-bold text-primary text-uppercase small">
                <i class="fas fa-list mr-1"></i> Danh sách chứng từ thanh toán
            </h6>
        </div>

        <div class="card-body p-0">
            <div class="px-3 pt-3">
                <div class="card shadow-sm border-0" style="background-color: #f8f9fc;">
                    <div class="card-body py-2">
                        <div class="d-flex align-items-center flex-wrap">
                            <div class="input-group input-group-sm shadow-sm mr-2" style="width: 200px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-info text-white border-0"><i class="fas fa-filter"></i></span>
                                </div>
                                <select id="statusFilter" class="form-control border-0 font-weight-bold text-info">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="Đã thanh toán">Đã thanh toán</option>
                                    <option value="Chưa thanh toán">Chưa thanh toán</option>
                                    <option value="Đã hủy">Đã hủy</option>
                                </select>
                            </div>

                            <div class="input-group input-group-sm shadow-sm mr-2" style="width: 220px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-primary text-white border-0"><i class="fas fa-calendar-alt"></i></span>
                                </div>
                                <input type="date" id="dateFilter" class="form-control border-0 font-weight-bold text-primary">
                            </div>

                            <button id="btnResetFilter" class="btn btn-sm btn-outline-secondary border-0 rounded-circle shadow-sm bg-white" title="Làm mới">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive mt-2">
                <table class="table table-hover align-middle mb-0" id="dataTable">
                    <thead class="bg-light text-muted small font-weight-bold">
                        <tr>
                            <th class="text-center col-id border-0">ID</th>
                            <th class="col-customer border-0">Khách hàng / Nhân viên</th>
                            <th class="col-date border-0">Ngày lập</th>
                            <th class="text-right col-amount border-0">Tổng tiền</th>
                            <th class="text-center col-method border-0">HTTT</th>
                            <th class="text-center col-status border-0">Trạng thái</th>
                            <th class="text-center col-action border-0">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center font-weight-bold text-gray-500 small align-middle">
                                    #@item.MaHoaDon
                                </td>
                                <td class="align-middle">
                                    <span class="text-main-bold">
                                        <i class="fa-solid fa-user text-gray-400 mr-1"></i>
                                        @(item.KhachHang?.HoTen ?? "Khách vãng lai")
                                    </span>

                                    <small class="text-muted d-block mt-1">
                                        <i class="fa-solid fa-clipboard-user mr-1 text-primary"></i>
                                        NV: <span class="@(item.NhanVien == null ? "text-danger font-italic" : "font-weight-bold text-dark")">
                                            @(item.NhanVien?.HoTen ?? "Khách đặt online")
                                        </span>
                                    </small>
                                </td>
                                <td class="align-middle">
                                    <div class="small font-weight-bold text-dark">
                                        <i class="fa-regular fa-calendar-check mr-1 text-primary"></i>@item.NgayLap.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@item.NgayLap.ToString("HH:mm")</div>
                                </td>
                                <td class="text-right align-middle">
                                    <div class="amount-total">@item.TongTien.ToString("N0")đ</div>
                                    @if (item.SoTienGiam > 0)
                                    {
                                        <div class="amount-discount">-@item.SoTienGiam.ToString("N0")đ</div>
                                    }
                                    <small class="text-muted" style="font-size: 0.7rem;">SL: @item.SoLuongVe vé</small>
                                </td>

                                <td class="text-center align-middle">
                                    @if (item.TrangThai == "Chưa thanh toán")
                                    {
                                        <span class="badge badge-light border text-muted small italic">
                                            <i class="fa-solid fa-clock-rotate-left mr-1"></i> Chờ xác nhận
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light border shadow-sm small">
                                            <i class="fa-solid fa-wallet mr-1 text-secondary"></i> @item.PhuongThucTT
                                        </span>
                                    }
                                </td>

                                <td class="text-center align-middle" data-search="@item.TrangThai">
                                    @{
                                        var (sClass, sIcon) = item.TrangThai switch
                                        {
                                            "Đã thanh toán" => ("badge-success", "fa-solid fa-circle-check"),
                                            "Chưa thanh toán" => ("badge-warning", "fa-solid fa-hourglass-half"),
                                            "Đã hủy" => ("badge-danger", "fa-solid fa-ban"),
                                            _ => ("badge-secondary", "fa-solid fa-file-invoice")
                                        };
                                    }

                                    @if (item.TrangThai == "Chưa thanh toán")
                                    {
                                        <button type="button" class="badge badge-status shadow-sm @sClass border-0"
                                                onclick="updateStatus(@item.MaHoaDon, 'Đã thanh toán')" title="Click để xác nhận thanh toán">
                                            <i class="@sIcon mr-1"></i> @item.TrangThai
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status shadow-sm @sClass d-inline-flex align-items-center">
                                            <i class="@sIcon mr-1"></i> @item.TrangThai
                                        </span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <div class="d-flex justify-content-center">
                                        <a asp-action="Details" asp-route-id="@item.MaHoaDon" class="btn-modern btn-view" title="Xem chi tiết">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <button type="button" class="btn-modern btn-cancel"
                                                onclick="cancelHoaDon(@item.MaHoaDon)" title="Hủy hóa đơn">
                                            <i class="fa-solid fa-rectangle-xmark"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var table;
        $(document).ready(function() {
            table = $('#dataTable').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json",
                    "search": "Tìm kiếm:",
                    "searchPlaceholder": "Mã HD, tên khách...",
                    "paginate": {
                        "previous": "<i class='fas fa-angle-left'></i>",
                        "next": "<i class='fas fa-angle-right'></i>",
                        "first": "<i class='fas fa-angle-double-left'></i>",
                        "last": "<i class='fas fa-angle-double-right'></i>"
                    }
                },
                "pageLength": 10,
                "order": [[0, "desc"]],
                "columnDefs": [ { "orderable": false, "targets": [6] } ],
                 "dom": "<'row px-3 py-3'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                       "<'row'<'col-sm-12'tr>>" +
                       "<'row px-3 py-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                "drawCallback": function() {
                    $('.dataTables_paginate > .pagination').addClass('pagination-sm');
                }
            });

            $('#statusFilter').on('change', function() {
                var val = $(this).val();
                table.column(5).search(val ? '^' + val + '$' : '', true, false).draw();
            });

            $('#btnResetFilter').on('click', function() {
                $('#statusFilter').val('');
                table.search('').column(5).search('').draw();
            });

                    // 1. Lọc theo Trạng thái (Cột index 5)
        $('#statusFilter').on('change', function() {
            var val = $(this).val();
                if (val) {
            table.column(5).search('^' + val + '$', true, false).draw();
        } else {
            table.column(5).search('').draw();
        }
        });

        // 2. Lọc theo Ngày tháng (Cột index 2)
        $('#dateFilter').on('change', function() {
            var dateVal = $(this).val(); // Trả về yyyy-mm-dd

            if (!dateVal) {
                table.column(2).search('').draw();
                return;
            }

            // Cắt chuỗi để chuyển về dd/MM/yyyy
            var parts = dateVal.split('-');
            var formattedDate = parts[2] + '/' + parts[1] + '/' + parts[0];

            // Lọc cột số 2
            table.column(2).search(formattedDate).draw();
        });

        // 3. Nút Reset
        $('#btnResetFilter').on('click', function() {
            $('#statusFilter').val('');
            $('#dateFilter').val('');
            table.search('').columns().search('').draw();
        });
        });

                function changePaymentMethod(id, newMethod) {
            $.post('@Url.Action("UpdatePaymentMethod", "HoaDons")', {
                id: id,
                method: newMethod,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function(response) {
                if (response.success) {
                    // Cập nhật text hiển thị ngay lập tức trên nút mà không cần reload
                    $(`#method-text-${id}`).text(newMethod);

                    // Thông báo nhỏ ở góc màn hình (Toast) thay vì hiện Popup to
                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 2000,
                        timerProgressBar: true
                    });
                    Toast.fire({
                        icon: 'success',
                        title: response.message
                    });
                } else {
                    Swal.fire('Lỗi!', response.message, 'error');
                }
            });
        }

                        function updateStatus(id, newStatus) {
            if (newStatus === 'Đã thanh toán') {
                Swal.fire({
                    title: 'Xác nhận thanh toán',
                    html: `
                        <div class="text-left mb-3">Hóa đơn: <b>#${id}</b></div>
                        <div class="form-group text-left">
                            <label class="font-weight-bold">Chọn phương thức thanh toán:</label>
                            <select id="swal-payment-method" class="form-control">
                                <option value="Tiền mặt">Tiền mặt</option>
                                <option value="Chuyển khoản">Chuyển khoản</option>
                                <option value="Ví điện tử">Ví điện tử</option>
                                <option value="Thẻ">Thẻ (POS)</option>
                            </select>
                        </div>
                    `,
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonColor: '#1cc88a',
                    cancelButtonColor: '#858796',
                    confirmButtonText: 'Xác nhận & Cập nhật',
                    cancelButtonText: 'Hủy',
                    preConfirm: () => {
                        return document.getElementById('swal-payment-method').value;
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Gửi cả Trạng thái mới và Phương thức đã chọn lên Server
                        sendUpdate(id, newStatus, result.value);
                    }
                });
            }
        }

        function sendUpdate(id, status, method) {
            $.post('@Url.Action("UpdatePayment", "HoaDons")', { // Đổi tên Action cho khớp
                id: id,
                status: status,
                method: method,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function(response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: response.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire('Lỗi!', response.message, 'error');
                }
            });
        }

                function cancelHoaDon(id) {
            Swal.fire({
                title: 'Xác nhận hủy hóa đơn?',
                text: `Hóa đơn #${id} sẽ chuyển sang trạng thái "Đã hủy" và giải phóng các vé liên quan.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                cancelButtonColor: '#858796',
                confirmButtonText: 'Đồng ý hủy',
                cancelButtonText: 'Quay lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Gọi AJAX đến UpdatePayment với status là 'Đã hủy'
                    $.post('@Url.Action("UpdatePayment", "HoaDons")', {
                        id: id,
                        status: 'Đã hủy',
                        method: 'N/A', // Hoặc giữ nguyên phương thức cũ
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    }, function(response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Đã hủy hóa đơn',
                                text: response.message,
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                    table.row($(`button[onclick*='cancelHoaDon(${id})']`).parents('tr')).remove().draw();
                                });
                        } else {
                            Swal.fire('Lỗi!', response.message, 'error');
                        }
                    });
                }
            });
        }
    </script>
}