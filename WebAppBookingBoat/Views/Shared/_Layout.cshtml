@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager


<style>
	/* Bo góc và màu nền nhạt cho các icon contact */
	.contact-icon-circle {
		width: 45px;
		height: 45px;
		border-radius: 12px; /* Bo góc hiện đại kiểu iOS/Android */
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.1rem;
		transition: 0.3s;
	}

	/* Các màu nền nhẹ cho Icon */
	.bg-light-primary {
		background-color: rgba(78, 115, 223, 0.1);
	}

	.bg-light-success {
		background-color: rgba(28, 200, 138, 0.1);
	}

	.bg-light-info {
		background-color: rgba(54, 185, 204, 0.1);
	}

	.contact-box:hover .contact-icon-circle {
		transform: translateY(-3px);
		box-shadow: 0 4px 8px rgba(0,0,0,0.1);
	}

	.contact-text strong {
		font-size: 0.9rem;
		letter-spacing: 0.5px;
	}

	.contact-text small {
		font-size: 0.75rem;
	}

	/* Sticky Header mượt mà */
	.header-main {
		z-index: 1000;
		transition: all 0.3s;
	}

	.social-links a {
		transition: 0.3s;
		opacity: 0.8;
	}

		.social-links a:hover {
			opacity: 1;
			transform: scale(1.2);
		}

	/* Responsive cho Logo */
	@@media (max-width: 992px) {
		.header-main {
			padding: 10px 0;
		}
	}

</style>

<!DOCTYPE html>
<html lang="en">

<head>
	<title>WaterBoat &mdash; Website Template by Colorlib</title>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

	<link href="https://fonts.googleapis.com/css?family=Oswald:400,700|Dancing+Script:400,700|Muli:300,400" rel="stylesheet">
	<link rel="stylesheet" href="~/fonts/icomoon/style.css">

	<link rel="stylesheet" href="~/css/bootstrap.min.css">
	<link rel="stylesheet" href="~/css/jquery-ui.css">
	<link rel="stylesheet" href="~/css/owl.carousel.min.css">
	<link rel="stylesheet" href="~/css/owl.theme.default.min.css">
	<link rel="stylesheet" href="~/css/owl.theme.default.min.css">

	<link rel="stylesheet" href="~/css/jquery.fancybox.min.css">

	<link rel="stylesheet" href="~/css/bootstrap-datepicker.css">

	<link rel="stylesheet" href="~/fonts/flaticon/font/flaticon.css">

	<link rel="stylesheet" href="~/css/aos.css">
	<link href="css/jquery.mb.YTPlayer.min.css" media="all" rel="stylesheet" type="text/css">

	<link rel="stylesheet" href="~/css/style.css">

	<!-- Custom fonts for this template-->
	<link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
	<link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
		  rel="stylesheet">

	<!-- Custom styles for this template-->
	<link href="~/css/sb-admin-2.min.css" rel="stylesheet">


	@* --- CSS "ĐỘ" CHUYÊN NGHIỆP --- *@
	<style>
		/* --- 1. TỔNG THỂ & TIỆN ÍCH --- */
		.small-caps {
			font-variant: small-caps;
			letter-spacing: 0.5px;
		}

		.hover-lift {
			transition: all 0.3s ease;
		}

			.hover-lift:hover {
				transform: translateY(-3px);
				box-shadow: 0 5px 15px rgba(78, 115, 223, 0.3);
			}

		/* --- 2. TOP BAR & CONTACT BOX --- */
		.hover-primary:hover {
			color: #4e73df !important;
			transition: 0.3s;
		}

		.contact-icon-circle {
			width: 45px;
			height: 45px;
			border-radius: 12px;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
		}

		.contact-box:hover .contact-icon-circle {
			transform: scale(1.1) rotate(10deg);
			box-shadow: 0 5px 15px rgba(0,0,0,0.08);
		}

		.bg-light-primary {
			background: #f0f3ff;
		}

		.bg-light-success {
			background: #e8fff3;
		}

		.bg-light-info {
			background: #e2faff;
		}

		/* --- 3. NAVIGATION MENU --- */
		.main-nav-wrapper {
			border-bottom: 2px solid #f8f9fc;
			z-index: 1000;
		}

		.nav-menu li a {
			display: block;
			padding: 20px 25px;
			color: #4e73df;
			font-weight: 700;
			text-transform: uppercase;
			font-size: 0.85rem;
			letter-spacing: 1px;
			position: relative;
			text-decoration: none;
			transition: 0.3s;
		}

			.nav-menu li a::after {
				content: '';
				position: absolute;
				width: 0;
				height: 3px;
				bottom: 0;
				left: 50%;
				background: #4e73df;
				transition: 0.3s ease;
				transform: translateX(-50%);
			}

		.nav-menu li:hover a {
			color: #224abe;
		}

			.nav-menu li:hover a::after, .nav-menu li.active a::after {
				width: 60%;
			}

		.nav-menu li.active a {
			color: #224abe;
		}

		.sticky-top.shadow-sm {
			box-shadow: 0 10px 30px rgba(0,0,0,0.05) !important;
		}

		/* --- 4. AUTH UI & DROPDOWN (FIX LỖI) --- */
		.auth-dropdown {
			position: relative; /* Neo giữ dropdown không bị trôi */
		}

		.avatar-wrapper {
			transition: transform 0.3s ease;
		}

		.auth-dropdown:hover .avatar-wrapper {
			transform: scale(1.05);
		}

		/* Hiệu ứng Dropdown mượt mà */
		.auth-dropdown .dropdown-menu {
			display: block;
			visibility: hidden;
			opacity: 0;
			top: 100% !important; /* Luôn nằm dưới Avatar */
			right: 0 !important; /* Căn lề phải */
			left: auto !important;
			transform: translateY(15px);
			transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
			pointer-events: none;
			z-index: 9999;
			min-width: 220px;
		}

			/* Hiện Dropdown khi hover hoặc class .show (click) */
			.auth-dropdown:hover .dropdown-menu,
			.auth-dropdown .dropdown-menu.show {
				visibility: visible;
				opacity: 1;
				transform: translateY(0);
				pointer-events: auto;
			}

		/* Items bên trong Dropdown */
		.dropdown-item {
			padding: 0.75rem 1.5rem;
			font-size: 0.9rem;
			color: #5a5c69;
			transition: all 0.2s;
			border-bottom: 1px solid #f8f9fc;
		}

			.dropdown-item:last-child {
				border-bottom: none;
			}

			.dropdown-item:hover {
				background-color: #f8f9fc;
				color: #4e73df;
				padding-left: 1.8rem; /* Hiệu ứng đẩy nhẹ sang phải */
			}

		.dropdown-header {
			background: #4e73df;
			color: white;
			font-weight: bold;
			padding: 15px;
		}

		/* Mobile Toggle */
		.site-menu-toggle {
			text-decoration: none !important;
			color: #4e73df !important;
		}
	</style>

</head>

<body data-spy="scroll" data-target=".site-navbar-target" data-offset="300">

	<div class="site-wrap">
		@* --- TOP BAR: Sang trọng & Tinh gọn --- *@
		<div class="top-bar py-2 bg-dark d-none d-lg-block">
			<div class="container-fluid px-lg-5">
				<div class="row align-items-center">
					<div class="col-md-6">
						<small class="text-white-50">
							<i class="fa fa-clock mr-2 text-primary"></i>Giờ làm việc: <span class="text-white font-weight-bold">06:00 - 21:00</span> (Thứ 2 - CN)
						</small>
					</div>
					<div class="col-md-6 text-right">
						<div class="top-social">
							<span class="text-white-50 small mr-3">Kết nối:</span>
							<a href="#" class="text-white-50 mx-2 small hover-primary"><i class="fab fa-facebook-f"></i></a>
							<a href="#" class="text-white-50 mx-2 small hover-primary"><i class="fab fa-youtube"></i></a>
							<a href="#" class="text-white-50 mx-2 small hover-primary"><i class="fab fa-instagram"></i></a>
						</div>
					</div>
				</div>
			</div>
		</div>

		@* --- HEADER MAIN: Logo & Contact --- *@
		<div class="header-main bg-white py-3 border-bottom shadow-sm">
			<div class="container-fluid px-lg-5">
				<div class="row align-items-center">
					@* LOGO *@
					<div class="col-6 col-lg-2">
						<a asp-controller="Home" asp-action="Index" class="navbar-brand">
							<img src="~/images/logo.png" alt="Water Boat" class="img-fluid" style="max-height: 75px;">
						</a>
					</div>

					@* QUICK CONTACT *@
					<div class="col-lg-7 d-none d-lg-block">
						<div class="d-flex justify-content-center">
							<div class="contact-box d-flex align-items-center mx-4">
								<div class="contact-icon-circle bg-light-primary text-primary mr-3">
									<i class="fa fa-map-marker-alt"></i>
								</div>
								<div class="contact-text">
									<strong class="d-block text-dark small-caps">Bến tàu Rạch Giá</strong>
									<small class="text-muted">Nguyễn Công Trứ, Kiên Giang</small>
								</div>
							</div>

							<div class="contact-box d-flex align-items-center mx-4 border-left border-right px-4">
								<div class="contact-icon-circle bg-light-success text-success mr-3">
									<i class="fa fa-phone-alt"></i>
								</div>
								<div class="contact-text">
									<strong class="d-block text-dark small-caps">038 674 7090</strong>
									<small class="text-muted">Hotline 24/7</small>
								</div>
							</div>

							<div class="contact-box d-flex align-items-center mx-4">
								<div class="contact-icon-circle bg-light-info text-info mr-3">
									<i class="fa fa-envelope-open"></i>
								</div>
								<div class="contact-text">
									<strong class="d-block text-dark small-caps">booking@waterboat.vn</strong>
									<small class="text-muted">Phản hồi nhanh</small>
								</div>
							</div>
						</div>
					</div>

					@* AUTH UI *@
					<div class="col-6 col-lg-3 text-right">
						<div class="d-flex justify-content-end align-items-center">
							<ul class="navbar-nav d-flex flex-row align-items-center mb-0" style="list-style: none; gap: 15px;">
								@if (SignInManager.IsSignedIn(User))
								{
									<li class="nav-item dropdown no-arrow auth-dropdown position-relative">
										@* Thêm position-relative ở đây *@
										<a class="nav-link dropdown-toggle p-0 d-flex align-items-center" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
											<div class="text-right mr-3 d-none d-lg-block">
												<span class="d-block text-dark font-weight-bold" style="font-size: 0.8rem; line-height: 1.2;">Xin chào,</span>
												<small class="text-primary font-weight-bold">@UserManager.GetUserName(User)</small>
											</div>
											<div class="avatar-wrapper">
												<img class="img-profile rounded-circle border border-primary shadow-sm" src="~/images/avt.jpg" width="45" height="45" style="object-fit: cover; padding: 2px; background: #fff;">
											</div>
										</a>

										@* Sửa lại menu: thêm right-0 để nó không bị tràn sang phải *@
										<div class="dropdown-menu dropdown-menu-right shadow-lg border-0 mt-2 py-0"
											 aria-labelledby="userDropdown"
											 style="position: absolute; right: 0; min-width: 220px; z-index: 9999;">

											<div class="dropdown-header bg-primary text-white p-3 rounded-top d-flex align-items-center">
												<i class="fas fa-user-circle fa-2x mr-2"></i>
												<div class="text-left">
													<h6 class="mb-0 text-white font-weight-bold">TÀI KHOẢN</h6>
													<small class="text-white-50">@UserManager.GetUserName(User)</small>
												</div>
											</div>

											<div class="bg-white rounded-bottom overflow-hidden">
												<a class="dropdown-item py-3 border-bottom" asp-controller="Account" asp-action="Profile">
													<i class="fas fa-user-cog fa-sm fa-fw mr-3 text-gray-400"></i> Hồ sơ của tôi
												</a>

												@if (User.IsInRole("Admin") || User.IsInRole("Staff"))
												{
													<a class="dropdown-item py-3 border-bottom text-primary font-weight-bold" asp-area="Admin" asp-controller="Dashboards" asp-action="Index">
														<i class="fas fa-user-shield fa-sm fa-fw mr-3"></i> Quản trị hệ thống
													</a>
												}

												<a class="dropdown-item py-3 text-danger font-weight-bold" href="#" data-toggle="modal" data-target="#logoutModal">
													<i class="fas fa-sign-out-alt fa-sm fa-fw mr-3"></i> Đăng xuất
												</a>
											</div>
										</div>
									</li>
								}
								else
								{
									<li class="nav-item">
										<a class="btn btn-link text-primary font-weight-bold text-decoration-none px-3 hover-lift" asp-controller="Account" asp-action="Login">Đăng nhập</a>
									</li>
									<li class="nav-item">
										<a class="btn btn-primary rounded-pill px-4 shadow-sm font-weight-bold hover-lift" asp-controller="Account" asp-action="Register">Đăng ký</a>
									</li>
								}
							</ul>

							@* Nút Menu Mobile *@
							<div class="d-block d-lg-none ml-3">
								<a href="#" class="site-menu-toggle js-menu-toggle text-black">
									<span class="icon-menu h3"></span>
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		@* --- MAIN NAVIGATION: Thanh Menu tập trung --- *@
		<nav class="main-nav-wrapper bg-white shadow-sm sticky-top d-none d-lg-block">
			<div class="container">
				<div class="d-flex justify-content-center">
					<ul class="nav-menu d-flex list-unstyled mb-0">
						<li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
							<a asp-controller="Home" asp-action="Index">Trang chủ</a>
						</li>
						<li><a asp-controller="Home" asp-action="About">Giới thiệu</a></li>
						<li><a asp-controller="Home" asp-action="Service">Dịch vụ</a></li>
						<li><a asp-controller="DanhGia" asp-action="Index">Phản hồi</a></li>
						<li><a asp-controller="KhuyenMai" asp-action="Index">Khuyến mãi</a></li>
						<li><a asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
					</ul>
				</div>
			</div>
		</nav>
	</div>

	


	@RenderBody();

	<!-- Logout Modal-->
	<div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="exampleModalLabel">Bạn muốn rời đi?</h5>
					<button class="close" type="button" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">×</span>
					</button>
				</div>
				<div class="modal-body">Chọn "Đăng xuất" bên dưới nếu bạn đã sẵn sàng kết thúc phiên làm việc hiện tại.</div>
				<div class="modal-footer">
					<button class="btn btn-secondary" type="button" data-dismiss="modal">Hủy</button>

					@* Quan trọng: Dùng form POST để gửi yêu cầu đăng xuất *@
					<form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
						<button type="submit" class="btn btn-primary">Đăng xuất</button>
					</form>
				</div>
			</div>
		</div>
	</div>

	@* FOOTER *@
	<footer class="footer bg-white pt-5 pb-3 border-top">
		<div class="container">
			<div class="row g-4">
				@* Cột 1: Giới thiệu *@
				<div class="col-lg-4">
					<h3 class="footer-heading text-uppercase text-primary mb-4 font-weight-bold">Water Boat</h3>
					<p class="text-muted">Hệ thống đặt vé tàu cao tốc hàng đầu tại Kiên Giang. Chúng tôi cam kết mang lại hành trình an toàn, nhanh chóng và trải nghiệm tuyệt vời nhất trên mỗi chuyến đi.</p>
					<div class="d-flex pt-2">
						<a class="btn btn-outline-primary btn-social mr-2" href="#"><i class="fab fa-facebook-f"></i></a>
						<a class="btn btn-outline-primary btn-social mr-2" href="#"><i class="fab fa-youtube"></i></a>
						<a class="btn btn-outline-primary btn-social" href="#"><i class="fab fa-instagram"></i></a>
					</div>
				</div>

				@* Cột 2: Liên kết nhanh *@
				<div class="col-lg-2 col-md-6">
					<h5 class="text-dark mb-4 fw-bold">Liên kết</h5>
					<ul class="list-unstyled footer-links">
						<li><a asp-controller="Home" asp-action="About">Về chúng tôi</a></li>
						<li><a asp-controller="Home" asp-action="Service">Dịch vụ</a></li>
						<li><a asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
						<li><a href="#">Điều khoản</a></li>
					</ul>
				</div>

				@* Cột 3: Tuyến tàu phổ biến *@
				<div class="col-lg-3 col-md-6">
					<h5 class="text-dark mb-4 fw-bold">Tuyến phổ biến</h5>
					<ul class="list-unstyled footer-links">
						<li><a href="#"><i class="fa fa-caret-right mr-2 text-primary"></i>Rạch Giá - Phú Quốc</a></li>
						<li><a href="#"><i class="fa fa-caret-right mr-2 text-primary"></i>Rạch Giá - Nam Du</a></li>
						<li><a href="#"><i class="fa fa-caret-right mr-2 text-primary"></i>Hà Tiên - Phú Quốc</a></li>
						<li><a href="#"><i class="fa fa-caret-right mr-2 text-primary"></i>Rạch Giá - Hòn Sơn</a></li>
					</ul>
				</div>

				@* Cột 4: Thông tin liên hệ *@
				<div class="col-lg-3">
					<h5 class="text-dark mb-4 fw-bold">Thông tin liên hệ</h5>
					<div class="contact-info">
						<p class="mb-2"><i class="fa fa-map-marker-alt mr-3 text-primary"></i>Bến tàu Rạch Giá, Kiên Giang</p>
						<p class="mb-2"><i class="fa fa-phone-alt mr-3 text-primary"></i>038 674 7090</p>
						<p class="mb-2"><i class="fa fa-envelope mr-3 text-primary"></i>support@waterboat.vn</p>
					</div>
					<div class="mt-4 pt-2">
						<p class="small text-muted mb-2">Đối tác thanh toán:</p>
						<img src="~/images/vnpay-logo.jpg" alt="VNPay" class="img-fluid shadow-sm border p-1 rounded bg-white" style="width: 50px;">
						<img src="~/images/momo-logo.png" alt="Momo" class="img-fluid shadow-sm border p-1 rounded bg-white ml-2" style="width: 30px;">
					</div>
				</div>
			</div>

			<hr class="my-4" style="opacity: 0.1;">

			<div class="row align-items-center">
				<div class="col-md-6 text-center text-md-left">
					<p class="mb-0 text-muted small">
						&copy; <script>document.write(new Date().getFullYear());</script> <span class="fw-bold text-primary">Water Boat</span>. Thiết kế bởi <span class="text-dark">Huy Mai</span>.
					</p>
				</div>
				<div class="col-md-6 text-center text-md-right">
					<div class="footer-bottom-menu">
						<a href="#">Trang chủ</a>
						<a href="#">Chính sách</a>
						<a href="#">Trợ giúp</a>
					</div>
				</div>
			</div>
		</div>
	</footer>

