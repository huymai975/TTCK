@model WebAppBookingBoat.Models.ViewModels.KhuyenMaiViewModel

@{
    ViewData["Title"] = Model.TenChuongTrinh;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #ffffff;
    }

    .details-wrapper {
        padding-top: 160px;
        min-height: 100vh;
    }

    /* Nâng cấp Breadcrumb */
    .breadcrumb-item a {
        color: #6a737d;
        font-weight: 600;
        transition: 0.3s;
    }

        .breadcrumb-item a:hover {
            color: #007bff;
        }

    /* Banner Image */
    .promo-banner-wrapper {
        position: relative;
        border-radius: 32px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
    }

    .promo-banner-detail {
        width: 100%;
        height: 550px;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    /* Card thông tin bên phải */
    .promo-info-card {
        border: none;
        border-radius: 32px;
        background: #fff;
        padding: 40px !important;
        box-shadow: 0 30px 70px rgba(0,0,0,0.05);
        height: 100%;
    }

    .premium-badge {
        background: #fff0f0;
        color: #dc3545;
        font-weight: 800;
        padding: 10px 25px;
        border-radius: 100px;
        display: inline-block;
        font-size: 0.9rem;
        letter-spacing: 1px;
    }

    .promo-title-detail {
        font-weight: 800;
        font-size: 2.5rem;
        line-height: 1.2;
        color: #1a1d23;
        letter-spacing: -1px;
    }

    .promo-description {
        color: #586069;
        font-size: 1.1rem;
        line-height: 1.8;
    }

    /* Section chứa Mã KM */
    .copy-section-premium {
        background: #f8faff;
        border: 2px dashed #007bff;
        border-radius: 24px;
        padding: 30px;
        text-align: center;
        margin: 40px 0;
        position: relative;
    }

    .promo-code-text {
        font-family: 'JetBrains Mono', monospace;
        font-size: 2.5rem;
        font-weight: 800;
        color: #007bff;
        letter-spacing: 4px;
        display: block;
        margin-top: 5px;
    }

    /* Nút quay lại */
    .btn-back-minimal {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #1a1d23;
        font-weight: 700;
        text-decoration: none;
        transition: 0.3s;
        margin-top: 20px;
    }

        .btn-back-minimal:hover {
            color: #007bff;
            transform: translateX(-5px);
        }

    .meta-info-row {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #6a737d;
        font-size: 0.95rem;
    }

        .meta-item i {
            color: #007bff;
            font-size: 1.2rem;
        }
</style>

<div class="details-wrapper pb-5">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-5">
            <ol class="breadcrumb bg-transparent p-0">
                <li class="breadcrumb-item"><a asp-action="Index">Khuyến mãi</a></li>
                <li class="breadcrumb-item active fw-bold text-dark">Chi tiết ưu đãi</li>
            </ol>
        </nav>

        <div class="row g-5">
            <div class="col-lg-7">
                <div class="promo-banner-wrapper">
                    @{
                        var imgUrl = string.IsNullOrEmpty(Model.HinhAnh) ? "/images/khuyen-mai/default-promo.jpg" : "/images/khuyen-mai/" + Model.HinhAnh;
                    }
                    <img src="@imgUrl" class="promo-banner-detail" alt="@Model.TenChuongTrinh">
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card promo-info-card shadow-sm">
                    <div class="mb-4">
                        <span class="premium-badge shadow-sm mb-4">GIẢM @Model.PhanTramGiam% TỔNG ĐƠN</span>
                        <h1 class="promo-title-detail mb-4">@Model.TenChuongTrinh</h1>

                        <div class="meta-info-row">
                            <div class="meta-item">
                                <i class="bi bi-calendar3"></i>
                                <span>Hạn dùng: <strong>@Model.NgayKetThuc.ToString("dd/MM/yyyy")</strong></span>
                            </div>
                        </div>

                        <p class="promo-description">@Model.MoTa</p>
                    </div>

                    <div class="copy-section-premium">
                        <small class="text-muted d-block text-uppercase fw-800" style="letter-spacing: 2px; font-size: 0.75rem;">Mã Ưu Đãi Của Bạn</small>
                        <span class="promo-code-text">@Model.MaKM</span>
                    </div>

                    <div class="mt-auto">
                        <a asp-action="Index" class="btn-back-minimal">
                            <i class="bi bi-arrow-left-circle-fill fs-4"></i>
                            Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>