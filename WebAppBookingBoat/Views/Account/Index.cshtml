@model WebAppBookingBoat.Models.ViewModels.ProfileVM

@{
    ViewData["Title"] = "Tài khoản cá nhân";
}

<style>
    .profile-card {
        border-radius: 15px;
        overflow: hidden;
        border: none;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    .profile-header {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
        padding: 20px;
    }

    .btn-save {
        border-radius: 10px;
        padding: 10px 25px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,123,255,0.3);
        }

    .form-control {
        border-radius: 8px;
        padding: 12px;
        border: 1px solid #e0e0e0;
    }

        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(0,123,255,0.15);
        }

    .input-group-text {
        background-color: #f8f9fa;
        border-radius: 8px 0 0 8px;
    }
</style>

<div class="container" style="margin-top: 100px; margin-bottom: 80px;">
    <div class="row">
        <div class="col-lg-7 mb-4">
            <div class="card profile-card">
                <div class="profile-header text-center">
                    <div class="mb-2">
                        <i class="fas fa-user-circle fa-4x"></i>
                    </div>
                    <h4 class="mb-0">@Model.HoTen</h4>
                    <p class="small mb-0 opacity-75">Thành viên từ hệ thống TTCK</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success border-0 shadow-sm mb-4">
                            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                        </div>
                    }

                    <form asp-action="UpdateInfo" method="post">
                        <input type="hidden" asp-for="MaKH" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-bold text-muted small">Tên đăng nhập</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-id-badge"></i></span>
                                    </div>
                                    <input type="text" class="form-control bg-light" asp-for="TenDangNhap" readonly />
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-bold text-muted small">Địa chỉ Email</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    </div>
                                    <input type="email" class="form-control" asp-for="Email" placeholder="example@mail.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="font-weight-bold text-muted small">Họ và tên thật</label>
                            <input asp-for="HoTen" class="form-control" placeholder="Nhập tên đầy đủ của bạn..." />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-bold text-muted small">Số điện thoại liên lạc</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                    </div>
                                    <input asp-for="Sdt" class="form-control" placeholder="09xxxxxxx" />
                                </div>
                                <span asp-validation-for="Sdt" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-bold text-muted small">Ngày tháng năm sinh</label>
                                <input asp-for="NgaySinh" type="date" class="form-control" />
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary btn-save px-5">
                                <i class="fas fa-save mr-2"></i> Cập nhật thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card profile-card mb-4">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-shield-alt mr-2"></i> Bảo mật tài khoản</h5>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success border-0 shadow-sm mb-4">
                            <i class="fas fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger border-0 shadow-sm mb-4">
                            <i class="fas fa-exclamation-circle mr-2"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-action="ChangePassword" method="post">
                        <div class="mb-3">
                            <label class="font-weight-bold text-muted small">Mật khẩu hiện tại</label>
                            <input asp-for="OldPassword" type="password" class="form-control" placeholder="••••••••" />
                            @* Bổ sung dòng này *@
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="font-weight-bold text-muted small">Mật khẩu mới</label>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Ít nhất 6 ký tự" />
                            @* Bổ sung dòng này *@
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="font-weight-bold text-muted small">Xác nhận mật khẩu mới</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                            @* Bổ sung dòng này *@
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-outline-dark btn-block btn-save">
                            <i class="fas fa-key mr-2"></i> Đổi mật khẩu ngay
                        </button>
                    </form>
                </div>
            </div>

            <div class="card profile-card bg-light border-0">
                <div class="card-body p-4 text-center">
                    <i class="fas fa-info-circle text-info mb-2" style="font-size: 2rem;"></i>
                    <p class="small text-muted mb-0">
                        Thông tin của bạn được bảo mật tuyệt đối. Chúng tôi sử dụng số điện thoại để liên hệ xác nhận chuyến đi và gửi thông báo nếu có thay đổi thời tiết.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}