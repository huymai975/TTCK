@* Nhận mã lỗi từ ViewBag *@
@{
    ViewData["Title"] = ViewBag.StatusCode ?? "Error";
    Layout = null;
    var statusCode = ViewBag.StatusCode?.ToString() ?? "Error";
    var message = ViewBag.ErrorMessage ?? "Đã xảy ra lỗi không xác định.";
}

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Lỗi @statusCode</title>

    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">
</head>

<body class="bg-light">
    <div class="container-fluid">
        <div style="margin-top: 15vh;">
            <div class="text-center">
                <div class="error mx-auto" data-text="@statusCode">@statusCode</div>

                <p class="lead text-gray-800 mb-5">@message</p>

                @if (statusCode == "403")
                {
                    <p class="text-danger mb-0">Bạn không có quyền truy cập vào khu vực này.</p>
                }
                else
                {
                    <p class="text-gray-500 mb-0">Có vẻ như bạn đã va phải một lỗi trong hệ thống...</p>
                }

                <br />
                @* Nút quay lại linh hoạt *@
                <a href="javascript:history.back()" class="btn btn-sm btn-outline-primary shadow-sm mr-2">
                    <i class="fas fa-arrow-left fa-sm"></i> Quay lại trang trước
                </a>

                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-primary shadow-sm">
                    <i class="fas fa-home fa-sm"></i> Về trang chủ
                </a>
            </div>
        </div>
    </div>

    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/js/sb-admin-2.min.js"></script>
</body>