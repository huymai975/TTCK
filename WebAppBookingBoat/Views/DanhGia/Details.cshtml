@model WebAppBookingBoat.Models.ViewModels.DanhGiaViewModel

@{
    ViewData["Title"] = "Cảm nhận của " + Model.TenKhachHang;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #ffffff;
    }

    .detail-bg {
        padding-top: 160px;
        background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
        min-height: 100vh;
    }

    /* Breadcrumb tinh tế */
    .breadcrumb-item a {
        color: #6a737d;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
    }

        .breadcrumb-item a:hover {
            color: #007bff;
        }

    /* Container chính */
    .premium-card-detail {
        border: none;
        border-radius: 40px;
        background: #fff;
        box-shadow: 0 40px 100px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    /* Khối ảnh */
    .image-frame {
        position: relative;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

        .image-frame img {
            width: 100%;
            height: 500px;
            object-fit: cover;
        }

    /* Nội dung đánh giá */
    .review-content-box {
        padding: 20px 0;
    }

    .customer-name-big {
        font-weight: 800;
        font-size: 3rem;
        letter-spacing: -1.5px;
        color: #1a1d23;
        line-height: 1.1;
    }

    .stars-large {
        color: #ffc107;
        font-size: 1.5rem;
        letter-spacing: 5px;
    }

    .route-info-pill {
        display: inline-flex;
        align-items: center;
        background: #eef6ff;
        color: #007bff;
        padding: 8px 20px;
        border-radius: 100px;
        font-weight: 700;
        font-size: 0.9rem;
        margin: 20px 0;
    }

    /* Quote Style */
    .main-quote {
        font-size: 1.4rem;
        font-style: italic;
        color: #4a5568;
        line-height: 1.8;
        padding-left: 30px;
        border-left: 5px solid #007bff;
        margin: 30px 0;
    }

    /* Admin Response - Style Chat Bubble */
    .admin-reply-card {
        background: #f0f7ff;
        border-radius: 30px;
        padding: 30px;
        margin-top: 40px;
        border: 1px solid rgba(0,123,255,0.1);
    }

    .admin-reply-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
        color: #007bff;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
    }

    /* Nút back */
    .btn-return {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 12px 30px;
        background: #1a1d23;
        color: #fff;
        border-radius: 100px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.4s;
        margin-top: 30px;
    }

        .btn-return:hover {
            background: #007bff;
            color: #fff;
            transform: translateX(-8px);
            box-shadow: 0 10px 20px rgba(0,123,255,0.2);
        }
</style>

<div class="detail-bg">
    <div class="container pb-5">
        <nav aria-label="breadcrumb" class="mb-5">
            <ol class="breadcrumb bg-white p-3 px-4 rounded-pill shadow-sm d-inline-flex">
                <li class="breadcrumb-item"><a asp-action="Index">Đánh giá</a></li>
                <li class="breadcrumb-item active fw-bold text-dark">@Model.TenKhachHang</li>
            </ol>
        </nav>

        <div class="card premium-card-detail p-4 p-md-5">
            <div class="row g-5 align-items-center">
                <div class="col-lg-5">
                    <div class="image-frame">
                        @{
                            var imgPath = string.IsNullOrEmpty(Model.HinhAnh) ? "/images/no-image-placeholder.png" : "/images/danh-gia/" + Model.HinhAnh;
                        }
                        <img src="@imgPath" alt="Customer Experience" />
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="review-content-box">
                        <div class="stars-large mb-3">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= Model.SoSao ? "bi-star-fill" : "bi-star")"></i>
                            }
                        </div>

                        <h1 class="customer-name-big">@Model.TenKhachHang</h1>

                        <div class="route-info-pill">
                            <i class="bi bi-geo-alt-fill me-2"></i> Trải nghiệm tuyến: @Model.TenTuyenDuong
                        </div>

                        <div class="main-quote">
                            "@Model.NoiDung"
                        </div>

                        <p class="text-muted small">
                            <i class="bi bi-calendar3 me-2"></i> Đã gửi vào @Model.NgayDanhGia.ToString("dd MMMM, yyyy")
                        </p>

                        @if (!string.IsNullOrEmpty(Model.PhanHoiAdmin))
                        {
                            <div class="admin-reply-card">
                                <div class="admin-reply-header">
                                    <i class="bi bi-patch-check-fill fs-5"></i>
                                    WaterBoat Official Response
                                </div>
                                <p class="mb-0 text-dark leading-relaxed">@Model.PhanHoiAdmin</p>
                            </div>
                        }

                        <a asp-action="Index" class="btn-return">
                            <i class="bi bi-arrow-left-circle-fill fs-5"></i>
                            Quay lại khám phá
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>