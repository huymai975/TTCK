@model IEnumerable<WebAppBookingBoat.Models.HoaDon>

@{
    ViewData["Title"] = "Lịch sử đặt vé";
}

<style>
    body {
        background-color: #f8f9fc;
    }

    .container.py-5 {
        margin-top: 80px;
    }

    .filter-section {
        background: white;
        border-radius: 15px;
        padding: 20px;
        border: none;
    }

    .form-control-custom {
        border-radius: 10px;
        border: 1px solid #e3e6f0;
        padding: 10px 15px;
        font-size: 0.9rem;
    }

    /* Card Order */
    .order-card {
        background: white;
        border-radius: 15px;
        border: none;
        margin-bottom: 1.5rem;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.5s ease-out;
    }

        .order-card.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .order-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }

    /* Status Badge */
    .badge-status {
        display: inline-block;
        min-width: 110px;
        padding: 8px 12px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.7rem;
        text-transform: uppercase;
    }

    .bg-status-success {
        background-color: #e6f9f1;
        color: #1cc88a;
    }

    .bg-status-warning {
        background-color: #fff9db;
        color: #f6c23e;
    }

    .bg-status-danger {
        background-color: #fff5f5;
        color: #e74a3b;
    }

    /* Button Action Optimization */
    .btn-action-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
        align-items: center;
    }

    .btn-action {
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 20px;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 130px;
        height: 42px; /* Cố định chiều cao để các nút bằng nhau */
        transition: all 0.2s;
        border: none;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Tinh chỉnh riêng cho nút Huỷ vé (để không bị lệch do nằm trong form) */
    .form-cancel {
        display: contents;
    }

    .btn-info.btn-action {
        background-color: #36b9cc;
        color: white;
    }

    .btn-warning.btn-action {
        background-color: #f6c23e;
        color: white;
    }

    .btn-outline-danger.btn-action {
        border: 2px solid #e74a3b;
        color: #e74a3b;
        background: transparent;
    }

        .btn-outline-danger.btn-action:hover {
            background: #e74a3b;
            color: white;
        }

    /* Màu cho nút In vé (xanh lá cây nhẹ hoặc xanh biển đậm tùy bạn chọn) */
    .btn-success.btn-action {
        background-color: #1cc88a;
        color: white;
    }

    @@media (max-width: 768px) {
        .btn-action-group {
            justify-content: center;
        }

        .btn-action {
            width: 100%;
        }

        .border-left, .border-right {
            border: none !important;
        }
    }
</style>

<div class="container py-5">
    @* Thông báo *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="fas fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold text-dark">Chuyến đi của tôi</h2>
            <p class="text-muted">Quản lý và theo dõi lịch sử đặt vé của bạn</p>
        </div>
        <i class="fas fa-ship fa-3x text-gray-200"></i>
    </div>

    @* --- KHỐI BỘ LỌC (FILTER) --- *@
    <div class="filter-section shadow-sm mb-4">
        <form method="get" asp-action="MyOrders" id="filterForm">
            <div class="row align-items-end">
                <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
                    <label class="small font-weight-bold text-uppercase text-muted">Tìm kiếm</label>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control form-control-custom" placeholder="Mã đơn hoặc tuyến đường...">
                </div>
                <div class="col-lg-2 col-md-6 mb-3 mb-lg-0">
                    <label class="small font-weight-bold text-uppercase text-muted">Trạng thái</label>
                    <select name="status" class="form-control form-control-custom">
                        <option value="">Tất cả</option>
                        <option value="Đã thanh toán" selected="@(ViewBag.Status == "Đã thanh toán")">Đã hoàn tất</option>
                        <option value="Chờ thanh toán" selected="@(ViewBag.Status == "Chờ thanh toán")">Chờ thanh toán</option>
                        <option value="Đã hủy" selected="@(ViewBag.Status == "Đã hủy")">Đã hủy</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-6 mb-3 mb-lg-0">
                    <label class="small font-weight-bold text-uppercase text-muted">Từ ngày</label>
                    <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-custom">
                </div>
                <div class="col-lg-2 col-md-6 mb-3 mb-lg-0">
                    <label class="small font-weight-bold text-uppercase text-muted">Đến ngày</label>
                    <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-custom">
                </div>
                <div class="col-lg-3 col-md-12 d-flex">
                    <button type="submit" class="btn btn-primary font-weight-bold flex-grow-1 border-radius-10 mr-2" style="border-radius:10px" id="btnFilter">
                        <i class="fas fa-filter mr-1"></i> Lọc kết quả
                    </button>
                    <a href="@Url.Action("MyOrders")" class="btn btn-outline-secondary" style="border-radius:10px" title="Xóa bộ lọc">
                        <i class="fas fa-undo"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm bg-white" style="border-radius:15px">
            <img src="https://cdn-icons-png.flaticon.com/512/4076/4076432.png" width="120" class="mb-3" style="opacity: 0.5">
            <h4 class="text-muted">Không tìm thấy chuyến đi nào</h4>
            <p class="text-secondary small">Thử thay đổi bộ lọc hoặc đặt vé mới ngay</p>
            <a href="/" class="btn btn-primary mt-2 px-4 shadow-sm" style="border-radius:10px">Đặt vé ngay</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                var danhGia = item.DanhGia;
                var veDauTien = item.Ves.FirstOrDefault();

                <div class="col-12">
                    <div class="card order-card shadow-sm">
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                @* Cột 1: Thông tin *@
                                <div class="col-md-4 mb-3 mb-md-0">
                                    <span class="text-xs font-weight-bold text-uppercase text-secondary">MÃ ĐƠN: #@item.MaHoaDon</span>
                                    <div class="route-name mt-1">
                                        <i class="fas fa-anchor mr-2 text-primary"></i>
                                        @(veDauTien?.LichTrinh?.TuyenDuong?.TenTuyen ?? "Tuyến đường không xác định")
                                    </div>
                                    <div class="text-muted small mt-2">
                                        <i class="far fa-calendar-alt mr-1"></i> @item.NgayLap.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>

                                @* Cột 2: Giá & Trạng thái *@
                                <div class="col-md-3 text-md-center mb-3 mb-md-0 border-left border-right">
                                    <div class="h5 mb-2 font-weight-bold text-dark">@item.TongTien.ToString("N0") <small>VND</small></div>

                                    @if (item.TrangThai == "Đã thanh toán")
                                    {
                                        <span class="badge badge-status bg-status-success mb-2">Đã hoàn tất</span>
                                        @if (danhGia != null)
                                        {
                                            <div class="star-rating">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="@(i <= danhGia.SoSao ? "fas" : "far") fa-star"></i>
                                                }
                                            </div>
                                        }
                                    }
                                    else if (item.TrangThai == "Chờ thanh toán")
                                    {
                                        <span class="badge badge-status bg-status-warning">Chờ thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status bg-status-danger">Đã hủy</span>
                                    }
                                </div>

                                @* Cột 3: Nút hành động *@
                                <div class="col-md-5">
                                    <div class="btn-action-group">
                                        @* 1. Nút Thanh toán (Chỉ hiện khi chưa trả tiền) *@
                                        @if (item.TrangThai == "Chờ thanh toán")
                                        {
                                            <a asp-action="Payment" asp-route-id="@item.MaHoaDon" class="btn btn-warning btn-action">
                                                <i class="fas fa-credit-card mr-2"></i>Thanh toán
                                            </a>
                                        }

                                        @* 2. Nút In vé (Chỉ hiện khi đã thanh toán) *@
                                        @if (item.TrangThai == "Đã thanh toán")
                                        {
                                            <a asp-action="ExportPdf" asp-route-id="@item.MaHoaDon" target="_blank" class="btn btn-success btn-action">
                                                <i class="fas fa-print mr-2"></i>In vé
                                            </a>
                                        }

                                        @* 3. Nút Đánh giá (Chỉ hiện khi đã thanh toán và CHƯA đánh giá) *@
                                        @if (item.TrangThai == "Đã thanh toán" && danhGia == null)
                                        {
                                            <a asp-controller="Booking" asp-action="Evaluate" asp-route-id="@item.MaHoaDon" class="btn btn-primary btn-action">
                                                <i class="fas fa-star mr-2"></i>Đánh giá
                                            </a>
                                        }

                                        @* 4. Nút Chi tiết (Luôn có) *@
                                        <a asp-action="Details" asp-route-id="@item.MaHoaDon" class="btn btn-info btn-action">
                                            <i class="fas fa-eye mr-2"></i>Chi tiết
                                        </a>

                                        @* 5. Nút Huỷ vé (Hiện khi Chờ thanh toán HOẶC Đã thanh toán) *@
                                        @if (item.TrangThai == "Chờ thanh toán" || item.TrangThai == "Đã thanh toán")
                                        {
                                            <form asp-action="CancelOrder" asp-route-id="@item.MaHoaDon" method="post" class="form-cancel">
                                                <input type="hidden" class="order-status" value="@item.TrangThai" />
                                                <button type="button" class="btn btn-outline-danger btn-action btn-cancel-confirm">
                                                    <i class="fas fa-trash-alt mr-2"></i>Huỷ vé
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* --- THANH PHÂN TRANG (PAGINATION) --- *@
        if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link shadow-sm" href="@Url.Action("MyOrders", new { page = ViewBag.CurrentPage - 1, searchTerm = ViewBag.SearchTerm, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link shadow-sm" href="@Url.Action("MyOrders", new { page = i, searchTerm = ViewBag.SearchTerm, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link shadow-sm" href="@Url.Action("MyOrders", new { page = ViewBag.CurrentPage + 1, searchTerm = ViewBag.SearchTerm, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // 1. Tự động ẩn thông báo sau 5 giây
            setTimeout(function() {
                $(".alert").fadeOut('slow');
            }, 5000);

            // 2. Hiệu ứng load card mượt mà dùng CSS Class
            $('.order-card').each(function(i) {
                setTimeout(() => {
                    $(this).addClass('visible');
                }, 100 * i);
            });

            // 3. Hiệu ứng Loading khi bấm lọc
            $('#filterForm').on('submit', function() {
                const btn = $('#btnFilter');
                btn.html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang lọc...');
                btn.prop('disabled', true);
            });

            // 4. Tooltip (nếu có dùng Bootstrap tooltip)
            $('[title]').tooltip();

                    $('.btn-cancel-confirm').on('click', function () {
            const $form = $(this).closest('.form-cancel');
            const status = $form.find('.order-status').val();

            let title = "Xác nhận huỷ vé?";
            // Mặc định luôn nhắc nhở về điều kiện 24h
            let text = "Lưu ý: Bạn chỉ có thể tự huỷ vé TRƯỚC 24 GIỜ so với giờ khởi hành.";
            let icon = "warning";

            // Nếu đã thanh toán, thêm cảnh báo hoàn tiền
            if (status === "Đã thanh toán") {
                title = "Cảnh báo hoàn tiền & Thời gian!";
                text = "1. Bạn chỉ được huỷ trước 24h khởi hành.\n2. Vì đơn đã thanh toán, bạn sẽ chỉ được hoàn lại 50% giá trị hóa đơn.\nBạn vẫn muốn tiếp tục?";
                icon = "error";
            }

            Swal.fire({
                title: title,
                text: text,
                icon: icon,
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                cancelButtonColor: '#858796',
                confirmButtonText: 'Tôi đã hiểu và muốn huỷ',
                cancelButtonText: 'Quay lại',
                customClass: {
                    popup: 'border-radius-15'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $form.submit();
                }
            });
        });
        });
    </script>
}