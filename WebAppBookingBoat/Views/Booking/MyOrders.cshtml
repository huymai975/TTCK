@model IEnumerable<WebAppBookingBoat.Models.HoaDon>

@{
    ViewData["Title"] = "Lịch sử đặt vé";
}

<style>
    body {
        background-color: #f8f9fc;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .order-card {
        background: white;
        border-radius: 15px;
        border: none;
        transition: transform 0.2s, box-shadow 0.2s;
        margin-bottom: 1.5rem;
    }

        .order-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }

    .badge-status {
        padding: 8px 12px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    /* Tùy chỉnh màu sắc Badge */
    .bg-status-success {
        background-color: #e6f9f1;
        color: #1cc88a;
    }

    .bg-status-warning {
        background-color: #fff9db;
        color: #f6c23e;
    }

    .bg-status-danger {
        background-color: #fff5f5;
        color: #e74a3b;
    }

    .route-name {
        color: #4e73df;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .btn-action {
        border-radius: 10px;
        font-weight: 600;
        padding: 8px 16px;
        transition: all 0.3s;
    }

    .order-id {
        font-family: 'Courier New', monospace;
        color: #858796;
        font-weight: bold;
    }

    .container.py-5 {
        margin-top: 80px; /* Điều chỉnh con số này (ví dụ 80px hoặc 100px) sao cho vừa mắt */
    }
</style>

<div class="container py-5">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h2 class="font-weight-bold text-dark">Chuyến đi của tôi</h2>
            <p class="text-muted">Quản lý và theo dõi lịch sử đặt vé của bạn</p>
        </div>
        <i class="fas fa-ship fa-3x text-gray-200"></i>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <img src="https://cdn-icons-png.flaticon.com/512/4076/4076432.png" width="150" class="mb-3" style="opacity: 0.5">
            <h4 class="text-muted">Bạn chưa có chuyến đi nào</h4>
            <a href="/" class="btn btn-primary mt-3">Đặt vé ngay bây giờ</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card order-card shadow-sm">
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <div class="col-md-4 mb-3 mb-md-0">
                                    <span class="order-id small">MÃ ĐƠN: #@item.MaHoaDon</span>
                                    <div class="route-name mt-1">
                                        <i class="fas fa-map-marker-alt mr-2"></i>
                                        @item.Ves.FirstOrDefault()?.LichTrinh?.TuyenDuong?.TenTuyen
                                    </div>
                                    <div class="text-muted small mt-2">
                                        <i class="far fa-calendar-alt mr-1"></i> Ngày đặt: @item.NgayLap.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>

                                <div class="col-md-3 text-md-center mb-3 mb-md-0">
                                    <div class="h5 mb-1 font-weight-bold text-dark">@item.TongTien.ToString("N0") VND</div>
                                    @if (item.TrangThai == "Đã thanh toán")
                                    {
                                        <span class="badge badge-status bg-status-success">Đã hoàn tất</span>
                                    }
                                    else if (item.TrangThai == "Chờ thanh toán")
                                    {
                                        <span class="badge badge-status bg-status-warning">Chờ thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status bg-status-danger">Đã hủy</span>
                                    }
                                </div>

                                <div class="col-md-5 text-md-right">
                                    @if (item.TrangThai == "Chờ thanh toán")
                                    {
                                        <a asp-action="Payment" asp-route-id="@item.MaHoaDon" class="btn btn-warning btn-action mr-2">
                                            <i class="fas fa-credit-card mr-1"></i> Thanh toán
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@item.MaHoaDon" class="btn btn-info btn-action mr-2">
                                            <i class="fas fa-info-circle mr-1"></i> Chi tiết
                                        </a>
                                    }

                                    @if (item.TrangThai == "Đã thanh toán")
                                    {
                                        @* Kiểm tra xem hóa đơn đã có đánh giá chưa (nếu bạn có nạp thêm dữ liệu DanhGias vào Model) *@
                                        <a asp-action="Evaluate" asp-route-id="@item.MaHoaDon" class="btn btn-outline-primary btn-action mr-2">
                                            <i class="fas fa-star mr-1"></i> Đánh giá
                                        </a>

                                        <a asp-action="ExportPdf" asp-route-id="@item.MaHoaDon" class="btn btn-outline-danger btn-action">
                                            <i class="fas fa-file-pdf mr-1"></i> Tải vé
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // Hiệu ứng Fade In cho các card khi load
        $(document).ready(function() {
            $('.order-card').each(function(i) {
                $(this).css({'opacity': '0', 'margin-top': '20px'});
                $(this).delay(100 * i).animate({'opacity': '1', 'margin-top': '0'}, 400);
            });
        });
    </script>
}