@model int

@{
    ViewData["Title"] = "Đặt vé thành công";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f4f7f6;
    }

    .success-wrapper {
        margin-top: 80px;
        padding: 80px 0;
    }

    .success-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        border: none;
    }

    /* Hiệu ứng vòng tròn lan tỏa phía sau icon */
    .icon-container {
        position: relative;
        display: inline-block;
        width: 120px;
        height: 120px;
        line-height: 120px;
        background: #e6f9f1;
        border-radius: 50%;
        margin-bottom: 30px;
    }

    .check-icon {
        font-size: 60px;
        color: #1cc88a;
        vertical-align: middle;
        animation: scaleIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .order-number {
        background: #f0f7ff;
        color: #0d6efd;
        padding: 4px 12px;
        border-radius: 8px;
        font-family: 'Courier New', Courier, monospace;
        font-weight: bold;
    }

    .btn-custom {
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-pdf {
        background-color: #ff4757;
        color: white;
        border: none;
    }

        .btn-pdf:hover {
            background-color: #e84118;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(232, 65, 24, 0.3);
        }

    .btn-home:hover {
        background-color: #f8f9fa;
        transform: translateY(-2px);
    }

    @@keyframes scaleIn {
        0% {
            transform: scale(0);
            opacity: 0;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<div class="container success-wrapper">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="card success-card p-4 p-md-5">
                <div class="card-body">
                    <div class="icon-container">
                        <i class="fas fa-check-circle check-icon"></i>
                    </div>

                    <h1 class="display-6 font-weight-bold text-dark mb-3">Thanh toán hoàn tất!</h1>

                    <p class="text-muted fs-5 mb-4">
                        Cảm ơn bạn đã đồng hành cùng <strong>WaterBoat</strong>.<br />
                        Mã đơn hàng: <span class="order-number">#@Model</span>
                    </p>

                    <div class="alert alert-light border-0 py-3 mb-5" style="background: #fff9db; border-radius: 15px;">
                        <p class="mb-0 text-dark small">
                            <i class="fas fa-info-circle text-warning mr-2"></i>
                            Hệ thống đã gửi xác nhận vào lịch sử cá nhân.
                            Bạn nên tải xuống vé PDF để làm thủ tục lên tàu nhanh hơn.
                        </p>
                    </div>

                    <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
                        <a href="/" class="btn btn-light btn-custom btn-home border mb-2 mb-md-0">
                            <i class="fas fa-home mr-2"></i>Trang chủ
                        </a>

                        <a asp-action="ExportPdf" asp-controller="Booking" asp-route-id="@Model" class="btn btn-pdf btn-custom shadow-sm">
                            <i class="fas fa-file-pdf mr-2"></i>Tải vé (PDF)
                        </a>
                    </div>
                </div>
            </div>

            <div class="mt-5">
                <p class="text-muted">Bạn gặp khó khăn? <a href="#" class="text-primary text-decoration-none font-weight-bold">Trò chuyện với chúng tôi</a></p>
            </div>
        </div>
    </div>
</div>