@model WebAppBookingBoat.Models.ViewModels.SearchViewModel

@{
    ViewData["Title"] = "Kết quả tìm kiếm chuyến tàu";
    var imagePath = "/images/tuyen-duong/";
}

<style>
    /* 1. Nâng cấp Hero Section */
    .hero-wrap {
        background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/images/hero_2.jpg');
        background-size: cover;
        background-position: center;
        padding: 100px 0 60px;
        border-radius: 0 0 50px 50px;
        margin-bottom: -50px;
    }

    /* 2. Card nâng cao */
    .modern-card {
        border: none;
        border-radius: 20px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .modern-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
        }

    /* 3. Ticket Design cho danh sách chuyến */
    .ticket-item {
        background: #fff;
        border-radius: 20px;
        display: flex;
        margin-bottom: 25px;
        position: relative;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    .ticket-img {
        width: 240px;
        min-height: 180px;
        background-size: cover;
        background-position: center;
        border-radius: 20px 0 0 20px;
        position: relative;
    }

    .status-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        padding: 5px 15px;
        border-radius: 50px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .ticket-info {
        flex: 1;
        padding: 25px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .price-tag {
        font-size: 1.5rem;
        font-weight: 800;
        color: #007bff;
        text-shadow: 1px 1px 0px rgba(0,0,0,0.02);
    }

    /* 4. Timeline (Điểm đi - Điểm đến) */
    .route-line {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 15px 0;
    }

    .dot {
        height: 10px;
        width: 10px;
        background: #007bff;
        border-radius: 50%;
    }

    .line {
        flex: 1;
        height: 2px;
        background: #dee2e6;
        border-style: dashed;
    }

    .btn-book {
        border-radius: 12px;
        padding: 10px 25px;
        font-weight: 600;
        letter-spacing: 0.5px;
        box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3);
    }

    .sidebar-detail img {
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }
</style>

<div class="hero-wrap text-center text-white">
    <div class="container" data-aos="fade-up">
        <h1 class="display-4 font-weight-bold mb-2">
            @(Model.TuyenDuong != null ? Model.TuyenDuong.TenTuyen : "Kết quả tìm kiếm")
        </h1>
        @if (Model.NgayGioKhoiHanh.HasValue)
        {
            <p class="lead"><i class="fas fa-calendar-alt mr-2"></i> Khởi hành ngày: @Model.NgayGioKhoiHanh.Value.ToString("dd MMMM, yyyy")</p>
        }
    </div>
</div>

<div class="site-section bg-light pt-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-5">
                <div class="p-4 bg-white modern-card shadow-sm sidebar-detail">
                    <h4 class="h5 text-black mb-4 font-weight-bold"><i class="fas fa-info-circle text-primary mr-2"></i>Thông tin hành trình</h4>
                    @if (Model.TuyenDuong != null)
                    {
                        <img src="@(string.IsNullOrEmpty(Model.TuyenDuong.HinhAnh) ? "/images/default.jpg" : imagePath + Model.TuyenDuong.HinhAnh)" class="img-fluid mb-4">

                        <div class="route-info">
                            <div class="d-flex align-items-center mb-3">
                                <div class="icon-wrap mr-3 text-primary"><i class="fas fa-map-marker-alt"></i></div>
                                <div>
                                    <small class="text-muted d-block">Điểm đi</small>
                                    <span class="font-weight-bold">@Model.TuyenDuong.DiemDi</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="icon-wrap mr-3 text-danger"><i class="fas fa-flag-checkered"></i></div>
                                <div>
                                    <small class="text-muted d-block">Điểm đến</small>
                                    <span class="font-weight-bold">@Model.TuyenDuong.DiemDen</span>
                                </div>
                            </div>
                            <hr>
                            <div class="row text-center">
                                <div class="col-6">
                                    <small class="text-muted d-block">Quãng đường</small>
                                    <span class="badge badge-soft-info">@Model.TuyenDuong.KhoangCach km</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Thời gian</small>
                                    <span class="badge badge-soft-primary">@Model.TuyenDuong.ThoiGianDuKien.ToString(@"hh\:mm") h</span>
                                </div>
                            </div>
                        </div>
                    }
                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="booking-section"
                       class="btn btn-outline-primary btn-block mt-4 btn-sm"
                       style="border-radius: 10px;">
                        <i class="fas fa-search-plus mr-2"></i>Tìm chuyến khác
                    </a>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="h5 text-black font-weight-bold mb-0">Chuyến tàu khả dụng (@Model.KetQuaLichTrinh.Count)</h3>
                    <div class="dropdown">
                        <button class="btn btn-white btn-sm shadow-sm dropdown-toggle" style="border-radius: 8px;">Sắp xếp theo</button>
                    </div>
                </div>

                @if (Model.KetQuaLichTrinh.Any())
                {
                    @foreach (var lt in Model.KetQuaLichTrinh)
                    {
                        <div class="ticket-item modern-card" data-aos="fade-up">
                            <div class="ticket-img" style="background-image: url('@(string.IsNullOrEmpty(lt.Tau.HinhAnh) ? "/images/default.jpg" : "/images/tau/" + lt.Tau.HinhAnh)');">
                                <span class="status-badge @(lt.TrangThai == "Sắp khởi hành" ? "bg-success text-white" : "bg-warning")">
                                    @lt.TrangThai
                                </span>
                            </div>

                            <div class="ticket-info">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h3 class="h5 font-weight-bold mb-1">Tàu: @lt.Tau.TenTau</h3>
                                        <p class="text-muted small mb-0"><i class="fas fa-ship mr-1"></i> Số hiệu: @lt.MaLichTrinh</p>
                                    </div>
                                    <div class="text-right">
                                        <span class="price-tag">@lt.GiaVeCoBan.ToString("N0")<small>đ</small></span>
                                        <small class="text-muted d-block">/người</small>
                                    </div>
                                </div>

                                <div class="route-line">
                                    <div class="text-center" style="min-width: 60px;">
                                        <span class="font-weight-bold d-block">@lt.NgayGioKhoiHanh.ToString("HH:mm")</span>
                                    </div>
                                    <div class="dot"></div>
                                    <div class="line"></div>
                                    <div class="dot" style="background: #dc3545;"></div>
                                    <div class="text-center" style="min-width: 60px;">
                                        <span class="font-weight-bold d-block">Kết thúc</span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="meta-info">
                                        <span class="badge badge-light p-2" style="border-radius: 8px;">
                                            <i class="fas fa-chair text-primary mr-1"></i> Còn @lt.SoGheTrong ghế trống
                                        </span>
                                    </div>
                                    <a asp-controller="Booking" asp-action="BookTicket" asp-route-id="@lt.MaLichTrinh" class="btn btn-primary btn-book">
                                        Đặt vé ngay <i class="fas fa-arrow-right ml-2"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center p-5 bg-white modern-card shadow-sm">
                        <img src="~/images/no-results.png" style="width: 150px; opacity: 0.5;" class="mb-4">
                        <h4 class="text-muted">Không tìm thấy chuyến tàu nào</h4>
                        <p>Bạn hãy thử thay đổi ngày hoặc điểm đi/đến khác nhé!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>