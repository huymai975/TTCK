@{
    ViewData["Title"] = "Liên hệ";
}

    <style >
    /* Hiệu ứng lớp phủ mờ cho Header */
    .page-header-inner {
        background: rgba(0, 0, 0, .5); /* Làm tối ảnh nền 50% */
        backdrop-filter: blur(2px); /* Làm mờ nhẹ ảnh nền để tạo chiều sâu */
    }

    .page-header {
        position: relative;
        overflow: hidden;
    }

    /* Làm đẹp thanh điều hướng (Breadcrumb) */
    .breadcrumb {
        background: rgba(255, 255, 255, 0.1);
        display: inline-flex;
        padding: 10px 25px;
        border-radius: 50px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "\f105"; /* Icon mũi tên FontAwesome */
        font-family: "Font Awesome 5 Free";
        font-weight: 900;
        color: rgba(255, 255, 255, 0.5);
    }

    /* Hiệu ứng chữ LIÊN HỆ */
    .display-3 {
        text-shadow: 2px 4px 10px rgba(0, 0, 0, 0.3);
        letter-spacing: 2px;
    }
</style>

<div class="container-fluid page-header mb-5 p-0" style="background-image: url('/images/contact-img.jpg'); background-size: cover; background-position: center;">
    <div class="container-fluid page-header-inner py-5">
        <div class="container text-center py-5">
            <h1 class="display-3 text-white mb-3 animated slideInDown font-weight-bold">LIÊN HỆ</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center text-uppercase shadow-sm">
                    <li class="breadcrumb-item"><a class="text-white" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item text-white-50 active" aria-current="page">Liên hệ</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h5 class="section-title ff-secondary text-center text-primary fw-normal">Kết nối với chúng tôi</h5>
            <h1 class="mb-5">Liên hệ nếu bạn có bất kỳ thắc mắc nào</h1>
        </div>
        <div class="row g-4">
            <div class="col-12 mb-5">
                @* Thêm mb-5 để cách xa phần bản đồ bên dưới *@
                <div class="row g-4">
                    @* g-4 tạo khoảng cách giữa các cột *@
                    @* Card Email *@
                    <div class="col-md-4">
                        <div class="d-flex align-items-center bg-white rounded shadow-sm p-4 border-bottom border-primary border-5 h-100">
                            <div class="btn-lg-square bg-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 55px; height: 55px;">
                                <i class="fa fa-envelope-open text-white"></i>
                            </div>
                            <div class="ms-3">
                                @* Dùng ms-3 thay vì mr-3 nếu bạn dùng Bootstrap 5 *@
                                <h5 class="mb-1">Email</h5>
                                <p class="mb-0 text-muted small">booking@waterboat.com</p>
                            </div>
                        </div>
                    </div>

                    @* Card Hotline *@
                    <div class="col-md-4">
                        <div class="d-flex align-items-center bg-white rounded shadow-sm p-4 border-bottom border-info border-5 h-100">
                            <div class="btn-lg-square bg-info rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 55px; height: 55px;">
                                <i class="fa fa-phone-alt text-white"></i>
                            </div>
                            <div class="ms-3">
                                <h5 class="mb-1">Hotline</h5>
                                <p class="mb-0 text-muted small">038 674 7090</p>
                            </div>
                        </div>
                    </div>

                    @* Card Văn phòng *@
                    <div class="col-md-4">
                        <div class="d-flex align-items-center bg-white rounded shadow-sm p-4 border-bottom border-success border-5 h-100">
                            <div class="btn-lg-square bg-success rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 55px; height: 55px;">
                                <i class="fa fa-map-marker-alt text-white"></i>
                            </div>
                            <div class="ms-3">
                                <h5 class="mb-1">Văn phòng</h5>
                                <p class="mb-0 text-muted small"> Cảng Rạch Giá, Đường Nguyễn Công Trứ - Rạch Giá - An Giang</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Bản đồ *@
            <div class="col-md-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="h-100 w-100 rounded shadow-sm overflow-hidden" style="min-height: 450px;">
                    <iframe class="w-100 h-100"
                            @* Link này chứa tham số tọa độ và iwloc=A để hiện ghim đỏ *@
                            src="https://maps.google.com/maps?q=10.0163,105.0768&hl=vi&z=16&amp;output=embed"
                            frameborder="0"
                            style="border:0;"
                            allowfullscreen=""
                            aria-hidden="false"
                            tabindex="0">
                    </iframe>
                </div>
            </div>

            @* Form liên hệ *@
            <div class="col-md-6">
                <div class="wow fadeInUp" data-wow-delay="0.2s">
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="name" placeholder="Họ và tên">
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input type="email" class="form-control" id="email" placeholder="Email của bạn">
                                </div>
                            </div>
                            <div class="col-12 mb-3">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="subject" placeholder="Tiêu đề">
                                </div>
                            </div>
                            <div class="col-12 mb-3">
                                <div class="form-floating">
                                    <textarea class="form-control" placeholder="Để lại lời nhắn tại đây" id="message" style="height: 150px"></textarea>
                                </div>
                            </div>
                            <div class="col-12">
                                <button class="btn btn-primary w-100 py-3 shadow-sm" type="button">Gửi Tin Nhắn</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .section-title {
        position: relative;
        display: inline-block;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .ff-secondary {
        font-family: 'Nunito', sans-serif;
    }

    .form-control:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
    }

    .btn-lg-square {
        transition: .5s;
    }

    .col-md-4:hover .btn-lg-square {
        transform: rotateY(180deg);
    }
</style>