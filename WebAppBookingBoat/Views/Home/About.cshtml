@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-lg-6 text-center text-lg-start">
                <h1 class="display-3 text-white animated slideInDown">Về Chúng Tôi</h1>
                <p class="text-white mb-4 animated slideInDown">Chúng tôi cung cấp giải pháp đặt vé tàu trực tuyến nhanh chóng, an toàn và tiện lợi hàng đầu Việt Nam.</p>
            </div>
            <div class="col-lg-6 text-center text-lg-end animated zoomIn">
                <img class="img-fluid rounded shadow-lg" src="~/images/about-img.jpg" alt="Về chúng tôi" style="max-height: 300px; object-fit: cover;">
            </div>
        </div>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            @* Hình ảnh minh họa bên trái *@
            <div class="col-lg-6">
                <div class="row g-3">
                    <div class="col-6 text-start">
                        <img class="img-fluid rounded w-100 shadow-sm" src="~/images/bg-about.jpg" style="margin-top: 25%;">
                    </div>
                    <div class="col-6 text-start">
                        <img class="img-fluid rounded w-75 shadow-sm" src="~/images/about1.jpg">
                    </div>
                    <div class="col-6 text-end">
                        <img class="img-fluid rounded w-75 shadow-sm" src="~/images/about2.jpg">
                    </div>
                    <div class="col-6 text-end">
                        <img class="img-fluid rounded w-100 shadow-sm" src="~/images/about3.jpg">
                    </div>
                </div>
            </div>

            @* Nội dung bên phải *@
            <div class="col-lg-6">
                <h5 class="section-title ff-secondary text-start text-primary fw-normal">Câu chuyện của chúng tôi</h5>
                <h1 class="mb-4">Chào mừng đến với <i class="fa fa-ship text-primary me-2"></i>Water Boat</h1>
                <p class="mb-4">Được thành lập với mục tiêu hiện đại hóa ngành vận tải đường thủy, Water Boat mang đến trải nghiệm đặt vé chỉ trong vài cú click chuột. Không còn cảnh xếp hàng chờ đợi, bạn có thể chủ động lịch trình của mình mọi lúc, mọi nơi.</p>

                <div class="row g-4 mb-4">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center border-start border-5 border-primary px-3">
                            <h2 class="flex-shrink-0 display-5 text-primary mb-0" data-toggle="counter-up">15</h2>
                            <div class="ps-4">
                                <p class="mb-0">Năm</p>
                                <h6 class="text-uppercase mb-0">Kinh nghiệm</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center border-start border-5 border-primary px-3">
                            <h2 class="flex-shrink-0 display-5 text-primary mb-0" data-toggle="counter-up">50</h2>
                            <div class="ps-4">
                                <p class="mb-0">Đội ngũ</p>
                                <h6 class="text-uppercase mb-0">Thuyền viên giỏi</h6>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card bg-light border-0 p-4 shadow-sm border-left-primary">
                    <p class="italic mb-0">"Sứ mệnh của chúng tôi là kết nối mọi bến bờ bằng sự tử tế và công nghệ hiện đại."</p>
                    <footer class="blockquote-footer mt-2">Mai Huy, <cite title="Source Title">CEO Water Boat</cite></footer>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-xxl pt-5 pb-3">
    <div class="container">
        <div class="text-center">
            <h5 class="section-title ff-secondary text-center text-primary fw-normal">Đội ngũ sáng lập</h5>
            <h1 class="mb-5">Những người đứng sau dự án</h1>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-lg-3 col-md-6">
                <div class="team-item text-center rounded overflow-hidden shadow">
                    <div class="rounded-circle overflow-hidden m-4 shadow-sm">
                        <img class="img-fluid" src="~/images/undraw_profile.svg" alt="">
                    </div>
                    <h5 class="mb-0">Mai Huy</h5>
                    <small>Software Developer</small>
                    <div class="d-flex justify-content-center mt-3 mb-3">
                        <a class="btn btn-square btn-primary mx-1" href="#"><i class="fab fa-facebook-f"></i></a>
                        <a class="btn btn-square btn-primary mx-1" href="#"><i class="fab fa-github"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .section-title {
        position: relative;
        display: inline-block;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .ff-secondary {
        font-family: 'Nunito', sans-serif;
    }

    .team-item {
        transition: .5s;
        background: #fff;
    }

        .team-item:hover {
            transform: translateY(-10px);
        }

    .btn-square {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .border-left-primary {
        border-left: 5px solid #4e73df !important;
    }
</style>