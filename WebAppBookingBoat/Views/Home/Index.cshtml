@model WebAppBookingBoat.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ - Water Boat";
    var defaultImg = "https://res.cloudinary.com/dzvcaq2xl/image/upload/v1/WebAppBookingBoat/default-promo.jpg";
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>

<style>
    /* 1. HERO & SEARCH GLASSMORPHISM */
    .hero-search-wrap {
        position: relative;
        margin-top: -80px;
        z-index: 100;
    }

    .glass-form {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(15px);
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.15);
        border: 1px solid rgba(255,255,255,0.3);
    }

    /* 2. ROUTE CARDS */
    .route-card {
        border-radius: 20px;
        overflow: hidden;
        border: none;
        transition: all 0.4s ease;
        background: #fff;
    }

        .route-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
        }

    .route-img-wrapper {
        position: relative;
        height: 220px;
        overflow: hidden;
    }

        .route-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.5s;
        }

    .route-card:hover .route-img-wrapper img {
        transform: scale(1.1);
    }

    .badge-time {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(78, 115, 223, 0.9);
        color: white;
        padding: 4px 12px;
        border-radius: 50px;
        font-weight: bold;
        font-size: 0.8rem;
    }

    /* 3. TESTIMONIALS */
    .testimonial-card {
        border-radius: 20px;
        border: none;
        transition: 0.3s;
    }

    .avatar-circle {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    /* 4. TABLE SCHEDULE */
    .schedule-table thead th {
        background: #4e73df;
        color: white;
        border: none;
        font-size: 0.85rem;
    }
</style>

@* --- 1. SLIDER CHÍNH --- *@
<div class="hero-slide owl-carousel site-blocks-cover">
    <div class="intro-section" style="background-image: url('https://res.cloudinary.com/dzvcaq2xl/image/upload/v1777424764/hero_1_qf0esw.jpg');">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8 ml-auto text-right" data-aos="fade-up">
                    <h1 class="font-weight-bold">Khám phá đại dương xanh</h1>
                    <p class="lead text-white">Trải nghiệm dịch vụ đặt vé tàu cao tốc nhanh chóng, an toàn và hiện đại.</p>
                    <p><a href="#booking-section" class="btn btn-primary py-3 px-5 rounded-pill font-weight-bold">Đặt Vé Ngay</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@* --- 2. SECTION TÌM KIẾM --- *@
<div class="site-section pt-0 hero-search-wrap" id="booking-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-11">
                <div class="glass-form p-4 p-lg-5">
                    <div class="row mb-4">
                        <div class="col-12">
                            <h4 class="font-weight-bold text-dark"><i class="fas fa-search-location mr-2 text-primary"></i>Tìm Chuyến Tàu</h4>
                        </div>
                    </div>
                    <form asp-controller="Booking" asp-action="Search" method="get" class="row align-items-end">
                        <div class="form-group col-lg-5">
                            <label class="small font-weight-bold text-uppercase">Tuyến đường khởi hành</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-0"><i class="fa fa-ship text-primary"></i></span>
                                </div>
                                <select name="maTuyen" class="form-control bg-light border-0 shadow-none" required style="height: 50px;">
                                    <option value="">Chọn điểm đi - điểm đến</option>
                                    @foreach (var tuyen in Model.TuyenDuongs)
                                    {
                                        <option value="@tuyen.MaTuyen">@tuyen.TenTuyen</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group col-lg-4">
                            <label class="small font-weight-bold text-uppercase">Ngày đi</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-0"><i class="fa fa-calendar-alt text-primary"></i></span>
                                </div>
                                <input type="date" name="ngayGioKhoiHanh" class="form-control bg-light border-0 shadow-none" style="height: 50px;">
                            </div>
                        </div>
                        <div class="col-lg-3 form-group">
                            <button type="submit" class="btn btn-primary btn-block shadow font-weight-bold" style="height: 50px; border-radius: 12px;">
                                TÌM KIẾM NGAY
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@* --- 3. TUYẾN ĐƯỜNG NỔI BẬT (Ảnh Cloudinary) --- *@
<div class="site-section" id="destination-section">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 text-center" data-aos="fade-up">
                <span class="text-primary font-weight-bold">EXPLORE</span>
                <h2 class="font-weight-bold text-dark">Tuyến Đường Nổi Bật</h2>
                <div class="mx-auto mt-2" style="width: 60px; height: 3px; background: #4e73df;"></div>
            </div>
        </div>
        <div class="row">
            @foreach (var tuyen in Model.TuyenDuongs)
            {
                <div class="col-md-6 col-lg-4 mb-4" data-aos="fade-up">
                    <div class="card route-card shadow-sm h-100">
                        <div class="route-img-wrapper">
                            @* Cập nhật: Sử dụng trực tiếp URL từ Cloudinary *@
                            <img src="@(string.IsNullOrEmpty(tuyen.HinhAnh) ? defaultImg : tuyen.HinhAnh)"
                                 alt="@tuyen.TenTuyen"
                                 onerror="this.src='@defaultImg'">
                            <div class="badge-time">@tuyen.ThoiGianDuKien.ToString(@"hh\:mm") h</div>
                        </div>
                        <div class="card-body p-4 text-center">
                            <h5 class="font-weight-bold">@tuyen.TenTuyen</h5>
                            <p class="text-muted small"><i class="fa fa-map-marked-alt mr-2"></i>Khoảng cách: @tuyen.KhoangCach km</p>
                            <a asp-controller="Booking" asp-action="Search" asp-route-MaTuyen="@tuyen.MaTuyen"
                               class="btn btn-outline-primary btn-sm rounded-pill px-4">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* --- 4. LỊCH TRÌNH --- *@
<div class="site-section bg-light">
    <div class="container">
        <div class="row mb-5 justify-content-center">
            <div class="col-md-7 text-center">
                <h2 class="font-weight-bold text-dark">Lịch Trình Sắp Khởi Hành</h2>
                <p class="text-muted">Cập nhật thời gian thực các chuyến tàu trong ngày</p>
            </div>
        </div>
        <div class="table-responsive glass-form p-3 shadow-sm bg-white" style="border-radius: 15px;">
            <table class="table schedule-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Tuyến Đường</th>
                        <th>Tàu</th>
                        <th>Giờ Khởi Hành</th>
                        <th>Giá Vé</th>
                        <th>Trạng Thái Ghế</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lt in Model.LichTrinhs)
                    {
                        var soGheDaDat = lt.Ves?.Count() ?? 0;
                        var soGheTrong = lt.Tau.TongSoGhe - soGheDaDat;
                        var isFull = soGheTrong <= 0;

                        <tr>
                            <td class="font-weight-bold text-dark">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-route mr-2 text-info"></i> @lt.TuyenDuong.TenTuyen
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-light p-2 text-dark" style="border-radius: 8px;">
                                    <i class="fa fa-ship mr-2 text-primary"></i>@lt.Tau.TenTau
                                </span>
                            </td>
                            <td>
                                <div class="text-dark">@lt.NgayGioKhoiHanh.ToString("dd/MM")</div>
                                <div class="small font-weight-bold text-primary">@lt.NgayGioKhoiHanh.ToString("HH:mm")</div>
                            </td>
                            <td class="text-danger font-weight-bold">
                                @lt.GiaVeCoBan.ToString("N0")<small>đ</small>
                            </td>
                            <td>
                                <span class="badge @(isFull ? "badge-secondary" : (soGheTrong < 10 ? "badge-warning" : "badge-success")) px-3 py-2">
                                    @(isFull ? "Hết chỗ" : $"Còn {soGheTrong} ghế")
                                </span>
                            </td>
                            <td class="text-right">
                                @if (!isFull)
                                {
                                    <a asp-controller="Booking" asp-action="BookTicket" asp-route-id="@lt.MaLichTrinh"
                                       class="btn btn-warning btn-sm font-weight-bold px-4 shadow-sm rounded-pill">
                                        Đặt vé <i class="fas fa-chevron-right ml-1 small"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- 5. ĐÁNH GIÁ KHÁCH HÀNG (Dùng nguyên bản) --- *@
<section class="site-section bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="font-weight-bold text-dark">Khách Hàng Nói Gì</h2>
            <div class="mx-auto mt-2" style="width: 60px; height: 3px; background: #4e73df;"></div>
        </div>
        <div class="row">
            @foreach (var item in Model.DanhGias!.Take(3))
            {
                <div class="col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm testimonial-card p-4">
                        <div class="mb-3 text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="@(i <= item.SoSao ? "fas" : "far") fa-star small"></i>
                            }
                        </div>
                        <p class="text-secondary italic mb-4">"@item.NoiDung"</p>
                        <div class="d-flex align-items-center mt-auto">
                            @* Quay lại dùng vòng tròn avatar lấy chữ cái đầu *@
                            <div class="avatar-circle mr-3">
                                @(item.HoaDon?.KhachHang?.HoTen?.Substring(0, 1).ToUpper() ?? "K")
                            </div>
                            <div>
                                <h6 class="mb-0 font-weight-bold">@(item.HoaDon?.KhachHang?.HoTen ?? "Khách hàng")</h6>
                                <small class="text-muted">Hành khách</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* 6. COUNTER SECTION *@
<div class="site-section bg-image overlay" style="background-image: url('@Url.Content("~/images/hero_1.jpg")');">
    <div class="container">
        <div class="row">
            <div class="col text-center">
                <div class="counter-39392"><h3>50+</h3><span>Đội Tàu</span></div>
            </div>
            <div class="col text-center">
                <div class="counter-39392"><h3>10k+</h3><span>Khách Hàng</span></div>
            </div>
            <div class="col text-center">
                <div class="counter-39392"><h3>20+</h3><span>Tuyến Đường</span></div>
            </div>
        </div>
    </div>
</div>