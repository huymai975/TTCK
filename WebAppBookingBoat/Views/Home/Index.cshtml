@model WebAppBookingBoat.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ - Đặt vé tàu";
    // Đường dẫn ảnh thực tế từ Model TuyenDuong sẽ là /images/tuyen-duong/
    // Biến dẫn để bạn dễ quản lý
    var imagePath = "/images/tuyen-duong/";
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>

<style>
    .testimonial-section {
        background-color: #ffffff;
    }

    /* Hiệu ứng đổ bóng và bo góc cho thẻ đánh giá */
    .testimonial-card {
        border-radius: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .testimonial-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,0.1) !important;
        }

    /* Tạo Avatar tròn từ tên chữ cái đầu */
    .avatar-circle {
        width: 45px;
        height: 45px;
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        box-shadow: 0 3px 6px rgba(78,115,223,0.2);
    }

    /* Khối phản hồi của Admin */
    .admin-reply-box {
        background-color: #f8f9fc;
        padding: 10px 15px;
        border-radius: 10px;
        border-left: 3px solid #4e73df;
        color: #5a5c69;
    }

    /* Định dạng icon sao */
    .text-warning {
        color: #f6c23e !important;
    }
</style>

@* 1. Slider chính - Có thể giữ nguyên hoặc lấy ảnh từ các tuyến đường nổi bật *@
<div class="hero-slide owl-carousel site-blocks-cover">
    <div class="intro-section" style="background-image: url('@Url.Content("~/images/hero_1.jpg")');">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7 ml-auto text-right" data-aos="fade-up">
                    <h1>Khám phá đại dương xanh</h1>
                    <p>Trải nghiệm dịch vụ đặt vé tàu cao tốc nhanh chóng, an toàn và hiện đại nhất hiện nay.</p>
                    <p><a href="#booking-section" class="btn btn-primary py-3 px-5">Đặt Vé Ngay</a></p>
                </div>
            </div>
        </div>
    </div>
    <div class="intro-section" style="background-image: url('@Url.Content("~/images/hero_2.jpg")');">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7 mx-auto text-center" data-aos="fade-up">
                    <h1>Tận hưởng kỳ nghỉ cùng gia đình</h1>
                    <p>Hành trình kết nối những địa danh du lịch nổi tiếng với mức giá ưu đãi nhất.</p>
                    <p><a href="#destination-section" class="btn btn-primary py-3 px-5">Xem Tuyến Đường</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@* 2. Section: Tìm kiếm & Đặt vé (Thay thế phần form cũ) *@
<div class="site-section" id="booking-section">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <img src="~/images/hero_2.jpg" alt="Image" class="img-fluid rounded shadow">
            </div>
            <div class="col-md-5 ml-auto">
                <span class="text-serif text-primary">Đặt chuyến đi</span>
                <h3 class="heading-92913 text-black">Tìm Chuyến Tàu</h3>
                <form asp-controller="Booking" asp-action="Search" method="get" class="row">
                    <div class="form-group col-md-12">
                        <label for="maTuyen">Chọn Tuyến Đường (Địa danh):</label>
                        <select name="maTuyen" id="maTuyen" class="form-control" required>
                            <option value="">-- Chọn điểm đi - điểm đến --</option>
                            @foreach (var tuyen in Model.TuyenDuongs)
                            {
                                <option value="@tuyen.MaTuyen">@tuyen.TenTuyen</option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-md-12">
                        <label for="ngayGioKhoiHanh">Ngày Khởi Hành:</label>
                        <input type="date" name="ngayGioKhoiHanh" class="form-control" id="ngayGioKhoiHanh">
                    </div>

                    <div class="form-group col-md-12">
                        <input type="submit" class="btn btn-primary py-3 px-5 btn-block" value="Tìm Kiếm Chuyến Tàu">
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* 3. Section: Ưu điểm dịch vụ (Giữ nguyên icon flaticon) *@
<div class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-lg-4">
                <div class="service-29283">
                    <span class="wrap-icon-39293"><span class="flaticon-yacht"></span></span>
                    <h3>Tàu Cao Tốc Hiện Đại</h3>
                    <p>Hệ thống tàu đạt chuẩn quốc tế, trang bị đầy đủ thiết bị an toàn và tiện nghi cao cấp.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="service-29283">
                    <span class="wrap-icon-39293"><span class="flaticon-shield"></span></span>
                    <h3>An Toàn Tuyệt Đối</h3>
                    <p>Đội ngũ kỹ thuật kiểm tra nghiêm ngặt trước mỗi chuyến đi, bảo hiểm đầy đủ cho hành khách.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="service-29283">
                    <span class="wrap-icon-39293"><span class="flaticon-captain"></span></span>
                    <h3>Thuyền Trưởng Giỏi</h3>
                    <p>Các thuyền trưởng dày dạn kinh nghiệm, am hiểu hải trình và luôn đặt sự an toàn lên hàng đầu.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@* 4. Section: Tuyến đường nổi bật (Dữ liệu từ TuyenDuong) *@
<div class="site-section" id="destination-section">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 text-center">
                <span class="text-serif text-primary">Địa danh</span>
                <h3 class="heading-92913 text-black text-center">Tuyến Đường Nổi Bật</h3>
            </div>
        </div>
        <div class="row">
            @foreach (var tuyen in Model.TuyenDuongs)
            {
                <div class="col-md-6 col-lg-4 mb-4" data-aos="fade-up">
                    <div class="service-39381">
                        @* Nếu HinhAnh null sẽ dùng ảnh mặc định *@
                        <img src="@(string.IsNullOrEmpty(tuyen.HinhAnh) ? "/images/default.jpg" : imagePath + tuyen.HinhAnh)" alt="@tuyen.TenTuyen" class="img-fluid">
                        <div class="p-4">
                            <h3><a href="#"><span class="icon-room mr-1 text-primary"></span> @tuyen.TenTuyen</a></h3>
                            <div class="d-flex">
                                <div class="mr-auto">
                                    <span class="icon-map"></span> @tuyen.KhoangCach km
                                </div>
                                <div class="ml-auto price">
                                    <span class="bg-primary">@tuyen.ThoiGianDuKien.ToString(@"hh\:mm") h</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* 5. Section: Lịch trình chuyến tàu sắp khởi hành (Dữ liệu từ LichTrinh) *@
<div class="site-section bg-light">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 text-center">
                <span class="text-serif text-primary">Chuyến tàu</span>
                <h3 class="heading-92913 text-black text-center">Lịch Trình Sắp Khởi Hành</h3>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="table-responsive">
                    <table class="table table-white shadow-sm">
                        <thead class="bg-primary text-white">
                            <tr>
                                <th>Chuyến Tàu</th>
                                <th>Tên Tàu</th>
                                <th>Khởi Hành</th>
                                <th>Giá Vé</th>
                                <th>Còn Trống</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lt in Model.LichTrinhs)
                            {
                                <tr>
                                    <td><strong>@lt.TuyenDuong.TenTuyen</strong></td>
                                    <td>@lt.Tau.TenTau</td>
                                    <td>@lt.NgayGioKhoiHanh.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-danger font-weight-bold">@lt.GiaVeCoBan.ToString("N0")đ</td>
                                    <td>@lt.SoGheTrong ghế</td>
                                    <td>
                                        <a asp-controller="Booking" asp-action="Search" asp-route-id="@lt.MaLichTrinh" class="btn btn-warning btn-sm">Đặt vé</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<section class="testimonial-section py-5">
    <div class="container">
        @* Tiêu đề phần đánh giá *@
        <div class="text-center mb-5" data-aos="fade-up">
            <h6 class="text-primary font-weight-bold text-uppercase" style="letter-spacing: 2px;">Phản hồi</h6>
            <h2 class="font-weight-bold text-dark">Khách hàng nói gì về chúng tôi</h2>
            <div class="mx-auto mt-3" style="width: 50px; height: 3px; background: #4e73df; border-radius: 2px;"></div>
        </div>

        <div class="row">
            @if (Model != null && Model.DanhGias!.Any())
            {
                foreach (var item in Model.DanhGias!.Take(3)) // Chỉ lấy 3 cái đẹp nhất ra trang chủ
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="card h-100 border-0 shadow-sm testimonial-card">
                            <div class="card-body p-4">
                                @* Phần sao đánh giá *@
                                <div class="mb-3">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= item.SoSao ? "fas" : "far") fa-star text-warning small"></i>
                                    }
                                </div>

                                @* Nội dung đánh giá *@
                                <p class="text-secondary mb-4 italic" style="font-style: italic; min-height: 70px;">
                                    "@item.NoiDung"
                                </p>

                                @* Thông tin khách hàng *@
                                <div class="d-flex align-items-center mt-auto border-top pt-3">
                                    <div class="avatar-circle mr-3">
                                        @(item.HoaDon?.KhachHang?.HoTen?.Substring(0, 1).ToUpper() ?? "K")
                                    </div>
                                    <div>
                                        <h6 class="mb-0 font-weight-bold text-dark">@(item.HoaDon?.KhachHang?.HoTen ?? "Khách hàng")</h6>
                                        <small class="text-muted">Hành khách đi tuyến @(item.HoaDon?.Ves?.FirstOrDefault()?.LichTrinh?.TuyenDuong?.TenTuyen ?? "Tàu cao tốc")</small>
                                    </div>
                                </div>

                                @* Phản hồi của Admin nếu có *@
                                @if (!string.IsNullOrEmpty(item.PhanHoiAdmin))
                                {
                                    <div class="admin-reply-box mt-3 small">
                                        <strong class="text-primary"><i class="fas fa-reply mr-1"></i> Admin:</strong> @item.PhanHoiAdmin
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted italic">Chưa có đánh giá nào được hiển thị.</p>
                </div>
            }
        </div>

        @* Nút xem thêm *@
        <div class="text-center mt-4">
            <a href="/DanhGia" class="btn btn-link text-primary font-weight-bold text-decoration-none">
                Xem tất cả đánh giá <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </div>
    </div>
</section>


@* 6. Counter Section (Thông số hệ thống) *@
<div class="site-section bg-image overlay" style="background-image: url('@Url.Content("~/images/hero_1.jpg")');">
    <div class="container">
        <div class="row">
            <div class="col text-center">
                <div class="counter-39392">
                    <h3>50+</h3>
                    <span>Đội Tàu</span>
                </div>
            </div>
            <div class="col text-center">
                <div class="counter-39392">
                    <h3>10k+</h3>
                    <span>Khách Hàng</span>
                </div>
            </div>
            <div class="col text-center">
                <div class="counter-39392">
                    <h3>20+</h3>
                    <span>Tuyến Đường</span>
                </div>
            </div>
        </div>
    </div>
</div>